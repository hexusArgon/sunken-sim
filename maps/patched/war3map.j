function s__StatisticRow_updateValue takes integer this,integer index,real value returns nothing
set s___StatisticRow_values[s__StatisticRow_values[this]+index]=value
call sc__StatisticRow_calculatePercRealTime(this)
endfunction
function s__StatisticRow_addValue takes integer this,integer index,real value returns nothing
set s___StatisticRow_values[s__StatisticRow_values[this]+index]=s___StatisticRow_values[s__StatisticRow_values[this]+index]+value
call sc__StatisticRow_calculatePercRealTime(this)
endfunction
function s__StatisticRow_calculatePercRealTime takes integer this returns nothing
local real total=s___StatisticRow_values[s__StatisticRow_values[this]]+s___StatisticRow_values[s__StatisticRow_values[this]+1]+s___StatisticRow_values[s__StatisticRow_values[this]+2]
local integer index=0
if total<=0 then
loop
exitwhen index>=3
set s___StatisticRow_percs[s__StatisticRow_percs[this]+index]=0
set index=index+1
endloop
endif
loop
exitwhen index>=3
set s___StatisticRow_percs[s__StatisticRow_percs[this]+index]=s___StatisticRow_values[s__StatisticRow_values[this]+index]/ total*100
set index=index+1
endloop
endfunction
function s__StatisticRow_updateUi takes integer this returns nothing
local integer playerNumber=GetPlayerId(GetLocalPlayer())
local integer maxValueForPlayer
local integer offsetIndex=s__StatisticDashboard___selectedSnapshot[playerNumber]*3
local integer maxIndex=maxBetweenThreeValues(s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex],s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+1],s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+2])
local string prefixText=""
local integer loopA=0
loop
exitwhen loopA>=3
if loopA==maxIndex then
set prefixText=("|cffffcc00")
else
set prefixText=""
endif
if s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+loopA]==0 then
call BlzFrameSetText(s___StatisticRow_valueFrames[s__StatisticRow_valueFrames[this]+loopA],"-")
else
call BlzFrameSetText(s___StatisticRow_valueFrames[s__StatisticRow_valueFrames[this]+loopA],prefixText+GetSpacedNumber(s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+loopA])+" ("+I2S(R2I(s___StatisticRow_percs[s__StatisticRow_percs[this]+offsetIndex+loopA]))+"%)")
endif
set loopA=loopA+1
endloop
endfunction
function s__StatisticRow_takeSnapshot takes integer this returns nothing
local integer offset=snapshotCount*3
set s___StatisticRow_values[s__StatisticRow_values[this]+offset]=s___StatisticRow_values[s__StatisticRow_values[this]]
set s___StatisticRow_values[s__StatisticRow_values[this]+offset+1]=s___StatisticRow_values[s__StatisticRow_values[this]+1]
set s___StatisticRow_values[s__StatisticRow_values[this]+offset+2]=s___StatisticRow_values[s__StatisticRow_values[this]+2]
set s___StatisticRow_percs[s__StatisticRow_percs[this]+offset]=s___StatisticRow_percs[s__StatisticRow_percs[this]]
set s___StatisticRow_percs[s__StatisticRow_percs[this]+offset+1]=s___StatisticRow_percs[s__StatisticRow_percs[this]+1]
set s___StatisticRow_percs[s__StatisticRow_percs[this]+offset+2]=s___StatisticRow_percs[s__StatisticRow_percs[this]+2]
endfunction
function calculateStatisticVariableSize takes nothing returns nothing
set StatisticDashboard___pageSize=(0.5)-(0.012)*2-(0.08)-(0.005)
set StatisticDashboard___rowWidth=(0.7)-(0.02)*2
set StatisticDashboard___valueWidth=(StatisticDashboard___rowWidth-(0.02)*2-(0.15))/ 3
endfunction
function addStatisticGroup takes integer currentGroup,integer page returns integer
local real groupSize=0.0
local integer currentPage=page
local real remainingSize=s__StatisticPage_remainingSize[currentPage]
set groupSize=s__StatisticGroup_calculateSize(currentGroup)
if groupSize<=remainingSize then
call s__StatisticPage_addStatisticGroup(currentPage,currentGroup)
set s__StatisticPage_remainingSize[currentPage]=remainingSize-groupSize
elseif groupSize>StatisticDashboard___pageSize then
call BJDebugMsg(s__StatisticGroup_title[currentGroup]+" group is bigger than the allowed size of a page")
else
set s__StatisticDashboard___pages[totalPages]=currentPage
set totalPages=totalPages+1
set currentPage=s__StatisticPage_customCreate(totalPages)
call s__StatisticPage_addStatisticGroup(currentPage,currentGroup)
endif
return currentPage
endfunction
function defineData takes nothing returns nothing
local integer currentGroup
local integer currentPage
local integer index=0
set currentPage=s__StatisticPage_customCreate(totalPages)
set currentGroup=s__StatisticGroup_customCreate("DAMAGE DEALT")
set totalDamageRow=s__StatisticRow_customCreate("Total Damage")
call s__StatisticGroup_addRow(currentGroup,totalDamageRow)
set attackDamageRow=s__StatisticRow_customCreate("|c00ff0303Attack|r Damage")
call s__StatisticGroup_addRow(currentGroup,attackDamageRow)
set magicalDamageRow=s__StatisticRow_customCreate("|cff0099ffMagical|r Damage")
call s__StatisticGroup_addRow(currentGroup,magicalDamageRow)
set physicalDamageRow=s__StatisticRow_customCreate("|cffff8000Physical|r Damage")
call s__StatisticGroup_addRow(currentGroup,physicalDamageRow)
set petDamageRow=s__StatisticRow_customCreate("|cffd56262Pet|r Damage")
call s__StatisticGroup_addRow(currentGroup,petDamageRow)
set unclassifiedDamageRow=s__StatisticRow_customCreate("Unclassified Damage")
call s__StatisticGroup_addRow(currentGroup,unclassifiedDamageRow)
set damageDealtToBossesRow=s__StatisticRow_customCreate("Damage Dealt to Bosses")
call s__StatisticGroup_addRow(currentGroup,damageDealtToBossesRow)
set largestDamageInstanceRow=s__StatisticRow_customCreate("Largest Damage Instance")
call s__StatisticGroup_addRow(currentGroup,largestDamageInstanceRow)
set currentPage=addStatisticGroup(currentGroup,currentPage)
set currentGroup=s__StatisticGroup_customCreate("DAMAGE TAKEN")
set totalDamageTakenRow=s__StatisticRow_customCreate("Total Damage Taken")
call s__StatisticGroup_addRow(currentGroup,totalDamageTakenRow)
set totalDamageMitigatedRow=s__StatisticRow_customCreate("Total Damage Mitigated")
call s__StatisticGroup_addRow(currentGroup,totalDamageMitigatedRow)
set spellDamageTakenRow=s__StatisticRow_customCreate("|cff83d5fcSpell|r Damage Taken")
call s__StatisticGroup_addRow(currentGroup,spellDamageTakenRow)
set spellDamageMitigatedRow=s__StatisticRow_customCreate("|cff83d5fcSpell|r Damage Mitigated")
call s__StatisticGroup_addRow(currentGroup,spellDamageMitigatedRow)
set attackDamageTakenRow=s__StatisticRow_customCreate("|c00ff0303Attack|r Damage Taken")
call s__StatisticGroup_addRow(currentGroup,attackDamageTakenRow)
set attackDamageMitigatedRow=s__StatisticRow_customCreate("|c00ff0303Attack|r Damage Mitigated")
call s__StatisticGroup_addRow(currentGroup,attackDamageMitigatedRow)
set currentPage=addStatisticGroup(currentGroup,currentPage)
set currentGroup=s__StatisticGroup_customCreate("HEALING")
set totalHealingTypeDoneRow=s__StatisticRow_customCreate("Total |cff00cc33Healing|r Type Done")
call s__StatisticGroup_addRow(currentGroup,totalHealingTypeDoneRow)
set totalSelfHealingTypeDoneRow=s__StatisticRow_customCreate("Total Self |cff00cc33Healing|r Type Done")
call s__StatisticGroup_addRow(currentGroup,totalSelfHealingTypeDoneRow)
set totalHealingTypeFromAlliesRow=s__StatisticRow_customCreate("Total |cff00cc33Healing|r Type from Allies")
call s__StatisticGroup_addRow(currentGroup,totalHealingTypeFromAlliesRow)
set totalHealthRegeneratedRow=s__StatisticRow_customCreate("Total Health Regenerated")
call s__StatisticGroup_addRow(currentGroup,totalHealthRegeneratedRow)
set totalLifestealRow=s__StatisticRow_customCreate("Total Lifesteal")
call s__StatisticGroup_addRow(currentGroup,totalLifestealRow)
set largestHealRow=s__StatisticRow_customCreate("Largest Heal")
call s__StatisticGroup_addRow(currentGroup,largestHealRow)
set currentPage=addStatisticGroup(currentGroup,currentPage)
set currentGroup=s__StatisticGroup_customCreate("OTHER")
set totalSpellcastsRow=s__StatisticRow_customCreate("Total Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalSpellcastsRow)
set totalMagicalSpellcastsRow=s__StatisticRow_customCreate("Total |cff0099ffMagical|r Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalMagicalSpellcastsRow)
set totalPhysicalSpellcastsRow=s__StatisticRow_customCreate("Total |cffff8000Physical|r Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalPhysicalSpellcastsRow)
set totalSummoningSpellcastsRow=s__StatisticRow_customCreate("Total |cffd56262Summoning|r Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalSummoningSpellcastsRow)
set totalHealingSpellcastsRow=s__StatisticRow_customCreate("Total |cff00cc33Healing|r Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalHealingSpellcastsRow)
set totalNASpellcastsRow=s__StatisticRow_customCreate("Total |c00999999N/A|r Spellcasts")
call s__StatisticGroup_addRow(currentGroup,totalNASpellcastsRow)
set totalAttacksRow=s__StatisticRow_customCreate("Total Attacks")
call s__StatisticGroup_addRow(currentGroup,totalAttacksRow)
set totalCriticalStrikesRow=s__StatisticRow_customCreate("Total Critical Strikes")
call s__StatisticGroup_addRow(currentGroup,totalCriticalStrikesRow)
set totalDamageInstancesRow=s__StatisticRow_customCreate("Total Damage Instances")
call s__StatisticGroup_addRow(currentGroup,totalDamageInstancesRow)
set currentPage=addStatisticGroup(currentGroup,currentPage)
set s__StatisticDashboard___pages[totalPages]=currentPage
set totalPages=totalPages+1
set index=0
loop
exitwhen index>=3
set s__StatisticDashboard___selectedPage[index]=0
set s__StatisticDashboard___selectedSnapshot[index]=0
set index=index+1
endloop
set s__StatisticDashboard___snapshotTitle[0]="All Time"
endfunction
function createRow takes integer row,framehandle pageParent,framehandle anchorFrame,integer rowIndex returns framehandle
local framehandle rowFrame=BlzCreateFrameByType("FRAME",("StatisticDashboardRow"),pageParent,"",rowIndex)
local framehandle rowTitleFrame=BlzCreateFrameByType("TEXT",("StatisticDashboardRowTitle"),pageParent,"",rowIndex)
local framehandle toBeCreate
local integer index=0
call BlzFrameSetPoint(rowFrame,FRAMEPOINT_TOPLEFT,anchorFrame,FRAMEPOINT_BOTTOMLEFT,0,-(0.002))
call BlzFrameSetSize(rowFrame,StatisticDashboard___rowWidth,(0.012))
call BlzFrameSetPoint(rowTitleFrame,FRAMEPOINT_TOPLEFT,rowFrame,FRAMEPOINT_TOPLEFT,(0.02),0)
call BlzFrameSetSize(rowTitleFrame,(0.15),(0.012))
call BlzFrameSetTextAlignment(rowTitleFrame,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_LEFT)
call BlzFrameSetText(rowTitleFrame,("|c00ffffff")+s__StatisticRow_title[row])
set s__StatisticRow_background[row]=rowFrame
set s__StatisticRow_titleFrame[row]=rowTitleFrame
loop
exitwhen index>=3
set toBeCreate=BlzCreateFrameByType("TEXT",("StatisticDashboardRowTitle"),pageParent,"",rowIndex*3+index)
call BlzFrameSetTextAlignment(toBeCreate,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_CENTER)
call BlzFrameSetPoint(toBeCreate,FRAMEPOINT_TOPLEFT,rowTitleFrame,FRAMEPOINT_TOPRIGHT,index*StatisticDashboard___valueWidth,0)
call BlzFrameSetSize(toBeCreate,StatisticDashboard___valueWidth,(0.012))
call BlzFrameSetText(toBeCreate,("|c00ffffff")+"-")
set s___StatisticRow_valueFrames[s__StatisticRow_valueFrames[row]+index]=toBeCreate
set index=index+1
endloop
return rowFrame
endfunction
function createGroup takes integer igroup,framehandle pageParent,framehandle anchorFrame,integer groupCount returns framehandle
local framehandle headerBackground=BlzCreateFrameByType("BACKDROP",("StatisticDashboardHeader"),pageParent,"",groupCount)
local framehandle headerText=BlzCreateFrameByType("TEXT",("StatisticDashboardHeaderTitle"),headerBackground,"",groupCount)
local framehandle lastFrame=headerBackground
local integer index=0
if pageParent==anchorFrame then
call BlzFrameSetPoint(headerBackground,FRAMEPOINT_TOPLEFT,pageParent,FRAMEPOINT_TOPLEFT,0,0)
else
call BlzFrameSetPoint(headerBackground,FRAMEPOINT_TOPLEFT,anchorFrame,FRAMEPOINT_BOTTOMLEFT,0,-(0.002))
endif
call BlzFrameSetSize(headerBackground,StatisticDashboard___rowWidth,(0.02))
call BlzFrameSetText(headerText,("|cfff6a002")+s__StatisticGroup_title[igroup])
call BlzFrameSetTextAlignment(headerText,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_LEFT)
call BlzFrameSetPoint(headerText,FRAMEPOINT_TOPLEFT,headerBackground,FRAMEPOINT_TOPLEFT,(0.02),0)
call BlzFrameSetPoint(headerText,FRAMEPOINT_BOTTOMRIGHT,headerBackground,FRAMEPOINT_BOTTOMRIGHT,-(0.02),0)
call BlzFrameSetTexture(headerBackground,"statisticHeader.blp",0,true)
set index=0
loop
exitwhen index>=s__StatisticGroup_rowCount[igroup]
set lastFrame=createRow(s___StatisticGroup_data[s__StatisticGroup_data[igroup]+index],pageParent,lastFrame,groupCount*GROUP_LIMIT+index)
set index=index+1
endloop
return lastFrame
endfunction
function StatisticDashboard___onChangePage takes integer offset,player whichPlayer returns nothing
local integer playerNo=GetPlayerId(whichPlayer)
local integer nextPage=s__StatisticDashboard___selectedPage[playerNo]+offset
if nextPage<0 then
set nextPage=totalPages-1
elseif nextPage>=totalPages then
set nextPage=0
endif
call s__StatisticPage_show(s__StatisticDashboard___pages[nextPage],whichPlayer)
endfunction
function StatisticDashboard___onPressPrevPage takes nothing returns nothing
call StatisticDashboard___onChangePage(-1,GetTriggerPlayer())
call removeFrameFocus(statisticPrevPage)
endfunction
function StatisticDashboard___onPressNextPage takes nothing returns nothing
call StatisticDashboard___onChangePage(1,GetTriggerPlayer())
call removeFrameFocus(statisticNextPage)
endfunction
function StatisticDashboard___createPageControl takes nothing returns nothing
local trigger prevTrigger=CreateTrigger()
local trigger nextTrigger=CreateTrigger()
local framehandle anchorFrame=BlzGetFrameByName(("StatisticDashboardHeader"),0)
set statisticPageNoDisplay=BlzCreateFrameByType("TEXT","StatisticPageNoDisplay",statisticParent,"",0)
set statisticPrevPage=createPushedButton("statisticPrevPage.blp","StatisticPrevPage",statisticParent,0)
set statisticNextPage=createPushedButton("statisticNextPage.blp","StatisticNextPage",statisticParent,0)
call BlzFrameSetPoint(statisticPageNoDisplay,FRAMEPOINT_BOTTOMLEFT,anchorFrame,FRAMEPOINT_TOPLEFT,(0.032),(0.005))
call BlzFrameSetSize(statisticPageNoDisplay,0.04,(0.032))
call BlzFrameSetSize(statisticNextPage,(0.032),(0.032))
call BlzFrameSetPoint(statisticNextPage,FRAMEPOINT_TOPLEFT,statisticPageNoDisplay,FRAMEPOINT_TOPRIGHT,0,0)
call BlzFrameSetSize(statisticPrevPage,(0.032),(0.032))
call BlzFrameSetPoint(statisticPrevPage,FRAMEPOINT_TOPRIGHT,statisticPageNoDisplay,FRAMEPOINT_TOPLEFT,0,0)
call BlzFrameSetTextAlignment(statisticPageNoDisplay,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_CENTER)
call BlzTriggerRegisterFrameEvent(prevTrigger,statisticPrevPage,FRAMEEVENT_CONTROL_CLICK)
call BlzTriggerRegisterFrameEvent(nextTrigger,statisticNextPage,FRAMEEVENT_CONTROL_CLICK)
call TriggerAddAction(prevTrigger,function StatisticDashboard___onPressPrevPage)
call TriggerAddAction(nextTrigger,function StatisticDashboard___onPressNextPage)
endfunction
function StatisticDashboard___onChangeSnapshot takes integer offset,player whichPlayer returns nothing
local integer playerNo=GetPlayerId(whichPlayer)
local integer nextSnapshot=s__StatisticDashboard___selectedSnapshot[playerNo]+offset
if nextSnapshot<0 then
set nextSnapshot=snapshotCount-1
elseif nextSnapshot>=snapshotCount then
set nextSnapshot=0
endif
set s__StatisticDashboard___selectedSnapshot[playerNo]=nextSnapshot
call s__StatisticPage_show(s__StatisticDashboard___pages[s__StatisticDashboard___selectedPage[playerNo]],whichPlayer)
endfunction
function StatisticDashboard___onPressPrevSnapshot takes nothing returns nothing
call StatisticDashboard___onChangeSnapshot(-1,GetTriggerPlayer())
call removeFrameFocus(statisticPrevSnapshot)
endfunction
function StatisticDashboard___onPressNextSnapshot takes nothing returns nothing
call StatisticDashboard___onChangeSnapshot(1,GetTriggerPlayer())
call removeFrameFocus(statisticNextSnapshot)
endfunction
function StatisticDashboard___createSnapshotControl takes nothing returns nothing
local trigger prevTrigger=CreateTrigger()
local trigger nextTrigger=CreateTrigger()
local framehandle anchorFrame=BlzGetFrameByName(("StatisticDashboardHeader"),0)
set statisticSnapshotDisplay=BlzCreateFrameByType("TEXT","StatisticSnapshotDisplay",statisticParent,"",0)
set statisticPrevSnapshot=createPushedButton("statisticPrevPage.blp","StatisticPrevSnapshot",statisticParent,0)
set statisticNextSnapshot=createPushedButton("statisticNextPage.blp","StatisticNextSnapshot",statisticParent,0)
call BlzFrameSetPoint(statisticSnapshotDisplay,FRAMEPOINT_TOPLEFT,statisticNextPage,FRAMEPOINT_TOPRIGHT,(0.032)+(0.005),0)
call BlzFrameSetSize(statisticSnapshotDisplay,(0.054),(0.032))
call BlzFrameSetSize(statisticNextSnapshot,(0.032),(0.032))
call BlzFrameSetPoint(statisticNextSnapshot,FRAMEPOINT_TOPLEFT,statisticSnapshotDisplay,FRAMEPOINT_TOPRIGHT,0,0)
call BlzFrameSetSize(statisticPrevSnapshot,(0.032),(0.032))
call BlzFrameSetPoint(statisticPrevSnapshot,FRAMEPOINT_TOPRIGHT,statisticSnapshotDisplay,FRAMEPOINT_TOPLEFT,0,0)
call BlzFrameSetTextAlignment(statisticSnapshotDisplay,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_CENTER)
call BlzTriggerRegisterFrameEvent(prevTrigger,statisticPrevSnapshot,FRAMEEVENT_CONTROL_CLICK)
call BlzTriggerRegisterFrameEvent(nextTrigger,statisticNextSnapshot,FRAMEEVENT_CONTROL_CLICK)
call TriggerAddAction(prevTrigger,function StatisticDashboard___onPressPrevSnapshot)
call TriggerAddAction(nextTrigger,function StatisticDashboard___onPressNextSnapshot)
endfunction
function StatisticDashboard___toggleVisibility takes nothing returns nothing
local player whichPlayer=GetTriggerPlayer()
local integer playerNumber=GetPlayerId(whichPlayer)
local integer index=0
if GetLocalPlayer()==whichPlayer then
call MultiboardDisplay(udg_Main_Board,BlzFrameIsVisible(statisticParent))
call BlzFrameSetVisible(dpsPanel,BlzFrameIsVisible(statisticParent))
call BlzFrameSetVisible(statisticParent,not BlzFrameIsVisible(statisticParent))
if not BlzFrameIsVisible(s__StatisticPage_pageParent[s__StatisticDashboard___pages[s__StatisticDashboard___selectedPage[playerNumber]]])and BlzFrameIsVisible(statisticParent)then
call s__StatisticPage_show(s__StatisticDashboard___pages[s__StatisticDashboard___selectedPage[playerNumber]],whichPlayer)
loop
exitwhen index>=3
call s__StatisticPlayer_updateUi(s__players[index])
set index=index+1
endloop
endif
endif
call removeFrameFocus(statisticToggleButton)
call removeFrameFocus(statisticCloseButton)
endfunction
function setVisibilityStatisticDashboard takes player p,boolean show returns nothing
if GetLocalPlayer()==p then
call BlzFrameSetVisible(statisticParent,show)
endif
endfunction
function setVisibilityStatisticToggleButton takes player p,boolean show returns nothing
if GetLocalPlayer()==p then
call BlzFrameSetVisible(statisticToggleButton,show)
endif
endfunction
function StatisticDashboard___createToggleButton takes nothing returns nothing
local integer playerNo=0
set statisticCloseButton=createPushedButton(("statisticClose.blp"),"StatisticClose",statisticParent,0)
set statisticToggleButton=createPushedButton(("ReplaceableTextures\\CommandButtons\\BTNStatisticButton.blp"),"StatisticOpen",BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI,0),0)
call BlzFrameSetSize(statisticToggleButton,(0.032),(0.032))
call BlzFrameSetSize(statisticCloseButton,(0.04),(0.04))
call BlzFrameSetAbsPoint(statisticToggleButton,FRAMEPOINT_TOPLEFT,(0.43),(0.58))
call BlzFrameSetPoint(statisticCloseButton,FRAMEPOINT_TOPRIGHT,statisticParent,FRAMEPOINT_TOPRIGHT,(-0.004),(-0.004))
if toggleStatisticDashboardVisibility!=null then
call DestroyTrigger(toggleStatisticDashboardVisibility)
endif
set toggleStatisticDashboardVisibility=CreateTrigger()
call BlzTriggerRegisterFrameEvent(toggleStatisticDashboardVisibility,statisticToggleButton,FRAMEEVENT_CONTROL_CLICK)
call BlzTriggerRegisterFrameEvent(toggleStatisticDashboardVisibility,statisticCloseButton,FRAMEEVENT_CONTROL_CLICK)
loop
exitwhen playerNo>=3
call BlzTriggerRegisterPlayerKeyEvent(toggleStatisticDashboardVisibility,Player(playerNo),(OSKEY_I),0,true)
set playerNo=playerNo+1
endloop
call TriggerAddAction(toggleStatisticDashboardVisibility,function StatisticDashboard___toggleVisibility)
call createSCCustomTooltip(statisticToggleButton,("Statistics Dashboard (|cffffcc00I|r)"),("|c00a7a7a4Provides a detailed breakdown of the team's damage, mitigation, healing and others. When a Hero in the party reaches a higher level, a 'snapshot' will be taken that will store data as it was at that moment.|r"))
endfunction
function StatisticDashboard___createHeroInfoSection takes integer index,player p returns nothing
local integer sp=s__players[index]
local framehandle heroIcon=BlzCreateFrameByType("BACKDROP",("StatisticHeroIcon"),statisticParent,"",index)
local framehandle playerName=BlzCreateFrameByType("TEXT","StatisticPlayerName",statisticParent,"",index)
local framehandle tempFrame
local integer i=0
if(sp==null)then
return
endif
call BlzFrameSetSize(heroIcon,(0.036),(0.036))
call BlzFrameSetSize(playerName,StatisticDashboard___valueWidth,(0.012))
call BlzFrameSetPoint(playerName,FRAMEPOINT_BOTTOM,heroIcon,FRAMEPOINT_TOP,0,(0.005))
call BlzFrameSetPoint(heroIcon,FRAMEPOINT_TOP,statisticParent,FRAMEPOINT_TOPLEFT,(0.02)+(0.02)+(0.15)+StatisticDashboard___valueWidth*(index+0.5),-(0.012)-(0.012)-(0.036)+(0.005))
call BlzFrameSetTextAlignment(playerName,TEXT_JUSTIFY_CENTER,TEXT_JUSTIFY_CENTER)
if(s__StatisticPlayer_hero[sp]==null)then
call BlzFrameSetTexture(heroIcon,("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNSelectHeroOff.blp"),0,true)
else
call BlzFrameSetTexture(heroIcon,BlzGetAbilityIcon(GetUnitTypeId(s__StatisticPlayer_hero[sp])),0,true)
endif
call BlzFrameSetText(playerName,udg_Colors[GetConvertedPlayerId(s__StatisticPlayer_p[sp])]+s__StatisticPlayer_playerName[sp])
set s__StatisticPlayer_heroIconFrame[sp]=heroIcon
set s__StatisticPlayer_playerNameFrame[sp]=playerName
loop
exitwhen i>=(3)
set tempFrame=BlzCreateFrameByType("BACKDROP",("StatisticHeroGlyphIcon"),statisticParent,"",index*(3)+i)
call BlzFrameSetSize(tempFrame,(0.011),(0.011))
call BlzFrameSetTexture(tempFrame,("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNScrollOfRegeneration.blp"),0,true)
call BlzFrameSetPoint(tempFrame,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_TOPRIGHT,i*(0.011),0)
set s___StatisticPlayer_glyphFrames[s__StatisticPlayer_glyphFrames[sp]+i]=tempFrame
set i=i+1
endloop
set i=0
loop
exitwhen i>=(4)
set tempFrame=BlzCreateFrameByType("BACKDROP",("StatisticHeroTalentIcon"),statisticParent,"",index*(4)+i)
call BlzFrameSetSize(tempFrame,(0.011),(0.011))
call BlzFrameSetTexture(tempFrame,("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNSorceressAdept.blp"),0,true)
call BlzFrameSetPoint(tempFrame,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_TOPRIGHT,i*(0.011),-(0.011)-0.001)
set s___StatisticPlayer_talentFrames[s__StatisticPlayer_talentFrames[sp]+i]=tempFrame
set i=i+1
endloop
set i=0
loop
exitwhen i>=(6)
set tempFrame=BlzCreateFrameByType("BACKDROP",("StatisticHeroItemIcon"),statisticParent,"",index*(6)+i)
call BlzFrameSetSize(tempFrame,(0.011),(0.011))
call BlzFrameSetTexture(tempFrame,("UI\\Widgets\\Console\\Human\\Human-inventory-slotfiller.blp"),0,true)
call BlzFrameSetPoint(tempFrame,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_TOPRIGHT,i*(0.011),-((0.011)+0.001)*2)
set s___StatisticPlayer_itemFrames[s__StatisticPlayer_itemFrames[sp]+i]=tempFrame
set i=i+1
endloop
endfunction
function StatisticDashboard___createHeroDashboardButton takes nothing returns nothing
local integer index=0
local player p
local integer sp
loop
exitwhen index>=3
set p=Player(index)
call StatisticDashboard___createHeroInfoSection(index,p)
set index=index+1
endloop
endfunction
function StatisticDashboard___createDashboard takes nothing returns nothing
local integer index=0
local integer groupCount=0
local integer groupIndex=0
local integer page
local integer igroup
local framehandle lastFrame
set statisticParent=BlzCreateFrameByType("BACKDROP",("StatisticDashboardParent"),BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI,0),"",999)
call BlzFrameSetAbsPoint(statisticParent,FRAMEPOINT_TOPLEFT,(0.05),(0.55))
call BlzFrameSetSize(statisticParent,(0.7),(0.5))
call BlzFrameSetTexture(statisticParent,"statisticBackground.blp",0,true)
loop
exitwhen index>=totalPages
set page=s__StatisticDashboard___pages[index]
set lastFrame=BlzCreateFrameByType("FRAME",("StatisticDashboardPage"),statisticParent,"",index)
call BlzFrameSetPoint(lastFrame,FRAMEPOINT_TOPLEFT,statisticParent,FRAMEPOINT_TOPLEFT,(0.02),-(0.012)-(0.005)-(0.08))
call BlzFrameSetPoint(lastFrame,FRAMEPOINT_BOTTOMRIGHT,statisticParent,FRAMEPOINT_BOTTOMRIGHT,-(0.02),(0.012))
set s__StatisticPage_pageParent[page]=lastFrame
set groupIndex=0
loop
exitwhen groupIndex>=s__StatisticPage_groupCount[page]
set igroup=s___StatisticPage_groups[s__StatisticPage_groups[page]+groupIndex]
set lastFrame=createGroup(igroup,s__StatisticPage_pageParent[page],lastFrame,groupCount)
set groupIndex=groupIndex+1
set groupCount=groupCount+1
endloop
call BlzFrameSetVisible(s__StatisticPage_pageParent[page],false)
set index=index+1
endloop
call StatisticDashboard___createPageControl()
call StatisticDashboard___createSnapshotControl()
call StatisticDashboard___createHeroDashboardButton()
call StatisticDashboard___createToggleButton()
call BlzFrameSetVisible(statisticParent,false)
endfunction
function updateStatisticHeroIcon takes integer playerNumber,unit u returns nothing
call BlzFrameSetTexture(s__StatisticPlayer_heroIconFrame[s__players[playerNumber]],BlzGetAbilityIcon(GetUnitTypeId(u)),0,true)
endfunction
function takeSnapshot takes string title returns nothing
local integer pageIndex=0
set s__StatisticDashboard___snapshotTitle[snapshotCount]=title
loop
exitwhen pageIndex>=totalPages
call s__StatisticPage_takeSnapshot(s__StatisticDashboard___pages[pageIndex])
set pageIndex=pageIndex+1
endloop
set pageIndex=0
loop
exitwhen pageIndex>=3
if s__players[pageIndex]!=null then
call s__StatisticPlayer_takeSnapshot(s__players[pageIndex])
endif
set pageIndex=pageIndex+1
endloop
set snapshotCount=snapshotCount+1
endfunction
function StatisticDashboard___onUpdate takes nothing returns nothing
local player p=GetLocalPlayer()
local integer id=GetPlayerId(p)
local integer i=0
if not BlzFrameIsVisible(statisticParent)then
return
endif
if GetPlayerController(p)!=MAP_CONTROL_USER then
return
endif
call s__StatisticPage_updateUi(s__StatisticDashboard___pages[s__StatisticDashboard___selectedPage[id]])
loop
call s__StatisticPlayer_updateUi(s__players[i])
set i=i+1
exitwhen i>=3
endloop
endfunction
function StatisticDashboard___createUi takes nothing returns nothing
call StatisticDashboard___createDashboard()
if updateStatisticDashboard!=null then
call DestroyTrigger(updateStatisticDashboard)
endif
set updateStatisticDashboard=CreateTrigger()
call TriggerRegisterTimerEventPeriodic(updateStatisticDashboard,1.00)
call TriggerAddAction(updateStatisticDashboard,function StatisticDashboard___onUpdate)
endfunction
function StatisticDashboard___onInit takes nothing returns nothing
call calculateStatisticVariableSize()
call defineData()
call StatisticDashboard___createUi()
endfunction
function StatisticDashboard___Init takes nothing returns nothing
local trigger onLoadTrigger=CreateTrigger()
local trigger onTimeElapsedTrigger=CreateTrigger()
local integer i=0
local player p
loop
set p=Player(i)
if GetPlayerController(p)==MAP_CONTROL_USER then
set s__players[i]=s__StatisticPlayer_customCreate(p)
endif
set i=i+1
exitwhen i>=3
endloop
call TriggerRegisterGameEvent(onLoadTrigger,EVENT_GAME_LOADED)
call TriggerAddAction(onLoadTrigger,function StatisticDashboard___createUi)
call TriggerRegisterTimerEventSingle(onTimeElapsedTrigger,0.00)
call TriggerAddAction(onTimeElapsedTrigger,function StatisticDashboard___onInit)
endfunction
function TasAbilityChargeBox_GetUnitSpellCodeKey takes integer unitId,integer spellCode returns integer
local integer count=LoadInteger(TasAbilityChargeBox_Hash,unitId,0)
local integer loopA=0
loop
set loopA=loopA+1
exitwhen loopA>count
if LoadInteger(TasAbilityChargeBox_Hash,unitId,loopA)==spellCode then
return loopA
endif
endloop
set count=count+1
call SaveInteger(TasAbilityChargeBox_Hash,unitId,0,count)
call SaveInteger(TasAbilityChargeBox_Hash,unitId,count,spellCode)
return count
endfunction
function TasAbilityChargeBox_SetValue takes unit u,integer spellCode,string value returns nothing
local integer unitId=GetHandleId(u)
call TasAbilityChargeBox_GetUnitSpellCodeKey(unitId,spellCode)
call SaveStr(TasAbilityChargeBox_Hash,unitId,spellCode,value)
endfunction
function TasAbilityChargeBox_GetValue takes unit u,integer spellCode returns string
return LoadStr(TasAbilityChargeBox_Hash,GetHandleId(u),spellCode)
endfunction
function TasAbilityChargeBox_Clear takes unit u returns nothing
call FlushChildHashtable(TasAbilityChargeBox_Hash,GetHandleId(u))
endfunction
function TasAbilityChargeBox_Update takes nothing returns nothing
local unit u=TasAbilityChargeBox_Unit[GetPlayerId(GetLocalPlayer())]
local integer unitId=GetHandleId(u)
local integer i=0
local integer pos
local integer spellCode
loop
exitwhen i>11
call BlzFrameSetVisible(BlzGetFrameByName("TasAbilityChargeBox",i),false)
set i=i+1
endloop
set i=LoadInteger(TasAbilityChargeBox_Hash,unitId,0)
loop
exitwhen i<=0
set spellCode=LoadInteger(TasAbilityChargeBox_Hash,unitId,i)
set pos=BlzGetAbilityPosX(spellCode)+BlzGetAbilityPosY(spellCode)*4
call BlzFrameSetVisible(BlzGetFrameByName("TasAbilityChargeBox",pos),true)
call BlzFrameSetText(BlzGetFrameByName("TasAbilityChargeBoxText",pos),LoadStr(TasAbilityChargeBox_Hash,unitId,spellCode))
set i=i-1
endloop
set u=null
endfunction
function TasAbilityChargeBox___Create takes nothing returns nothing
local framehandle frame
local integer i=0
call BlzLoadTOCFile(TasAbilityChargeBox_TocPath)
loop
exitwhen i>11
set frame=BlzCreateSimpleFrame("TasAbilityChargeBox",BlzGetOriginFrame(ORIGIN_FRAME_COMMAND_BUTTON,i),i)
call BlzGetFrameByName("TasAbilityChargeBoxText",i)
call BlzFrameSetVisible(frame,false)
set i=i+1
endloop
if GetHandleId(frame)==0 then
call BJDebugMsg("TasAbilityChargeBox - Error Creating Frames")
endif
endfunction
function TasAbilityChargeBox_Select takes nothing returns nothing
set TasAbilityChargeBox_Unit[GetPlayerId(GetTriggerPlayer())]=GetTriggerUnit()
endfunction
function TasAbilityChargeBox_Init takes nothing returns nothing
local trigger trig
call TimerStart(CreateTimer(),TasAbilityChargeBox_UpdateIntervale,true,function TasAbilityChargeBox_Update)
call TasAbilityChargeBox___Create()
call TriggerAddAction(FrameLoader___actionTrigger,(function TasAbilityChargeBox___Create))
set trig=CreateTrigger()
call TriggerAddAction(trig,function TasAbilityChargeBox_Select)
call TriggerRegisterAnyUnitEventBJ(trig,EVENT_PLAYER_UNIT_SELECTED)
set TasAbilityChargeBox_Hash=InitHashtable()
endfunction
function TasItemFusionAdd takes integer result,integer mat returns nothing
local integer materialCount
local integer builtWayCount
local integer count
set TasItemFusion_FusionCount=TasItemFusion_FusionCount+1
set TasItemFusion_FusionResult[TasItemFusion_FusionCount]=result
set count=(LoadInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_BuiltWay,result)),(0)))+1
call SaveInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_BuiltWay,result)),(0),(count))
call SaveInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_BuiltWay,result)),(count),(mat))
if not(HaveSavedBoolean(Table___ht,(((s__HashTable__getindex(TasItemFusion_UsedIn,mat)))),(result)))then
call SaveBoolean(Table___ht,(((s__HashTable__getindex(TasItemFusion_UsedIn,mat)))),(result),(true))
set count=(LoadInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_UsedIn,mat)),(0)))+1
call SaveInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_UsedIn,mat)),(0),(count))
call SaveInteger(Table___ht,(s__HashTable__getindex(TasItemFusion_UsedIn,mat)),(count),(result))
call TasItemCaclCost(mat)
endif
call TasItemCaclCost(result)
endfunction
function TasItemFusionAdd2 takes integer result,integer a,integer b returns nothing
call TasItemFusionAdd(result,a)
call TasItemFusionAdd(result,b)
endfunction
function TasItemFusionAdd3 takes integer result,integer a,integer b,integer c returns nothing
call TasItemFusionAdd(result,a)
call TasItemFusionAdd(result,b)
call TasItemFusionAdd(result,c)
endfunction
