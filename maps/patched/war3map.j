function Trig_Creep_Spawns_Actions takes nothing returns nothing
if(Trig_Creep_Spawns_Func002C())then
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(udg_Generic_Point,"Abilities\\Spells\\Other\\Doom\\DoomDeath.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Generic_Point)
else
endif
if(Trig_Creep_Spawns_Func004C())then
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(udg_Generic_Point,"war3mapImported\\WaterGeyser.mdx")
call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(),1.75)
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Generic_Point)
else
endif
if(Trig_Creep_Spawns_Func006C())then
