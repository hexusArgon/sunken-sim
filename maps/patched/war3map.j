function updateHeroPanelInventoryIcons takes integer index,unit selectedUnit returns nothing
local integer count=0
local item itemInSlot
loop
set itemInSlot=UnitItemInSlot(selectedUnit,count)
if(itemInSlot!=null)then
call BlzFrameSetTexture(BlzGetFrameByName("HeroPanelItemIcon",index*6+count),BlzGetItemIconPath(itemInSlot),0,true)
else
call BlzFrameSetTexture(BlzGetFrameByName("HeroPanelItemIcon",index*6+count),"ReplaceableTextures\\CommandButtons\\PASHuman-inventory-slotfiller.blp",0,true)
endif
set count=count+1
exitwhen count==6
endloop
endfunction
function updateHeroPanel takes integer index,unit selectedUnit returns nothing
local string hpText=I2S(R2I(GetUnitState(selectedUnit,UNIT_STATE_LIFE)))
local string mpText=I2S(R2I(GetUnitState(selectedUnit,UNIT_STATE_MANA)))
local real hpPercent=GetUnitLifePercent(selectedUnit)
local integer offset=index*2
call BlzFrameSetText(BlzGetFrameByName("HpMpBarText",offset),hpText)
call BlzFrameSetText(BlzGetFrameByName("HpMpBarText",offset+1),mpText)
call BlzFrameSetValue(BlzGetFrameByName("HpMpBar",offset),hpPercent)
call BlzFrameSetValue(BlzGetFrameByName("HpMpBar",offset+1),GetUnitManaPercent(selectedUnit))
call BlzFrameSetVertexColor(BlzGetFrameByName("HpMpBar",offset),BlzConvertColor(255,R2I(255*(100-hpPercent)/ 100),R2I(255*hpPercent/ 100),0))
endfunction
function Trig_Update_Hero_Panel_Actions takes nothing returns nothing
local integer index=0
local integer offsetByPlayerNumber=udg_HeroPanel_PlayerNumber*udg_HeroPanel_Amount
local unit selectedUnit
loop
set selectedUnit=udg_HeroPanel_Heroes[index+offsetByPlayerNumber]
if(selectedUnit!=null)then
call updateHeroPanel(index,selectedUnit)
call updateHeroPanelInventoryIcons(index,selectedUnit)
endif
set index=index+1
exitwhen index==udg_HeroPanel_Amount
endloop
endfunction
