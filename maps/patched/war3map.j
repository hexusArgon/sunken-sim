function Trig_Gold_Mine_Entering_Func005C takes nothing returns boolean
if((GetOwningPlayer(GetTriggerUnit())==Player(0)))then
return true
endif
if((GetOwningPlayer(GetTriggerUnit())==Player(1)))then
return true
endif
if((GetOwningPlayer(GetTriggerUnit())==Player(2)))then
return true
endif
return false
endfunction
function Trig_Gold_Mine_Entering_Conditions takes nothing returns boolean
if(not(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetTriggerUnit())>=5.00))then
return false
endif
if(not(GetUnitTypeId(GetEnteringUnit())!='H00P'))then
return false
endif
if(not(GetUnitTypeId(GetTriggerUnit())!='h007'))then
return false
endif
if(not Trig_Gold_Mine_Entering_Func005C())then
return false
endif
return true
endfunction
function Trig_Gold_Mine_Entering_Func004Func003C takes nothing returns boolean
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
function Trig_Gold_Mine_Entering_Func004C takes nothing returns boolean
if(not(GetUnitLevel(GetEnteringUnit())>=7))then
return false
endif
return true
endfunction
function Trig_Gold_Mine_Entering_Actions takes nothing returns nothing
if(Trig_Gold_Mine_Entering_Func004C())then
call ShowUnitHide(GetEnteringUnit())
if(Trig_Gold_Mine_Entering_Func004Func003C())then
set udg_Ping_Point=GetRectCenter(gg_rct_Gold_Mine_Entrance_Point)
call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetEnteringUnit()),udg_Ping_Point,2.00)
call RemoveLocation(udg_Ping_Point)
call TriggerSleepAction(2)
set udg_Ping_Point=GetRectCenter(gg_rct_Gold_Mine_Entrance_Point)
call SetUnitPositionLoc(GetEnteringUnit(),udg_Ping_Point)
call RemoveLocation(udg_Ping_Point)
call ShowUnitShow(GetEnteringUnit())
call SelectUnitForPlayerSingle(GetEnteringUnit(),GetOwningPlayer(GetEnteringUnit()))
else
call TriggerSleepAction(2)
set udg_Ping_Point=GetRectCenter(gg_rct_Gold_Mine_Entrance_Point)
call SetUnitPositionLoc(GetEnteringUnit(),udg_Ping_Point)
call RemoveLocation(udg_Ping_Point)
call ShowUnitShow(GetEnteringUnit())
endif
else
call ConditionalTriggerExecute(gg_trg_Warning_Dungeon_Level)
endif
endfunction
