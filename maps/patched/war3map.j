function Trig_Defeat_Func001C takes nothing returns boolean
if((GetOwningPlayer(GetTriggerUnit())==Player(0)))then
return true
endif
if((GetOwningPlayer(GetTriggerUnit())==Player(1)))then
return true
endif
if((GetOwningPlayer(GetTriggerUnit())==Player(2)))then
return true
endif
return false
endfunction
function Trig_Defeat_Conditions takes nothing returns boolean
if(not Trig_Defeat_Func001C())then
return false
endif
if(not(udg_PlayerTeam_Lives==1))then
return false
endif
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO)==true))then
return false
endif
return true
endfunction
