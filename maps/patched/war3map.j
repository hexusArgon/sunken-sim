function InvalidTargetAreaCDFix takes nothing returns nothing
local unit invalidAreaUnit=udg_InvalidArea_Unit
local integer invalidAreaAbility=udg_InvalidArea_Ability
local real cooldown=2.00
call PolledWait(0.01)
call BlzEndUnitAbilityCooldown(invalidAreaUnit,invalidAreaAbility)
call BlzStartUnitAbilityCooldown(invalidAreaUnit,invalidAreaAbility,cooldown)
call SetUnitManaBJ(invalidAreaUnit,(GetUnitStateSwap(UNIT_STATE_MANA,invalidAreaUnit)+I2R(BlzGetAbilityManaCost(invalidAreaAbility,(GetUnitAbilityLevelSwapped(invalidAreaAbility,invalidAreaUnit)-1)))))
call DisplayTextToForce(GetForceOfPlayer(GetOwningPlayer(invalidAreaUnit)),"|c00ff0000NOTE: Cannot target there.|r")
endfunction
function CleanseStuns takes unit unitToCleanse returns nothing
local integer debuffStunned='BSTN'
local integer debuffStunnedPause='BPSE'
if(UnitHasBuffBJ(unitToCleanse,debuffStunned))then
call UnitRemoveBuffBJ(debuffStunned,unitToCleanse)
endif
if(UnitHasBuffBJ(unitToCleanse,debuffStunnedPause))then
call UnitRemoveBuffBJ(debuffStunnedPause,unitToCleanse)
endif
endfunction
function CleanseRoots takes unit unitToCleanse returns nothing
local integer debuffEntanglingRoots='BEer'
local integer debuffChainsOfTorment='B00Y'
if(UnitHasBuffBJ(unitToCleanse,debuffEntanglingRoots))then
call UnitRemoveBuffBJ(debuffEntanglingRoots,unitToCleanse)
endif
if(UnitHasBuffBJ(unitToCleanse,debuffChainsOfTorment))then
call UnitRemoveBuffBJ(debuffChainsOfTorment,unitToCleanse)
endif
endfunction
function CleanseCurse takes unit unitToCleanse returns nothing
local integer debuffCurse='Bcrs'
if(UnitHasBuffBJ(unitToCleanse,debuffCurse))then
call UnitRemoveBuffBJ(debuffCurse,unitToCleanse)
endif
endfunction
function CleanseSleep takes unit unitToCleanse returns nothing
local integer debuffSleep='BUsl'
local integer debuffSleepPause='BUsp'
local integer debuffSleepStun='BUst'
if(UnitHasBuffBJ(unitToCleanse,debuffSleep))then
call UnitRemoveBuffBJ(debuffSleep,unitToCleanse)
endif
if(UnitHasBuffBJ(unitToCleanse,debuffSleepPause))then
call UnitRemoveBuffBJ(debuffSleepPause,unitToCleanse)
endif
if(UnitHasBuffBJ(unitToCleanse,debuffSleepStun))then
call UnitRemoveBuffBJ(debuffSleepStun,unitToCleanse)
endif
endfunction
function ToxicSackGroupPick takes nothing returns nothing
local boolean isEnemy=IsUnitEnemy(GetEnumUnit(),GetOwningPlayer(udg_Hero_Berserker))
local boolean isNotBuilding=IsUnitType(GetEnumUnit(),UNIT_TYPE_STRUCTURE)==false
local boolean isNotFlying=IsUnitType(GetEnumUnit(),UNIT_TYPE_FLYING)==false
local boolean isNotMagicImmune=IsUnitType(GetEnumUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false
local boolean isAlive=udg_IsUnitAlive[GetUnitUserData(GetEnumUnit())]
if(isEnemy and isNotBuilding and isNotFlying and isNotMagicImmune and isAlive)then
call ConditionalTriggerExecute(gg_trg_Toxic_Sack_Group_Actions)
endif
endfunction
function ToxicSack takes location point returns nothing
call PolledWait(0.75)
call AddSpecialEffectLocBJ(point,"war3mapImported\\Acid Ex.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ(point,"Objects\\Spawnmodels\\Demon\\DemonLargeDeathExplode\\DemonLargeDeathExplode.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocAll(250.00,point),function ToxicSackGroupPick)
endfunction
function CollapsingStarGroupPick takes nothing returns nothing
local unit pickedUnit=GetEnumUnit()
local boolean isEnemy=IsUnitEnemy(pickedUnit,GetOwningPlayer(udg_Hero_DemonHunter))
local boolean isNotBuilding=IsUnitType(pickedUnit,UNIT_TYPE_STRUCTURE)==false
local boolean isNotFlying=IsUnitType(pickedUnit,UNIT_TYPE_FLYING)==false
local boolean isNotMagicImmune=IsUnitType(pickedUnit,UNIT_TYPE_MAGIC_IMMUNE)==false
local boolean isAlive=udg_IsUnitAlive[GetUnitUserData(pickedUnit)]
if(isEnemy and isNotBuilding and isNotFlying and isNotMagicImmune and isAlive)then
call ConditionalTriggerExecute(gg_trg_Collapsing_Star_Group_Actions)
endif
endfunction
function CollapsingStar takes location point returns nothing
call PolledWait(0.75)
call AddSpecialEffectLocBJ(point,"war3mapImported\\Shadow Slam Normal.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocAll(275.00,point),function CollapsingStarGroupPick)
endfunction
function EnduringTormentModifyDuration takes integer dummyAbility returns nothing
local ability abilityHandle=BlzGetUnitAbility(udg_Caster_Dummy,dummyAbility)
local integer abilityLevel=GetUnitAbilityLevelSwapped(dummyAbility,udg_Caster_Dummy)-1
local real bonusDuration=3.00
call BlzSetAbilityRealLevelFieldBJ(abilityHandle,ABILITY_RLF_DURATION_NORMAL,abilityLevel,(BlzGetAbilityRealLevelField(abilityHandle,ABILITY_RLF_DURATION_NORMAL,abilityLevel)+bonusDuration))
call BlzSetAbilityRealLevelFieldBJ(abilityHandle,ABILITY_RLF_DURATION_HERO,abilityLevel,(BlzGetAbilityRealLevelField(abilityHandle,ABILITY_RLF_DURATION_HERO,abilityLevel)+bonusDuration))
endfunction
function DemonicWardsModifyArmor takes integer dummyAbility returns nothing
local ability abilityHandle=BlzGetUnitAbility(udg_Caster_Dummy,dummyAbility)
local integer abilityLevel=GetUnitAbilityLevelSwapped(dummyAbility,udg_Caster_Dummy)-1
local integer bonusArmor=3
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_DemonHunter)],'I05M'))then
call BlzSetAbilityIntegerLevelFieldBJ(abilityHandle,ABILITY_ILF_DEFENSE_INCREASE_INF2,abilityLevel,bonusArmor)
endif
endfunction
function DummyCast takes integer dummyAbility returns nothing
local boolean isDevourer=GetUnitAbilityLevelSwapped('A0CY',udg_Glyphs_Unit[HP_SlotOf(udg_Hero_DemonHunter)])==3
call UnitAddAbilityBJ(dummyAbility,udg_Caster_Dummy)
if(isDevourer)then
call SetUnitAbilityLevelSwapped(dummyAbility,udg_Caster_Dummy,2)
endif
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_DemonHunter)],'I0DA'))then
call EnduringTormentModifyDuration(dummyAbility)
endif
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_DemonHunter)],'I05M'))then
call DemonicWardsModifyArmor(dummyAbility)
endif
call IssueTargetOrderBJ(udg_Caster_Dummy,"innerfire",udg_Hero_DemonHunter)
call UnitRemoveAbilityBJ(dummyAbility,udg_Caster_Dummy)
endfunction
function ApplyImmolationAuraBuff takes nothing returns nothing
local integer buffImmolationAura='B00T'
local integer buffImmolationAuraStack='B02Q'
local integer buffImmolationAuraVoid='B07J'
local integer buffImmolationAuraVoidStack='B07K'
local integer abilityImmolationAura='A0RL'
local integer abilityImmolationAuraStack='A0RM'
if(UnitHasBuffBJ(udg_Hero_DemonHunter,buffImmolationAura)or UnitHasBuffBJ(udg_Hero_DemonHunter,buffImmolationAuraVoid))then
call UnitRemoveBuffBJ(buffImmolationAuraStack,udg_Hero_DemonHunter)
call UnitRemoveBuffBJ(buffImmolationAuraVoidStack,udg_Hero_DemonHunter)
call DummyCast(abilityImmolationAuraStack)
else
call UnitRemoveBuffBJ(buffImmolationAura,udg_Hero_DemonHunter)
call UnitRemoveBuffBJ(buffImmolationAuraVoid,udg_Hero_DemonHunter)
call DummyCast(abilityImmolationAura)
endif
endfunction
function GenerateFuryAmount takes integer amount returns nothing
set udg_CustomResource_CurrentValue[HP_PidOf(udg_Hero_DemonHunter)]=(udg_CustomResource_CurrentValue[HP_PidOf(udg_Hero_DemonHunter)]+amount)
if(udg_CustomResource_CurrentValue[HP_PidOf(udg_Hero_DemonHunter)]>udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_DemonHunter)])then
set udg_CustomResource_CurrentValue[HP_PidOf(udg_Hero_DemonHunter)]=udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_DemonHunter)]
endif
endfunction
function GenerateFury takes integer amount returns nothing
local boolean hasDemonicPower=UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_DemonHunter)],'I0V3')
local boolean successfulRoll=GetRandomReal(0,100.00)<=(25.00*udg_Luck_Multiplier[HP_PidOf(udg_Hero_DemonHunter)])
if(hasDemonicPower and successfulRoll)then
call GenerateFuryAmount(amount)
endif
call GenerateFuryAmount(amount)
endfunction
function MetamorphosisIcons takes nothing returns nothing
local integer metamorphosisAbility='A0RD'
local integer theHuntAbility='A076'
local integer immolationAbility='A06F'
local integer demonSurgeAbility='A0CK'
local integer specAbility='A0CY'
if(GetUnitAbilityLevelSwapped(specAbility,udg_Glyphs_Unit[HP_SlotOf(udg_Hero_DemonHunter)])==1)then
call BlzSetAbilityIcon(metamorphosisAbility,"ReplaceableTextures\\CommandButtons\\BTNMetaHavoc.blp")
call BlzSetAbilityIcon(demonSurgeAbility,"ReplaceableTextures\\CommandButtons\\PASDemonsurge.blp")
call BlzSetAbilityIcon(theHuntAbility,"ReplaceableTextures\\CommandButtons\\BTNTheHunt.blp")
call BlzSetAbilityIcon(immolationAbility,"ReplaceableTextures\\CommandButtons\\BTNImmolationAura.blp")
endif
if(GetUnitAbilityLevelSwapped(specAbility,udg_Glyphs_Unit[HP_SlotOf(udg_Hero_DemonHunter)])==2)then
call BlzSetAbilityIcon(metamorphosisAbility,"ReplaceableTextures\\CommandButtons\\BTNMetaVengenace.blp")
endif
if(GetUnitAbilityLevelSwapped(specAbility,udg_Glyphs_Unit[HP_SlotOf(udg_Hero_DemonHunter)])==3)then
call BlzSetAbilityIcon(metamorphosisAbility,"ReplaceableTextures\\CommandButtons\\BTNMetaDevourer.blp")
call BlzSetAbilityIcon(demonSurgeAbility,"ReplaceableTextures\\CommandButtons\\PASDemonsurgeVoid.blp")
call BlzSetAbilityIcon(theHuntAbility,"ReplaceableTextures\\CommandButtons\\BTNTheHuntVoid.blp")
call BlzSetAbilityIcon(immolationAbility,"ReplaceableTextures\\CommandButtons\\BTNImmolationAuraVoid.blp")
endif
endfunction
function MoltenArmor takes unit u returns nothing
local integer bonusArmor=1+(1*GetUnitAbilityLevelSwapped('A0O1',udg_Hero_DragonSentinel))
local integer dummyAbilityLevel=0
call UnitAddAbilityBJ('A0JF',udg_Caster_Dummy)
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_DragonSentinel)],'I0LU')==true)then
set bonusArmor=bonusArmor+3
set dummyAbilityLevel=1
call SetUnitAbilityLevelSwapped('A0JF',udg_Caster_Dummy,2)
endif
call BlzSetAbilityIntegerLevelFieldBJ(BlzGetUnitAbility(udg_Caster_Dummy,'A0JF'),ABILITY_ILF_DEFENSE_INCREASE_INF2,dummyAbilityLevel,bonusArmor)
call IssueTargetOrderBJ(udg_Caster_Dummy,"innerfire",u)
call UnitRemoveAbilityBJ('A0JF',udg_Caster_Dummy)
endfunction
function GetBlazingShieldDamage takes nothing returns nothing
set udg_BlazingShield_ReflectDamage=((5.00*I2R(GetUnitAbilityLevelSwapped('A0O1',udg_Hero_DragonSentinel)))+(0.50*BlzGetUnitArmor(udg_Hero_DragonSentinel)))
endfunction
function MassEntanglementDamage takes unit target returns nothing
local real baseDamage=10.00*I2R(GetUnitAbilityLevelSwapped('A097',udg_Hero_Druid))
local real scaling=0.015*GetUnitStateSwap(UNIT_STATE_MAX_MANA,udg_Hero_Druid)*udg_Starsurge_Bonus
local real totalDamage=baseDamage+scaling
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Druid,target,totalDamage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endfunction
function PrimalInstinctsCheck takes unit damageSource returns boolean
local integer unitType=GetUnitTypeId(damageSource)
if(damageSource==udg_Hero_FeralDruid)then
else
return false
endif
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_FeralDruid)],'I0RS')==true)then
else
return false
endif
if(unitType=='O01B' or unitType=='O00J')then
else
return false
endif
return true
endfunction
function GetStaggerReduction takes nothing returns real
if(GetUnitAbilityLevelSwapped('A040',udg_Glyphs_Unit[HP_SlotOf(udg_Hero_Monk)])==2)then
return(0.25+(0.00005*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Monk)))
endif
return(0.25+(0.00003*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Monk)))
endfunction
function StaggerCalculation takes nothing returns nothing
local real staggerDamageTaken=udg_DamageEventAmount
local real staggerReduction=GetStaggerReduction()
set udg_Stagger_Amount=(udg_Stagger_Amount+(staggerDamageTaken*((1/(1.00-staggerReduction))-1)))
if(udg_Stagger_Amount>I2R(udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_Monk)]))then
set udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_Monk)]=R2I(udg_Stagger_Amount)
endif
call PolledWait(5.00)
set udg_Stagger_Amount=(udg_Stagger_Amount-(staggerDamageTaken*((1/(1.00-staggerReduction))-1)))
if(udg_Stagger_Amount<=0.00)then
set udg_Stagger_Amount=0.00
set udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_Monk)]=1
endif
endfunction
function GetPowerStrikeDamage takes nothing returns nothing
local real baseAmount=60.00*I2R(GetUnitAbilityLevelSwapped('A0JS',udg_Hero_Monk))
local real strScaling=1.00*I2R(GetHeroStatBJ(bj_HEROSTAT_STR,udg_Hero_Monk,true))
local real masteryModifier=1.05+(0.008*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Monk))]))
local real agilityModifier=1.00+(0.005*I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_Monk,true)))
local real shadoPanDmg
set udg_PowerStrike_Damage=(baseAmount+strScaling)*agilityModifier
if(GetUnitAbilityLevelSwapped('A040',udg_Glyphs_Unit[HP_SlotOf(udg_Hero_Monk)])==1)then
set udg_PowerStrike_Damage=udg_PowerStrike_Damage*masteryModifier
endif
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_Monk)],'I09U')and udg_WindwalkerSpec_Proc==false)then
set shadoPanDmg=udg_Stagger_Amount-(udg_Stagger_Amount*0.82)
set udg_Stagger_Amount=(udg_Stagger_Amount*0.82)
set udg_PowerStrike_Damage=udg_PowerStrike_Damage+shadoPanDmg
endif
endfunction
function SetRenewingMistHeal takes unit target returns nothing
local real baseAmount=10.00+(10.00*I2R(GetUnitAbilityLevelSwapped('A0F7',udg_Hero_Monk)))
local real intScaling=0.25*I2R(GetHeroStatBJ(bj_HEROSTAT_STR,udg_Hero_Monk,true))
local real maxHpScaling=0.005*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,target)
local real intMultiplier=0.005*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Monk,true))
local integer playerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Monk))
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_Monk)],'I0L2'))then
set maxHpScaling=maxHpScaling*2.00
endif
set udg_RenewingMist_Amount=(baseAmount+intScaling+maxHpScaling)*(1.00+intMultiplier)
if(UnitHasItemOfTypeBJ(udg_Talents_Unit[HP_SlotOf(udg_Hero_Monk)],'I04Y')and GetRandomReal(0,100.00)<=(40.00*udg_Luck_Multiplier[playerNumber]))then
set udg_RenewingMist_Amount=udg_RenewingMist_Amount*1.5
call AddSpecialEffectTargetUnitBJ("origin",target,"war3mapImported\\SCRenewingPulse.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
endif
if(UnitHasItemOfTypeBJ(udg_Hero_Monk,'I0UB'))then
set udg_RenewingMist_Amount=udg_RenewingMist_Amount*1.15
endif
endfunction
function IncreaseFistsOfFuryDamage takes real amount returns nothing
local real damageCap=50.00*I2R(GetUnitLevel(udg_Hero_Monk))
set udg_FistOfFury_Damage=udg_FistOfFury_Damage+amount
if(udg_FistOfFury_Damage>=damageCap)then
set udg_FistOfFury_Damage=damageCap
endif
endfunction
