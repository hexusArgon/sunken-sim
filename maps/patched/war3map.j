call UnitAddItemByIdSwapped('pghe',GetSoldUnit())
call UnitAddItemByIdSwapped('pghe',GetSoldUnit())
call UnitAddItemByIdSwapped('pgma',GetSoldUnit())
call TriggerRegisterPlayerEventEndCinematic(gg_trg_Stats_Dialog,ConvertedPlayer(udg_PlayerNumber_STR))
set udg_HeroPanel_Loop=1
loop
exitwhen udg_HeroPanel_Loop>3
set udg_HeroPanel_PlayerNumber=udg_HeroPanel_Loop
if(Trig_Select_Str_Hero_Func036Func002C())then
set udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber]=0
set udg_HeroPanel_Heroes[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=GetSoldUnit()
set udg_HeroPanel_Backpacks[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=udg_BackpackUnit[hp_s]
if(GetLocalPlayer()==GetOwningPlayer(GetSoldUnit()))then
call HP_CommitSlot(hp_s)
call TriggerExecute(gg_trg_Setup_Hero_Panel)
call HP_LoadSlot(hp_s)
endif
else
set udg_HeroPanel_OtherHeroesPicked[udg_HeroPanel_PlayerNumber]=(udg_HeroPanel_OtherHeroesPicked[udg_HeroPanel_PlayerNumber]+1)
