function Trig_OnDamage_Items_Glyphs_Func003Func006Func002Func003Func002C takes nothing returns boolean
if(not(GetEnumUnit()!=udg_DamageEventTarget))then
return false
endif
if(not(IsUnitEnemy(GetEnumUnit(),GetOwningPlayer(udg_DamageEventSource))==true))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_STRUCTURE)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_FLYING)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false))then
return false
endif
if(not(udg_IsUnitAlive[GetUnitUserData(GetEnumUnit())]==true))then
return false
endif
return true
endfunction
