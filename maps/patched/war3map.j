function Trig_Savage_Bite_Actions takes nothing returns nothing
if(Trig_Savage_Bite_Func001C())then
call StartTimerBJ(udg_RendAndTear_SavageBiteTimer,false,2.00)
else
endif
set udg_SavageBite_Target=GetSpellTargetUnit()
set udg_DCS_Unit=udg_Hero_FeralDruid
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
set udg_SavageBite_Damage=((40.00+(60.00*I2R(GetUnitAbilityLevelSwapped('A0CN',udg_Hero_FeralDruid))))+(1.50*udg_DCS_Damage))
if(Trig_Savage_Bite_Func011C())then
set udg_SavageBite_Damage=(udg_SavageBite_Damage*1.25)
else
endif
if(Trig_Savage_Bite_Func012C())then
set udg_SavageBite_Damage=(udg_SavageBite_Damage*(1+((0.01/ 2.00)*I2R(GetHeroStatBJ(bj_HEROSTAT_STR,udg_Hero_FeralDruid,true)))))
else
endif
if(Trig_Savage_Bite_Func013C())then
set udg_SavageBite_Damage=(udg_SavageBite_Damage*1.35)
else
endif
if(Trig_Savage_Bite_Func014C())then
set udg_NextDamageType=udg_DamageTypeMagical
else
set udg_NextDamageType=udg_DamageTypePhysical
endif
call UnitDamageTargetBJ(udg_Hero_FeralDruid,udg_SavageBite_Target,udg_SavageBite_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
if(Trig_Savage_Bite_Func016C())then
call AddSpecialEffectTargetUnitBJ("origin",udg_SavageBite_Target,"war3mapImported\\Mythic_Singularity I Blue.mdx")
else
call AddSpecialEffectTargetUnitBJ("origin",udg_SavageBite_Target,"Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
endif
call DestroyEffectBJ(GetLastCreatedEffectBJ())
if(Trig_Savage_Bite_Func019C())then
call UnitAddAbilityBJ('A0LZ',udg_Caster_Dummy)
if(Trig_Savage_Bite_Func019Func002C())then
set udg_Berserk_Armor=(2+(1*GetUnitAbilityLevelSwapped('A0CN',udg_Hero_FeralDruid)))
if(Trig_Savage_Bite_Func019Func002Func002C())then
set udg_Berserk_Armor=(udg_Berserk_Armor+4)
else
endif
call BlzSetAbilityIntegerLevelFieldBJ(BlzGetUnitAbility(udg_Caster_Dummy,'A0LZ'),ABILITY_ILF_DEFENSE_INCREASE_INF2,0,udg_Berserk_Armor)
else
endif
if(Trig_Savage_Bite_Func019Func003C())then
set udg_Berserk_Damage=(0.15+(0.05*I2R(GetUnitAbilityLevelSwapped('A0CN',udg_Hero_FeralDruid))))
if(Trig_Savage_Bite_Func019Func003Func003C())then
set udg_Berserk_Damage=(udg_Berserk_Damage+0.15)
else
endif
call BlzSetAbilityRealLevelFieldBJ(BlzGetUnitAbility(udg_Caster_Dummy,'A0LZ'),ABILITY_RLF_DAMAGE_INCREASE_PERCENT_INF1,0,udg_Berserk_Damage)
else
endif
call IssueTargetOrderBJ(udg_Caster_Dummy,"innerfire",GetTriggerUnit())
call UnitRemoveAbilityBJ('A0LZ',udg_Caster_Dummy)
else
endif
if(Trig_Savage_Bite_Func020C())then
call UnitAddAbilityBJ('A0MO',udg_Caster_Dummy)
call SetUnitAbilityLevelSwapped('A0MO',udg_Caster_Dummy,GetUnitAbilityLevelSwapped('A0MN',udg_Hero_FeralDruid))
call IssueTargetOrderBJ(udg_Caster_Dummy,"cripple",udg_SavageBite_Target)
call UnitRemoveAbilityBJ('A0MO',udg_Caster_Dummy)
else
endif
if(Trig_Savage_Bite_Func021C())then
set udg_Taunt_Attempter=udg_Hero_FeralDruid
set udg_Taunt_Target=udg_SavageBite_Target
set udg_Taunt_Duration=5.00
call ConditionalTriggerExecute(gg_trg_Taunting)
call RemoveLocation(udg_Generic_Point)
else
endif
if(Trig_Savage_Bite_Func022C())then
call UnitAddAbilityBJ('A0MT',udg_Caster_Dummy)
call IssueTargetOrderBJ(udg_Caster_Dummy,"faeriefire",udg_SavageBite_Target)
call UnitRemoveAbilityBJ('A0MT',udg_Caster_Dummy)
else
endif
endfunction
