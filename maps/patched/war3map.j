if(Trig_Divine_Image_Resonate_Func001Func006C())then
set udg_DivineImage_Heal=((15.00+(25.00*I2R(GetUnitAbilityLevelSwapped('A0JK',udg_Hero_Priest))))+(0.50*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Priest,true))))
if(Trig_Divine_Image_Resonate_Func001Func006Func002C())then
set udg_DivineImage_Heal=(udg_DivineImage_Heal*0.75)
else
endif
set udg_Heal_Amount=udg_DivineImage_Heal
set udg_Heal_Target=udg_DivineImage_Lowest
set udg_Heal_Healer=udg_Hero_Priest
call ConditionalTriggerExecute(gg_trg_Healing)
call AddSpecialEffectTargetUnitBJ("origin",udg_DivineImage_Lowest,"Abilities\\Spells\\Undead\\VampiricAura\\VampiricAuraTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
if(Trig_Divine_Image_Resonate_Func001Func006Func009C())then
call UnitAddAbilityBJ('A0FN',udg_Caster_Dummy)
call IssueTargetOrderBJ(udg_Caster_Dummy,"bloodlust",udg_DivineImage_Lowest)
call UnitRemoveAbilityBJ('A0FN',udg_Caster_Dummy)
else
endif
if(Trig_Divine_Image_Resonate_Func001Func006Func010C())then
set udg_TouchNaaru_Chance=20.00
if(Trig_Divine_Image_Resonate_Func001Func006Func010Func002C())then
set udg_TouchNaaru_Chance=10.00
else
endif
if(Trig_Divine_Image_Resonate_Func001Func006Func010Func003C())then
call TriggerExecute(gg_trg_Renew_Apply)
else
endif
else
endif
else
endif
if(Trig_Divine_Image_Resonate_Func001Func007C())then
set udg_DivineImage_Target=GroupPickRandomUnit(udg_DivineImage_Enemies)
set udg_DivineImage_Damage=((25.00*I2R(GetUnitAbilityLevelSwapped('A0JK',udg_Hero_Priest)))+(0.40*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Priest,true))))
if(Trig_Divine_Image_Resonate_Func001Func007Func003C())then
set udg_DivineImage_Damage=(udg_DivineImage_Damage*0.75)
else
endif
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Priest,udg_DivineImage_Target,udg_DivineImage_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
call AddSpecialEffectTargetUnitBJ("origin",udg_DivineImage_Target,"war3mapImported\\Mythic_Void Rain Missile.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
if(Trig_Divine_Image_Resonate_Func001Func007Func008C())then
set udg_CD_Dynamic_Hero=udg_Hero_Priest
set udg_CD_Dynamic_Ability='A0GB'
set udg_CD_Dynamic=BlzGetUnitAbilityCooldownRemaining(udg_CD_Dynamic_Hero,udg_CD_Dynamic_Ability)
set udg_TouchNaaru_CDR=0.40
if(Trig_Divine_Image_Resonate_Func001Func007Func008Func005C())then
set udg_TouchNaaru_CDR=(udg_TouchNaaru_CDR/ 2.00)
else
endif
set udg_CD_Dynamic_Reduction=udg_TouchNaaru_CDR
call ConditionalTriggerExecute(gg_trg_Dynamic_CDR)
else
endif
else
endif
call GroupClear(udg_DivineImage_Enemies)
call RemoveLocation(udg_Generic_Point)
endfunction
