if(Trig_Arcane_Spell_Mastery_Func010C())then
set udg_ArcaneMaster_Chance=(udg_ArcaneMaster_Chance+(5.00+(0.20*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(l__udg_Hero_Mage))]))))
