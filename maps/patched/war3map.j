set udg_Ferocity_GenerationTime=((1/ 12.00)/(1+udg_CDR[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_FeralDruid))]))
set udg_Ferocity_GenerationTime=(udg_Ferocity_GenerationTime/(1+(0.01*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_FeralDruid))]))))
call StartTimerBJ(udg_Ferocity_Timer,false,udg_Ferocity_GenerationTime)
set udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_FeralDruid)]=(100+(1*udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_FeralDruid))]))
if(Trig_Ferocity_Func005C())then
set udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_FeralDruid)]=(udg_CustomResource_MaxValue[HP_PidOf(udg_Hero_FeralDruid)]+25)
