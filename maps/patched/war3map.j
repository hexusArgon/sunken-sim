call QueuedTriggerAddBJ(gg_trg_Secret_Areas_Completed,true)
call QuestSetCompletedBJ(udg_Challenge[5],true)
call QuestMessageBJ(udg_Player_Group,bj_QUESTMESSAGE_COMPLETED,"TRIGSTR_881")
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=3
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
call AddSpecialEffectTargetUnitBJ("origin",udg_Agi_Str_Int[GetForLoopIndexB()],"Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl")
call ModifyHeroStat(bj_HEROSTAT_STR,udg_Agi_Str_Int[GetForLoopIndexB()],bj_MODIFYMETHOD_ADD,5)
call ModifyHeroStat(bj_HEROSTAT_AGI,udg_Agi_Str_Int[GetForLoopIndexB()],bj_MODIFYMETHOD_ADD,5)
call ModifyHeroStat(bj_HEROSTAT_INT,udg_Agi_Str_Int[GetForLoopIndexB()],bj_MODIFYMETHOD_ADD,5)
call AdjustPlayerStateBJ(500,ConvertedPlayer(GetForLoopIndexB()),PLAYER_STATE_RESOURCE_GOLD)
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call DisableTrigger(GetTriggeringTrigger())
else
call QueuedTriggerAddBJ(gg_trg_Secret_Area_Found,true)
endif
endfunction
