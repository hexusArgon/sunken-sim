function Trig_Claw_of_Nzoth_Actions takes nothing returns nothing
if(Trig_Claw_of_Nzoth_Func002C())then
set udg_GenericPlayerGroup=GetPlayersMatching(Condition(function Trig_Claw_of_Nzoth_Func002Func001002001))
set udg_Generic_Point=GetUnitLoc(udg_Agi_Str_Int[1])
call CreateTextTagLocBJ(udg_Nzoth_Message[GetRandomInt(1,15)],udg_Generic_Point,0,12.00,100.00,100,100,0)
call RemoveLocation(udg_Generic_Point)
call ShowTextTagForceBJ(false,GetLastCreatedTextTag(),udg_GenericPlayerGroup)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),6.00)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),5.00)
else
endif
if(Trig_Claw_of_Nzoth_Func003C())then
set udg_GenericPlayerGroup=GetPlayersMatching(Condition(function Trig_Claw_of_Nzoth_Func003Func001002001))
set udg_Generic_Point=GetUnitLoc(udg_Agi_Str_Int[2])
