function Trig_Luck_Tooltip_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_Luck_Hero))
set udg_Luck_Bonus[udg_PlayerNumber]=0.00
call ConditionalTriggerExecute(gg_trg_Luck_Buffs_Setup)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_Luck_BuffsMax
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_Luck_Tooltip_Func004Func001C())then
set udg_Luck_Bonus[udg_PlayerNumber]=(udg_Luck_Bonus[udg_PlayerNumber]+udg_Luck_BuffValue[GetForLoopIndexA()])
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if(Trig_Luck_Tooltip_Func006C())then
if(Trig_Luck_Tooltip_Func006Func003C())then
set udg_Luck_Bonus[udg_PlayerNumber]=(udg_Luck_Bonus[udg_PlayerNumber]+(I2R(udg_MasterGambler_Amount)/ 100.00))
else
endif
else
endif
if(Trig_Luck_Tooltip_Func008C())then
if(Trig_Luck_Tooltip_Func008Func003C())then
set udg_Luck_Bonus[udg_PlayerNumber]=(udg_Luck_Bonus[udg_PlayerNumber]+(0.05+(0.01*I2R(GetHeroLevel(udg_Luck_Hero)))))
else
endif
if(Trig_Luck_Tooltip_Func008Func005C())then
set udg_Luck_Bonus[udg_PlayerNumber]=(udg_Luck_Bonus[udg_PlayerNumber]+(0.01*I2R(GetItemCharges(GetItemOfTypeFromUnitBJ(udg_Luck_Hero,'I0SP')))))
else
endif
if(Trig_Luck_Tooltip_Func008Func007C())then
set udg_Attribute_Index=1
loop
exitwhen udg_Attribute_Index>3
if(Trig_Luck_Tooltip_Func008Func007Func001Func001C())then
set udg_Luck_Bonus[udg_PlayerNumber]=(udg_Luck_Bonus[udg_PlayerNumber]+0.08)
else
endif
set udg_Attribute_Index=udg_Attribute_Index+1
endloop
else
endif
else
endif
set udg_Luck_Stat[udg_PlayerNumber]=(udg_Luck_Items[udg_PlayerNumber]+udg_Luck_Bonus[udg_PlayerNumber])
set udg_Luck_Multiplier[udg_PlayerNumber]=(1.00+udg_Luck_Stat[udg_PlayerNumber])
set udg_LuckToInt=R2I(((udg_Luck_Stat[udg_PlayerNumber]*100.00)+0.50))
set udg_PlayerIndex=(100*udg_PlayerNumber)
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_Luck)]=(I2S(udg_LuckToInt)+"%")
endfunction
function InitTrig_Luck_Tooltip takes nothing returns nothing
set gg_trg_Luck_Tooltip=CreateTrigger()
call TriggerAddAction(gg_trg_Luck_Tooltip,function Trig_Luck_Tooltip_Actions)
endfunction
