if(Trig_Blessed_Hammer_Rotation_Func001Func001Func005C())then
set udg_BH_Angle[udg_BH_CustomValue]=(udg_BH_Angle[udg_BH_CustomValue]+6.00)
set udg_BH_Distance[udg_BH_CustomValue]=(udg_BH_Distance[udg_BH_CustomValue]+0.33)
set udg_BH_Pala_Point=GetUnitLoc(udg_Hero_Paladin)
set udg_BH_Offset_Point=PolarProjectionBJ(udg_BH_Pala_Point,udg_BH_Distance[udg_BH_CustomValue],udg_BH_Angle[udg_BH_CustomValue])
call RemoveLocation(udg_BH_Pala_Point)
call SetUnitX(udg_BH_Unit,GetLocationX(udg_BH_Offset_Point))
call SetUnitY(udg_BH_Unit,GetLocationY(udg_BH_Offset_Point))
call BlzSetUnitFacingEx(udg_BH_Unit,(udg_BH_Angle[udg_BH_CustomValue]+90.00))
set udg_BH_Duration[udg_BH_CustomValue]=(udg_BH_Duration[udg_BH_CustomValue]-0.03)
