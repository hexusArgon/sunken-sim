function Trig_Bonus_Drop_Actions takes nothing returns nothing
call CreateTextTagUnitBJ(("|cffffcc00Magic Find:|r "+GetItemName(udg_Dropped_Item)),udg_Dropped_Item_Unit,0,9.10,100,100,100.00,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),4.00)
set udg_Dropped_Item_Point=GetItemLoc(udg_Dropped_Item)
call AddSpecialEffectLocBJ(udg_Dropped_Item_Point,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Dropped_Item_Point)
endfunction
function InitTrig_Bonus_Drop takes nothing returns nothing
set gg_trg_Bonus_Drop=CreateTrigger()
call TriggerAddAction(gg_trg_Bonus_Drop,function Trig_Bonus_Drop_Actions)
endfunction
