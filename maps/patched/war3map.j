function Trig_Mastery_Buffs_Setup_Actions takes nothing returns nothing
set udg_Mastery_BuffType[1]='B07I'
set udg_Mastery_BuffValue[1]=15
set udg_Mastery_BuffType[2]='B08U'
set udg_Mastery_BuffValue[2]=8
set udg_Mastery_BuffType[3]='B03Y'
if(Trig_Mastery_Buffs_Setup_Func007C())then
set udg_TreasuresOfAtlantis_Count=0
set udg_TreasuresOfAtlantis_Loop=1
loop
exitwhen udg_TreasuresOfAtlantis_Loop>6
if(Trig_Mastery_Buffs_Setup_Func007Func002Func001C())then
set udg_TreasuresOfAtlantis_Count=(udg_TreasuresOfAtlantis_Count+1)
else
endif
set udg_TreasuresOfAtlantis_Loop=udg_TreasuresOfAtlantis_Loop+1
endloop
set udg_Mastery_BuffValue[3]=(10+(8*udg_TreasuresOfAtlantis_Count))
else
set udg_Mastery_BuffValue[3]=0
endif
set udg_Mastery_BuffType[4]='B08F'
set udg_Mastery_BuffValue[4]=30
set udg_Mastery_BuffType[5]='B03I'
set udg_Mastery_BuffValue[5]=20
set udg_Mastery_BuffType[6]='B092'
set udg_Mastery_BuffValue[6]=12
set udg_Mastery_BuffType[7]='B098'
set udg_Mastery_BuffValue[7]=12
set udg_Mastery_BuffsMax=7
endfunction
