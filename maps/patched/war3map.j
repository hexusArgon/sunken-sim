function Trig_Eye_Beam_Periodic_Func001Func001Func057Func022A takes nothing returns nothing
set udg_EyBe_Unit[3]=GetEnumUnit()
set udg_EyBe_Point[8]=GetUnitLoc(udg_EyBe_Unit[3])
call IssueTargetOrderBJ(udg_EyBe_Unit_Dummy,"slow",udg_EyBe_Unit[3])
set udg_EyBe_Point_Z_Height[5]=GetLocationZ(udg_EyBe_Point[8])
call AddSpecialEffectLocBJ(udg_EyBe_Point[8],udg_EyBe_Config_Effect_Path[1])
set udg_EyBe_Spef=GetLastCreatedEffectBJ()
call BlzSetSpecialEffectHeight(udg_EyBe_Spef,(udg_EyBe_Config_Height[1]+(udg_EyBe_Point_Z_Height[5]+GetUnitFlyHeight(udg_EyBe_Unit[3]))))
call BlzSetSpecialEffectYaw(udg_EyBe_Spef,Deg2Rad(AngleBetweenPoints(udg_EyBe_Point[3],udg_EyBe_Point[8])))
call DestroyEffectBJ(udg_EyBe_Spef)
if(Trig_Eye_Beam_Periodic_Func001Func001Func057Func022Func010C())then
set udg_EyBe_DamageLoop=2
else
set udg_EyBe_DamageLoop=1
endif
set udg_EyBe_Index=1
loop
exitwhen udg_EyBe_Index>udg_EyBe_DamageLoop
if(Trig_Eye_Beam_Periodic_Func001Func001Func057Func022Func011Func001C())then
call StartTimerBJ(udg_EyBe_ChaosCD,false,0.20)
set udg_NextDamageIsAttack=true
call UnitDamageTargetBJ(udg_EyBe_Unit_Caster[udg_EyBe_Loop],udg_EyBe_Unit[3],udg_EyBe_Damage[udg_EyBe_Loop],ATTACK_TYPE_CHAOS,DAMAGE_TYPE_NORMAL)
if(Trig_Eye_Beam_Periodic_Func001Func001Func057Func022Func011Func001Func006C())then
call TriggerExecute(gg_trg_Hurl_Throw_Glaive)
else
endif
else
call UnitDamageTargetBJ(udg_EyBe_Unit_Caster[udg_EyBe_Loop],udg_EyBe_Unit[3],udg_EyBe_Damage[udg_EyBe_Loop],ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endif
set udg_EyBe_Index=udg_EyBe_Index+1
endloop
call RemoveLocation(udg_EyBe_Point[8])
endfunction
