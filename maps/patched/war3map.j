function InitTrig_Click_Button takes nothing returns nothing
set gg_trg_Click_Button=CreateTrigger()
call TriggerRegisterDialogEventBJ(gg_trg_Click_Button,udg_PoG_Dialog[1])
call TriggerRegisterDialogEventBJ(gg_trg_Click_Button,udg_PoG_Dialog[2])
