set gg_trg_Gold_Mine_Entering=CreateTrigger()
call TriggerRegisterEnterRectSimple(gg_trg_Gold_Mine_Entering,gg_rct_Gold_Mine_Entrance)
call TriggerAddCondition(gg_trg_Gold_Mine_Entering,Condition(function Trig_Gold_Mine_Entering_Conditions))
