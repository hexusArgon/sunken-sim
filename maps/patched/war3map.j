function Trig_Stats_Dialog_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetTriggerPlayer())
call setVisibilityStatisticDashboard(Player(udg_PlayerNumber-1),false)
call DialogClearBJ(udg_ESC_Dialog[udg_PlayerNumber])
if(Trig_Stats_Dialog_Func005C())then
call DialogSetMessageBJ(udg_ESC_Dialog[udg_PlayerNumber],("Stats Menu "+("["+(I2S(udg_ESC_Points[udg_PlayerNumber])+" Point]"))))
else
call DialogSetMessageBJ(udg_ESC_Dialog[udg_PlayerNumber],("Stats Menu "+("["+(I2S(udg_ESC_Points[udg_PlayerNumber])+" Points]"))))
endif
if(Trig_Stats_Dialog_Func013C())then
set udg_ESC_Stat_Color="|cffffcc00"
else
if(Trig_Stats_Dialog_Func013Func001C())then
set udg_ESC_Stat_Color="|c005ddf26"
else
endif
endif
if(Trig_Stats_Dialog_Func014C())then
set udg_ESC_Stat_Points_Text=" ("+udg_ESC_Stat_Color+I2S(udg_ESC_Points_Health[udg_PlayerNumber])+"|cffffffff)"
else
set udg_ESC_Stat_Points_Text=""
endif
set udg_ESC_Stat_Text="|cffffffffIncrease Health +30"+udg_ESC_Stat_Points_Text
call DialogAddButtonBJ(udg_ESC_Dialog[udg_PlayerNumber],udg_ESC_Stat_Text)
set udg_ESC_Button_Health[udg_PlayerNumber]=GetLastCreatedButtonBJ()
if(Trig_Stats_Dialog_Func019C())then
set udg_ESC_Stat_Color="|cffffcc00"
else
if(Trig_Stats_Dialog_Func019Func001C())then
set udg_ESC_Stat_Color="|c005ddf26"
else
endif
endif
if(Trig_Stats_Dialog_Func020C())then
set udg_ESC_Stat_Points_Text=" ("+udg_ESC_Stat_Color+I2S(udg_ESC_Points_Mana[udg_PlayerNumber])+"|cffffffff)"
else
set udg_ESC_Stat_Points_Text=""
endif
set udg_ESC_Stat_Text="|cffffffffIncrease Mana +20"+udg_ESC_Stat_Points_Text
call DialogAddButtonBJ(udg_ESC_Dialog[udg_PlayerNumber],udg_ESC_Stat_Text)
set udg_ESC_Button_Mana[udg_PlayerNumber]=GetLastCreatedButtonBJ()
if(Trig_Stats_Dialog_Func025C())then
set udg_ESC_Stat_Color="|cffffcc00"
else
if(Trig_Stats_Dialog_Func025Func001C())then
set udg_ESC_Stat_Color="|c005ddf26"
else
endif
endif
if(Trig_Stats_Dialog_Func026C())then
set udg_ESC_Stat_Points_Text=" ("+udg_ESC_Stat_Color+I2S(udg_ESC_Points_HealingPower[udg_PlayerNumber])+"|cffffffff)"
else
set udg_ESC_Stat_Points_Text=""
