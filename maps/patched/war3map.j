else
endif
set udg_HealingPower_Stat[udg_PlayerNumber]=(udg_HealingPower_Items[udg_PlayerNumber]+udg_HealingPower_Bonus[udg_PlayerNumber])
set udg_PlayerIndex=(100*udg_PlayerNumber)
