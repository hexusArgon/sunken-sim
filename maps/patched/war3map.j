function Trig_CDR_Cast_And_Spell_Types_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))
call s__StatisticRow_addValue(totalSpellcastsRow,udg_PlayerNumber-1,1)
if(Trig_CDR_Cast_And_Spell_Types_Func006C())then
if(Trig_CDR_Cast_And_Spell_Types_Func006Func002C())then
set udg_SpellType_Magical=true
call s__StatisticRow_addValue(totalMagicalSpellcastsRow,udg_PlayerNumber-1,1)
else
set udg_SpellType_Magical=false
endif
if(Trig_CDR_Cast_And_Spell_Types_Func006Func004C())then
set udg_SpellType_Physical=true
call s__StatisticRow_addValue(totalPhysicalSpellcastsRow,udg_PlayerNumber-1,1)
else
set udg_SpellType_Physical=false
endif
if(Trig_CDR_Cast_And_Spell_Types_Func006Func006C())then
set udg_SpellType_Healing=true
call s__StatisticRow_addValue(totalHealingSpellcastsRow,udg_PlayerNumber-1,1)
else
set udg_SpellType_Healing=false
endif
if(Trig_CDR_Cast_And_Spell_Types_Func006Func008C())then
set udg_SpellType_Summoning=true
call s__StatisticRow_addValue(totalSummoningSpellcastsRow,udg_PlayerNumber-1,1)
else
set udg_SpellType_Summoning=false
endif
if(Trig_CDR_Cast_And_Spell_Types_Func006Func010C())then
call s__StatisticRow_addValue(totalNASpellcastsRow,udg_PlayerNumber-1,1)
else
endif
else
endif
if(Trig_CDR_Cast_And_Spell_Types_Func010C())then
if(Trig_CDR_Cast_And_Spell_Types_Func010Func001C())then
call BlzSetAbilityIntegerLevelFieldBJ(BlzGetUnitAbility(GetTriggerUnit(),GetSpellAbilityId()),ABILITY_ILF_MANA_COST,(GetUnitAbilityLevelSwapped(GetSpellAbilityId(),GetTriggerUnit())-1),(13+(1*GetHeroLevel(GetTriggerUnit()))))
else
endif
else
endif
set udg_CDR[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=0.00
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_CDR_Buffs_Max
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_CDR_Cast_And_Spell_Types_Func017Func001C())then
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+udg_CDR_Buff_Value[GetForLoopIndexA()])
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+(I2R(udg_Haste_Items[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])/ 100.00))
if(Trig_CDR_Cast_And_Spell_Types_Func021C())then
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+(0.01*I2R(udg_ESC_Points_CDR[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))])))
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+(I2R(udg_PoG_Haste_Sum[GetConvertedPlayerId(GetTriggerPlayer())])/ 100.00))
if(Trig_CDR_Cast_And_Spell_Types_Func021Func006C())then
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+0.07)
else
endif
if(Trig_CDR_Cast_And_Spell_Types_Func021Func008C())then
set udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_CDR[GetConvertedPlayerId(GetTriggerPlayer())]+0.10)
