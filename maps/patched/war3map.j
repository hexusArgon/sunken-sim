function InitTrig_Select_Agi_Hero takes nothing returns nothing
set gg_trg_Select_Agi_Hero=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Select_Agi_Hero,EVENT_PLAYER_UNIT_SELL)
call TriggerAddCondition(gg_trg_Select_Agi_Hero,Condition(function Trig_Select_Agi_Hero_Conditions))
call TriggerAddAction(gg_trg_Select_Agi_Hero,function Trig_Select_Agi_Hero_Actions)
endfunction
