function Trig_Initialization_Items_Func005C takes nothing returns boolean
if(not(GetPlayerController(Player(0))==MAP_CONTROL_USER))then
return false
endif
if(not(GetPlayerSlotState(Player(0))==PLAYER_SLOT_STATE_PLAYING))then
return false
endif
return true
endfunction
