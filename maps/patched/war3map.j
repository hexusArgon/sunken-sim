function Trig_Eye_Beam_Cast_Actions takes nothing returns nothing
set udg_EyBe_Unit[1]=GetTriggerUnit()
set udg_EyBe_Point[0]=GetUnitLoc(udg_EyBe_Unit[1])
set udg_EyBe_Point[1]=GetSpellTargetLoc()
set udg_EyBe_Point[2]=PolarProjectionBJ(udg_EyBe_Point[0],(udg_EyBe_Config_Range-udg_EyBe_Config_End_P_Offset),AngleBetweenPoints(udg_EyBe_Point[0],udg_EyBe_Point[1]))
set udg_EyBe_LvL=GetUnitAbilityLevelSwapped(udg_EyBe_Config_Ability[0],udg_EyBe_Unit[1])
set udg_EyBe_Index=(udg_EyBe_Index+1)
set udg_EyBe_Point_Z_Height[0]=GetLocationZ(udg_EyBe_Point[0])
set udg_EyBe_XYZ[1]=GetLocationX(udg_EyBe_Point[0])
set udg_EyBe_XYZ[2]=GetLocationY(udg_EyBe_Point[0])
set udg_EyBe_XYZ[3]=(GetUnitFlyHeight(udg_EyBe_Unit_Caster[udg_EyBe_Loop])+(udg_EyBe_Config_Height[0]+udg_EyBe_Point_Z_Height[0]))
set udg_EyBe_Point_Z_Height[1]=GetLocationZ(udg_EyBe_Point[2])
set udg_EyBe_XYZ2[1]=GetLocationX(udg_EyBe_Point[2])
set udg_EyBe_XYZ2[2]=GetLocationY(udg_EyBe_Point[2])
set udg_EyBe_XYZ2[3]=(udg_EyBe_Config_Height[0]+udg_EyBe_Point_Z_Height[1])
set udg_EyBe_Lightning[(udg_EyBe_Index)]=AddLightningEx(udg_EyBe_Config_Lightning_Type,true,udg_EyBe_XYZ[1],udg_EyBe_XYZ[2],udg_EyBe_XYZ[3],udg_EyBe_XYZ2[1],udg_EyBe_XYZ2[2],udg_EyBe_XYZ2[3])
set udg_EyBe_Unit_Caster[udg_EyBe_Index]=udg_EyBe_Unit[1]
set udg_EyBe_UnitC_Angle[udg_EyBe_Index]=AngleBetweenPoints(udg_EyBe_Point[0],udg_EyBe_Point[2])
set udg_DCS_Unit=udg_Hero_DemonHunter
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
set udg_EyBe_Damage[udg_EyBe_Index]=(7.00+(0.15*udg_DCS_Damage))
set udg_EyBe_Duration[udg_EyBe_Index]=udg_EyBe_Config_Duration[udg_EyBe_LvL]
set udg_EyBe_Duration_Slow[udg_EyBe_Index]=udg_EyBe_Config_Duration_Slow[udg_EyBe_LvL]
set udg_EyBe_Owner[udg_EyBe_Index]=GetOwningPlayer(udg_EyBe_Unit[1])
set udg_EyBe_Slow[udg_EyBe_Index]=udg_EyBe_Config_Slow[udg_EyBe_LvL]
set udg_EyBe_Tick[udg_EyBe_Index]=0.00
set udg_EyBe_Width[udg_EyBe_Index]=udg_EyBe_Config_Width[udg_EyBe_LvL]
call SetUnitFacingToFaceLocTimed(udg_EyBe_Unit_Caster[udg_EyBe_Loop],udg_EyBe_Point[2],0.00)
call AddSpecialEffectLocBJ(udg_EyBe_Point[2],udg_EyBe_Config_Effect_Path[0])
call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(),4.50)
set udg_EyBe_Point_Node[udg_EyBe_Index]=GetLastCreatedEffectBJ()
if(Trig_Eye_Beam_Cast_Func053C())then
call EnableTrigger(gg_trg_Eye_Beam_Periodic)
else
endif
call RemoveLocation(udg_EyBe_Point[0])
call RemoveLocation(udg_EyBe_Point[1])
call RemoveLocation(udg_EyBe_Point[2])
endfunction
