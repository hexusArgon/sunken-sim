function AbilitiesInit___RegisterSingleAbility takes integer abilCode,trigger whichTriggerToExecute returns nothing
call SaveTriggerHandle(AbilityToTriggerHT,abilCode,0,whichTriggerToExecute)
endfunction
function AbilitiesInit___OnCastAbility takes nothing returns nothing
local unit caster=GetSpellAbilityUnit()
local integer abil_code=GetSpellAbilityId()
if(HaveSavedHandle(AbilityToTriggerHT,abil_code,0))then
call TriggerExecute(LoadTriggerHandle(AbilityToTriggerHT,abil_code,0))
endif
endfunction
function AbilitiesInit___RegisterAbilities takes nothing returns nothing
