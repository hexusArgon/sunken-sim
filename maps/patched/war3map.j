call RemoveLocation(udg_BH_Offset_Point)
endif
else
call FlushChildHashtableBJ(udg_BH_CustomValue,udg_Hashtable_STR)
call GroupRemoveUnitSimple(udg_BH_Unit,udg_BH_HammerGroup)
call GroupAddUnitSimple(udg_BH_Unit,udg_BH_FreeGroup)
