function Trig_Soul_Possession_Actions takes nothing returns nothing
set udg_SoulPossession_Duration=(10.00+(2.00*I2R(GetUnitAbilityLevelSwapped('A0PJ',udg_Hero_WitchDoctor))))
if(Trig_Soul_Possession_Func002C())then
set udg_SoulPossession_Duration=(udg_SoulPossession_Duration+4.00)
else
endif
set udg_SoulPossession_Target=GetSpellTargetUnit()
call UnitAddAbilityBJ('A0PO',udg_Caster_Dummy)
call BlzSetAbilityRealLevelFieldBJ(BlzGetUnitAbility(udg_Caster_Dummy,'A0PO'),ABILITY_RLF_DURATION_NORMAL,(GetUnitAbilityLevelSwapped('A0PJ',udg_Hero_WitchDoctor)-1),udg_SoulPossession_Duration)
call BlzSetAbilityRealLevelFieldBJ(BlzGetUnitAbility(udg_Caster_Dummy,'A0PO'),ABILITY_RLF_DURATION_HERO,(GetUnitAbilityLevelSwapped('A0PJ',udg_Hero_WitchDoctor)-1),udg_SoulPossession_Duration)
call IssueTargetOrderBJ(udg_Caster_Dummy,"faeriefire",udg_SoulPossession_Target)
call UnitRemoveAbilityBJ('A0PO',udg_Caster_Dummy)
if(Trig_Soul_Possession_Func011C())then
set udg_Generic_Point=GetUnitLoc(udg_SoulPossession_Target)
call CreateNUnitsAtLoc(1,'u009',GetOwningPlayer(GetTriggerUnit()),udg_Generic_Point,GetUnitFacing(GetTriggerUnit()))
call RemoveLocation(udg_Generic_Point)
else
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
call CreateNUnitsAtLoc(1,'u00A',GetOwningPlayer(GetTriggerUnit()),udg_Generic_Point,GetUnitFacing(GetTriggerUnit()))
call BlzSetUnitWeaponRealFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_RF_ATTACK_PROJECTILE_SPEED,0,BlzGetUnitWeaponRealField(udg_SoulPossession_Target,UNIT_WEAPON_RF_ATTACK_PROJECTILE_SPEED,0))
call BlzSetUnitWeaponRealFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_RF_ATTACK_PROJECTILE_ARC,0,BlzGetUnitWeaponRealField(udg_SoulPossession_Target,UNIT_WEAPON_RF_ATTACK_PROJECTILE_ARC,0))
call BlzSetUnitWeaponBooleanFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_BF_ATTACK_PROJECTILE_HOMING_ENABLED,0,BlzGetUnitWeaponBooleanField(udg_SoulPossession_Target,UNIT_WEAPON_BF_ATTACK_PROJECTILE_HOMING_ENABLED,0))
call BlzSetUnitWeaponStringFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART,0,BlzGetUnitWeaponStringField(udg_SoulPossession_Target,UNIT_WEAPON_SF_ATTACK_PROJECTILE_ART,0))
call RemoveLocation(udg_Generic_Point)
endif
call UnitApplyTimedLifeBJ(udg_SoulPossession_Duration,'BTLF',GetLastCreatedUnit())
call BlzSetUnitSkin(GetLastCreatedUnit(),BlzGetUnitSkin(udg_SoulPossession_Target))
set udg_GetBaseDamage_Unit=GetLastCreatedUnit()
call BlzSetUnitBaseDamage(udg_GetBaseDamage_Unit,BlzGetUnitWeaponIntegerField(udg_SoulPossession_Target,UNIT_WEAPON_IF_ATTACK_DAMAGE_BASE,0),0)
call BlzSetUnitMaxHP(GetLastCreatedUnit(),BlzGetUnitMaxHP(udg_SoulPossession_Target))
call SetUnitLifePercentBJ(GetLastCreatedUnit(),GetUnitLifePercent(udg_SoulPossession_Target))
call BlzSetUnitArmor(GetLastCreatedUnit(),BlzGetUnitArmor(udg_SoulPossession_Target))
call UnitAddAbilityBJ('A0QO',GetLastCreatedUnit())
call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(),UNIT_RF_SCALING_VALUE,BlzGetUnitRealField(udg_SoulPossession_Target,UNIT_RF_SCALING_VALUE))
call BlzSetUnitRealFieldBJ(GetLastCreatedUnit(),UNIT_RF_SELECTION_SCALE,BlzGetUnitRealField(udg_SoulPossession_Target,UNIT_RF_SELECTION_SCALE))
call BlzSetUnitIntegerFieldBJ(GetLastCreatedUnit(),UNIT_IF_DEFENSE_TYPE,BlzGetUnitIntegerField(udg_SoulPossession_Target,UNIT_IF_DEFENSE_TYPE))
call BlzSetUnitWeaponRealFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN,0,BlzGetUnitWeaponRealField(udg_SoulPossession_Target,UNIT_WEAPON_RF_ATTACK_BASE_COOLDOWN,0))
call BlzSetUnitWeaponRealFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_RF_ATTACK_RANGE,0,BlzGetUnitWeaponRealField(udg_SoulPossession_Target,UNIT_WEAPON_RF_ATTACK_RANGE,0))
call BlzSetUnitWeaponIntegerFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE,0,BlzGetUnitWeaponIntegerField(udg_SoulPossession_Target,UNIT_WEAPON_IF_ATTACK_ATTACK_TYPE,0))
call BlzSetUnitWeaponIntegerFieldBJ(GetLastCreatedUnit(),UNIT_WEAPON_IF_ATTACK_WEAPON_SOUND,0,BlzGetUnitWeaponIntegerField(udg_SoulPossession_Target,UNIT_WEAPON_IF_ATTACK_WEAPON_SOUND,0))
call SetUnitVertexColorBJ(GetLastCreatedUnit(),47.00,47.00,100,25.00)
endfunction
