if(GetUnitAbilityLevelSwapped(specAbility,udg_Glyphs_Unit[HP_SlotOf(udg_Hero_Priest)])==2)then
call BlzSetAbilityIcon(divineImageAbility,"ReplaceableTextures\\CommandButtons\\BTNNaaruHoly.blp")
endif
if(GetUnitAbilityLevelSwapped(specAbility,udg_Glyphs_Unit[HP_SlotOf(udg_Hero_Priest)])==3)then
call BlzSetAbilityIcon(divineImageAbility,"ReplaceableTextures\\CommandButtons\\BTNNaaruShadow.blp")
endif
endif
endfunction
function HomingMissilesTooltip takes nothing returns nothing
local string tooltipDescription="Fires |cffffcc005|r homing missiles at random enemies within |cffffcc00450|r range of the targeted point, each dealing damage |c00cd7004(+20% of Damage) (+15% of Strength)|r to its target. Targeting a specific enemy will cause all missiles to home in on that target. Otherwise, the missiles will be split evenly between all available enemies. Cannot fire more than |cffffcc0013|r missiles at a time."
local string tooltipLearnExtended=tooltipDescription+"|n|nDamage: |cffffcc0030/50/70/90|r|n|nMana: |cff51a8ff10/20/30/40|r|n|c00f58cbaCooldown: 4.0|r"
local string array tooltipNormalExtended
local string finalTooltipLearn
local string finalTooltipNormal
local string abilityType
local string abilityIcon
local integer tooltipLoop
set tooltipNormalExtended[0]=tooltipDescription+"|n|nDamage: |cffffcc0030|r|n|n|c00f58cbaCooldown: "
set tooltipNormalExtended[1]=tooltipDescription+"|n|nDamage: |cffffcc0050|r|n|n|c00f58cbaCooldown: "
set tooltipNormalExtended[2]=tooltipDescription+"|n|nDamage: |cffffcc0070|r|n|n|c00f58cbaCooldown: "
set tooltipNormalExtended[3]=tooltipDescription+"|n|nDamage: |cffffcc0090|r|n|n|c00f58cbaCooldown: "
if GetUnitTypeId(udg_Hero_Tinker)=='N04I' then
set abilityType="Type: |c000099ffMagical|r|n"
set abilityIcon="ReplaceableTextures\\CommandButtons\\BTNHomingMissilesMagic.blp"
else
set abilityType="Type: |c00ff8000Physical|r|n"
set abilityIcon="ReplaceableTextures\\CommandButtons\\BTNHomingMissiles.blp"
endif
set finalTooltipLearn=abilityType+tooltipLearnExtended
if GetUnitAbilityLevelSwapped('A02T',udg_Hero_Tinker)>=1 then
call BlzSetAbilityIcon('A02T',abilityIcon)
set tooltipLoop=0
loop
exitwhen tooltipLoop>3
set finalTooltipNormal=abilityType+tooltipNormalExtended[tooltipLoop]
call BlzSetAbilityResearchExtendedTooltip('A02T',finalTooltipLearn,tooltipLoop)
call BlzSetAbilityExtendedTooltip('A02T',finalTooltipNormal,tooltipLoop)
set udg_Ability_Str_Tooltip[tooltipLoop+9]=finalTooltipNormal
set tooltipLoop=tooltipLoop+1
endloop
endif
set udg_Ability_Str_CD_FPSCheck[3]=0.00
set udg_CDR_Unit=udg_Hero_Tinker
set udg_CDR_AbilityCast='A02T'
call ConditionalTriggerExecute(gg_trg_CDR_Setup)
endfunction
function AddFirebolt takes unit demon returns nothing
local integer fireboltAbility='A0R4'
local real fireboltDamage=10.00+(0.10*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Warlock,true)))
call UnitAddAbilityBJ(fireboltAbility,demon)
call BlzSetAbilityRealLevelFieldBJ(BlzGetUnitAbility(demon,fireboltAbility),ABILITY_RLF_INITIAL_DAMAGE_PXF1,0,fireboltDamage)
endfunction
function MaleficHoodDamage takes unit target returns nothing
local real damage=30.00+(0.30*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Warlock,true)))
local boolean procs=GetRandomReal(0,100.00)<=(33.00*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Warlock))])
if(procs)then
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Warlock,target,damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endif
endfunction
