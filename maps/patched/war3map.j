function Trig_Serpent_Sting_Periodic_Func010Func002C takes nothing returns boolean
if(not(CountUnitsInGroup(udg_HoTSys_SerpentSting)>0))then
return false
endif
if(not(GetUnitAbilityLevelSwapped('A098',udg_Glyphs_Unit[HP_SlotOf(udg_Hero_Hunter)])==3))then
return false
endif
if(not(udg_IsUnitAlive[GetUnitUserData(udg_Hero_Hunter)]==true))then
return false
endif
if(not(GetRandomReal(0,100.00)<=(5.00+(0.20*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Hunter))])))))then
return false
endif
