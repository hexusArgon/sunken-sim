else
endif
set udg_PoG_Loop=udg_PoG_Loop+1
endloop
set udg_PoG_Loop=1
loop
exitwhen udg_PoG_Loop>udg_Drops_EpicUnique
if(Trig_Show_Dialog_Func008Func001C())then
set udg_PoG_MaxRoll=udg_PoG_EpicMax
set udg_PoG_MaxSlots[udg_PlayerNumber]=5
set udg_PoG_DisenchantedTier=udg_PoG_TierEpic
call RemoveItem(udg_PoG_ItemToDisenchant)
