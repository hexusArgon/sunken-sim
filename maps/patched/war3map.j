endfunction
function Trig_Claw_of_Nzoth_Func001C takes nothing returns boolean
if((UnitHasItemOfTypeBJ(udg_Agi_Str_Int[1],'I03A')==true))then
return true
endif
if((UnitHasItemOfTypeBJ(udg_Agi_Str_Int[2],'I03A')==true))then
return true
endif
if((UnitHasItemOfTypeBJ(udg_Agi_Str_Int[3],'I03A')==true))then
return true
endif
return false
endfunction
function Trig_Claw_of_Nzoth_Conditions takes nothing returns boolean
if(not Trig_Claw_of_Nzoth_Func001C())then
return false
endif
return true
endfunction
function Trig_Claw_of_Nzoth_Func002Func001002001 takes nothing returns boolean
return(GetFilterPlayer()!=GetOwningPlayer(udg_Agi_Str_Int[1]))
endfunction
