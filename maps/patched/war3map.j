function sa__StatisticRow_calculatePercRealTime takes nothing returns boolean
local integer this=f__arg_this
local real total=s___StatisticRow_values[s__StatisticRow_values[this]]+s___StatisticRow_values[s__StatisticRow_values[this]+1]+s___StatisticRow_values[s__StatisticRow_values[this]+2]
local integer index=0
if total<=0 then
loop
exitwhen index>=3
set s___StatisticRow_percs[s__StatisticRow_percs[this]+index]=0
set index=index+1
endloop
endif
loop
exitwhen index>=3
set s___StatisticRow_percs[s__StatisticRow_percs[this]+index]=s___StatisticRow_values[s__StatisticRow_values[this]+index]/ total*100
set index=index+1
endloop
return true
endfunction
function sa__StatisticRow_updateUi takes nothing returns boolean
local integer this=f__arg_this
local integer playerNumber=GetPlayerId(GetLocalPlayer())
local integer maxValueForPlayer
local integer offsetIndex=s__StatisticDashboard___selectedSnapshot[playerNumber]*3
local integer maxIndex=maxBetweenThreeValues(s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex],s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+1],s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+2])
local string prefixText=""
local integer loopA=0
loop
exitwhen loopA>=3
if loopA==maxIndex then
set prefixText=("|cffffcc00")
else
set prefixText=""
endif
if s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+loopA]==0 then
call BlzFrameSetText(s___StatisticRow_valueFrames[s__StatisticRow_valueFrames[this]+loopA],"-")
else
call BlzFrameSetText(s___StatisticRow_valueFrames[s__StatisticRow_valueFrames[this]+loopA],prefixText+GetSpacedNumber(s___StatisticRow_values[s__StatisticRow_values[this]+offsetIndex+loopA])+" ("+I2S(R2I(s___StatisticRow_percs[s__StatisticRow_percs[this]+offsetIndex+loopA]))+"%)")
endif
set loopA=loopA+1
endloop
return true
endfunction
