call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Teleport_Boss),"Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call SetUnitPositionLoc(GetEnteringUnit(),GetRectCenter(gg_rct_Kergaloth_Chamber_Exit))
set udg_Ping_Point=GetUnitLoc(GetTriggerUnit())
call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()),udg_Ping_Point,0)
call RemoveLocation(udg_Ping_Point)
call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_Kergaloth_Chamber_Exit),"Abilities\\Spells\\NightElf\\Blink\\BlinkCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
set udg_GenericPlayerGroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
call QuestMessageBJ(udg_GenericPlayerGroup,bj_QUESTMESSAGE_ALWAYSHINT,"TRIGSTR_1278")
call DestroyForce(udg_GenericPlayerGroup)
endif
endfunction
