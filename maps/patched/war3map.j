function createHeroButton takes integer index returns framehandle
local framehandle heroButton=BlzCreateSimpleFrame("ParentFrame",BlzGetOriginFrame(ORIGIN_FRAME_SIMPLE_UI_PARENT,0),index)
call BlzFrameSetAllPoints(heroButton,BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2))
call BlzFrameSetVisible(heroButton,false)
return heroButton
endfunction
function createBackpackButton takes integer index,framehandle heroButtonBase returns nothing
local framehandle backpackButton
if(index==0)then
return
endif
set backpackButton=BlzCreateSimpleFrame("BackpackButton",heroButtonBase,index)
call BlzTriggerRegisterFrameEvent(gg_trg_On_Press_Backpack_Button_Event,backpackButton,FRAMEEVENT_CONTROL_CLICK)
call BlzFrameSetTexture(BlzGetFrameByName("BackpackButtonIcon",index),"ReplaceableTextures\\CommandButtons\\BTNDustOfAppearance.blp",0,true)
call BlzFrameSetSize(backpackButton,(0.024),(0.024))
call BlzFrameSetPoint(backpackButton,FRAMEPOINT_TOPLEFT,heroButtonBase,FRAMEPOINT_TOPRIGHT,0,0)
endfunction
function createHpBar takes integer index,framehandle base returns nothing
local integer offset=index*2
local framehandle heroIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2)
local framehandle bar=BlzCreateSimpleFrame("HpMpBar",base,offset)
local framehandle barBorder=BlzGetFrameByName("HpMpBarBorder",offset)
call BlzFrameSetSize(bar,(0.04),(0.00975))
call BlzFrameSetScale(BlzGetFrameByName("HpMpBarText",offset),0.7)
call BlzFrameSetTexture(bar,"ui_statusbar_fill.blp",0,true)
call BlzFrameSetTexture(barBorder,"ui_statusbar_border.blp",0,true)
call BlzFrameSetVertexColor(bar,BlzConvertColor(255,0,200,0))
call BlzFrameSetPoint(bar,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_BOTTOMLEFT,0,0)
call BlzFrameSetPoint(bar,FRAMEPOINT_TOPRIGHT,heroIcon,FRAMEPOINT_BOTTOMRIGHT,0,0)
endfunction
function createMpBar takes integer index,framehandle base returns nothing
local integer offset=index*2+1
local framehandle heroIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2)
local framehandle bar=BlzCreateSimpleFrame("HpMpBar",base,offset)
local framehandle barBorder=BlzGetFrameByName("HpMpBarBorder",offset)
call BlzFrameSetSize(bar,(0.04),(0.00975))
call BlzFrameSetScale(BlzGetFrameByName("HpMpBarText",offset),0.7)
call BlzFrameSetTexture(bar,"ui_statusbar_fill.blp",0,true)
call BlzFrameSetTexture(barBorder,"ui_statusbar_border.blp",0,true)
call BlzFrameSetVertexColor(bar,BlzConvertColor(255,0,140,255))
call BlzFrameSetPoint(bar,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_BOTTOMLEFT,0,-(0.00975))
call BlzFrameSetPoint(bar,FRAMEPOINT_TOPRIGHT,heroIcon,FRAMEPOINT_BOTTOMRIGHT,0,-(0.00975))
endfunction
function adjustIdleWorkerIcon takes nothing returns nothing
local framehandle idleWorkerContainer=BlzFrameGetChild(BlzGetFrameByName("ConsoleBottomBar",0),3)
local framehandle idleWorkerIcon=BlzFrameGetChild(idleWorkerContainer,0)
call BlzFrameClearAllPoints(idleWorkerContainer)
call BlzFrameSetSize(idleWorkerContainer,(0.024),(0.024))
call BlzFrameSetAllPoints(idleWorkerIcon,idleWorkerContainer)
call BlzFrameSetAbsPoint(idleWorkerContainer,(FRAMEPOINT_TOPLEFT),(-0.0179),(0.144))
endfunction
function createItemIcons takes integer index,framehandle base returns nothing
local integer count=0
local framehandle itemIcon
local framehandle heroIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2)
local framehandle backpackIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2+1)
loop
set itemIcon=BlzCreateSimpleFrame("HeroPanelItem",base,index*6+count)
call BlzFrameSetSize(itemIcon,(0.012),(0.012))
call BlzFrameSetPoint(itemIcon,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_TOPRIGHT,(0.012)*(ModuloInteger(count,2)),-(0.012)*(count/ 2)-(0.024))
call BlzFrameSetTexture(itemIcon,"ReplaceableTextures\\CommandButtons\\PASHuman-inventory-slotfiller.blp",0,true)
set count=count+1
exitwhen count==6
endloop
endfunction
function adjustHeroIcon takes integer index returns nothing
local framehandle heroIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2)
local framehandle backpackIcon=BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON,index*2+1)
local framehandle anchorFrame=(BlzGetOriginFrame(ORIGIN_FRAME_MINIMAP,0))
local framehandle hpBar=BlzGetOriginFrame(ORIGIN_FRAME_HERO_HP_BAR,index*2)
local framehandle mpBar=BlzGetOriginFrame(ORIGIN_FRAME_HERO_MANA_BAR,index*2)
local framehandle backpackHpBar=BlzGetOriginFrame(ORIGIN_FRAME_HERO_HP_BAR,index*2+1)
local framehandle backpackMpBar=BlzGetOriginFrame(ORIGIN_FRAME_HERO_MANA_BAR,index*2+1)
call BlzFrameClearAllPoints(heroIcon)
call BlzFrameClearAllPoints(backpackIcon)
call BlzFrameClearAllPoints(hpBar)
call BlzFrameClearAllPoints(mpBar)
call BlzFrameClearAllPoints(backpackHpBar)
call BlzFrameClearAllPoints(backpackMpBar)
call BlzFrameSetSize(heroIcon,(0.04),(0.04))
call BlzFrameSetSize(backpackIcon,(0.024),(0.024))
call BlzFrameSetAbsPoint(hpBar,FRAMEPOINT_CENTER,10,10)
call BlzFrameSetAbsPoint(mpBar,FRAMEPOINT_CENTER,10,10)
call BlzFrameSetAbsPoint(backpackHpBar,FRAMEPOINT_CENTER,10,10)
call BlzFrameSetAbsPoint(backpackMpBar,FRAMEPOINT_CENTER,10,10)
call BlzFrameSetAllPoints(BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON_INDICATOR,index*2),heroIcon)
call BlzFrameSetAllPoints(BlzGetOriginFrame(ORIGIN_FRAME_HERO_BUTTON_INDICATOR,index*2+1),backpackIcon)
call BlzTriggerRegisterFrameEvent(gg_trg_On_Press_Backpack_Button_Event,backpackIcon,FRAMEEVENT_CONTROL_CLICK)
call BlzFrameSetPoint(heroIcon,(FRAMEPOINT_BOTTOMLEFT),anchorFrame,(FRAMEPOINT_TOPLEFT),(-((0.04)+(0.024))/ 2)+((0.04)+(0.024)+0.007)*index,(((0.00975)+(0.00975))+0.018))
if(index==0)then
call BlzFrameSetPoint(backpackIcon,FRAMEPOINT_TOPLEFT,heroIcon,FRAMEPOINT_TOPRIGHT,0,0)
else
call BlzFrameSetAbsPoint(backpackIcon,FRAMEPOINT_CENTER,10,10)
endif
endfunction
function createHeroPanel takes integer index returns nothing
local framehandle base=createHeroButton(index)
call adjustHeroIcon(index)
call createItemIcons(index,base)
call createHpBar(index,base)
call createMpBar(index,base)
call createBackpackButton(index,base)
endfunction
function Trig_Create_Teammate_Hero_Info_Actions takes nothing returns nothing
local integer index=0
call BlzFrameSetVisible(BlzGetOriginFrame(ORIGIN_FRAME_HERO_BAR,0),true)
call BlzEnableUIAutoPosition(false)
call SetReservedLocalHeroButtons(2)
call adjustIdleWorkerIcon()
loop
call createHeroPanel(index)
set index=index+1
exitwhen index==udg_HeroPanel_Amount
endloop
endfunction
function onLoadHeroPanel takes nothing returns nothing
local player lp=GetLocalPlayer()
local integer playerIndex=1
local integer heroIndex
local integer base
loop
exitwhen playerIndex>3
set base=playerIndex*udg_HeroPanel_Amount
set heroIndex=0
loop
exitwhen heroIndex>udg_HeroPanel_Amount-1
if udg_HeroPanel_Heroes[base+heroIndex]!=null then
if lp==ConvertedPlayer(playerIndex)then
call BlzFrameSetVisible(BlzGetFrameByName("ParentFrame",heroIndex),true)
endif
endif
set heroIndex=heroIndex+1
endloop
set playerIndex=playerIndex+1
endloop
set lp=null
endfunction
