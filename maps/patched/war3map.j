function Trig_Hearthstone_Actions takes nothing returns nothing
if(Trig_Hearthstone_Func001C())then
set udg_GenericPlayerGroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
call QuestMessageBJ(udg_GenericPlayerGroup,bj_QUESTMESSAGE_WARNING,"TRIGSTR_1096")
call DestroyForce(udg_GenericPlayerGroup)
set udg_Generic_ResetAbility=GetSpellAbilityId()
set udg_Generic_ResetUnit=GetTriggerUnit()
if(Trig_Hearthstone_Func001Func006C())then
set udg_Generic_ResetLevel=GetUnitAbilityLevelSwapped(udg_Generic_ResetAbility,udg_Generic_ResetUnit)
call UnitRemoveAbilityBJ(udg_Generic_ResetAbility,udg_Generic_ResetUnit)
call UnitAddAbilityBJ(udg_Generic_ResetAbility,udg_Generic_ResetUnit)
call SetUnitAbilityLevelSwapped(udg_Generic_ResetAbility,udg_Generic_ResetUnit,udg_Generic_ResetLevel)
else
endif
else
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
call AddSpecialEffectLocBJ(udg_Generic_Point,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Generic_Point)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_ResStones_Total
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_Hearthstone_Func001Func011Func001C())then
set udg_Generic_Point=GetUnitLoc(udg_ResStone[GetForLoopIndexA()])
if(Trig_Hearthstone_Func001Func011Func001Func002C())then
call SetUnitPositionLoc(udg_Agi_Str_Int[1],udg_Generic_Point)
else
if(Trig_Hearthstone_Func001Func011Func001Func002Func001C())then
call SetUnitPositionLoc(udg_Agi_Str_Int[2],udg_Generic_Point)
else
if(Trig_Hearthstone_Func001Func011Func001Func002Func001Func001C())then
call SetUnitPositionLoc(udg_Agi_Str_Int[3],udg_Generic_Point)
else
endif
endif
endif
call PanCameraToTimedLocForPlayer(GetOwningPlayer(GetTriggerUnit()),udg_Generic_Point,0.00)
call SelectUnitForPlayerSingle(GroupPickRandomUnit(GetUnitsOfPlayerMatching(GetOwningPlayer(GetTriggerUnit()),Condition(function Trig_Hearthstone_Func001Func011Func001Func004001001002))),GetOwningPlayer(GetTriggerUnit()))
call AddSpecialEffectLocBJ(udg_Generic_Point,"Abilities\\Spells\\Human\\MassTeleport\\MassTeleportCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Generic_Point)
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endif
endfunction
