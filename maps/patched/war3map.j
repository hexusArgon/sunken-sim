else
if(Trig_DCS_Core_Func009Func003Func001C())then
set udg_DCS_TotalPrimAttributeCount=GetHeroStatBJ(bj_HEROSTAT_AGI,udg_DCS_Unit,true)
else
if(Trig_DCS_Core_Func009Func003Func001Func002C())then
set udg_DCS_TotalPrimAttributeCount=GetHeroStatBJ(bj_HEROSTAT_INT,udg_DCS_Unit,true)
else
endif
endif
endif
set udg_DCS_DamagePlusAtt=(udg_DCS_Damage+(I2R(udg_DCS_TotalPrimAttributeCount)*udg_DCS_AttackBonusFromAttribute))
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=6
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set udg_DCS_CarriedItem=UnitItemInSlotBJ(udg_DCS_Unit,GetForLoopIndexA())
set udg_DCS_ItemInt=GetItemTypeId(udg_DCS_CarriedItem)
set udg_DCS_ItemDamageBonus=LoadIntegerBJ(StringHashBJ("ItemDamageBonus"),udg_DCS_ItemInt,udg_DCS_Hash)
