native UnitAlive takes unit u returns boolean
native GetUnitGoldCost takes integer rawCode returns integer
native GetUnitWoodCost takes integer rawCode returns integer
function HP_PidOf takes unit u returns integer
if u==null then
return 0
endif
return GetConvertedPlayerId(GetOwningPlayer(u))
endfunction
function HP_SlotOf takes unit u returns integer
if u==null then
return 0
endif
if udg_Agi_Str_Int[1]==u then
return 1
elseif udg_Agi_Str_Int[2]==u then
return 2
elseif udg_Agi_Str_Int[3]==u then
return 3
endif
return 0
endfunction
function HP_FindSlot takes integer nat returns integer
local integer i=1
if udg_Agi_Str_Int[nat]==null then
return nat
endif
loop
exitwhen i>3
if udg_Agi_Str_Int[i]==null then
return i
endif
set i=i+1
endloop
return 0
endfunction
function HP_EnableTalentSelect takes integer s returns nothing
if s==1 then
call EnableTrigger(gg_trg_Talent_Select_1)
elseif s==2 then
call EnableTrigger(gg_trg_Talent_Select_2)
elseif s==3 then
call EnableTrigger(gg_trg_Talent_Select_3)
endif
endfunction
function HP_FlatAdd takes integer s,integer k,real v returns nothing
if s==1 then
set udg_CDR_Flat_Agi[k]=udg_CDR_Flat_Agi[k]+v
elseif s==2 then
set udg_CDR_Flat_Str[k]=udg_CDR_Flat_Str[k]+v
elseif s==3 then
set udg_CDR_Flat_Int[k]=udg_CDR_Flat_Int[k]+v
endif
endfunction
function HP_ClassTaken takes integer t returns boolean
if t=='E005' then
return udg_Hero_Rogue!=null
elseif t=='H001' then
return udg_Hero_Hunter!=null
elseif t=='O00Y' then
return udg_Hero_Windmaster!=null
elseif t=='O00R' then
return udg_Hero_FeralDruid!=null
elseif t=='O005' then
return udg_Hero_Berserker!=null
elseif t=='E00A' then
return udg_Hero_DemonHunter!=null
elseif t=='N03T' then
return udg_Hero_Siren!=null
elseif t=='O00F' then
return udg_Hero_Warrior!=null
elseif t=='H000' then
return udg_Hero_Paladin!=null
elseif t=='U002' then
return udg_Hero_DeathKnight!=null
elseif t=='N04R' then
return udg_Hero_Monk!=null
elseif t=='H01H' then
return udg_Hero_Tidewarrior!=null
elseif t=='O00P' then
return udg_Hero_DragonSentinel!=null
elseif t=='N03Y' then
return udg_Hero_Tinker!=null
elseif t=='O000' then
return udg_Hero_Shaman!=null
elseif t=='E000' then
return udg_Hero_Druid!=null
elseif t=='O009' then
return udg_Hero_Priest!=null
elseif t=='O00G' then
return udg_Hero_Mage!=null
elseif t=='O00H' then
return udg_Hero_Necromancer!=null
elseif t=='O00A' then
return udg_Hero_Warlock!=null
elseif t=='O00N' then
return udg_Hero_WitchDoctor!=null
endif
return false
endfunction
function HP_RandomFree takes integer attr returns integer
local integer i=0
local integer t=0
loop
exitwhen i>40
if attr==1 then
set t=udg_Random_Agi[GetRandomInt(1,7)]
elseif attr==2 then
set t=udg_Random_Str[GetRandomInt(1,7)]
else
set t=udg_Random_Int[GetRandomInt(1,7)]
endif
if not HP_ClassTaken(t) then
return t
endif
set i=i+1
endloop
return t
endfunction
