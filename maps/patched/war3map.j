function FixQuestDialog takes nothing returns nothing
call BlzFrameClick(BlzGetFrameByName("UpperButtonBarQuestsButton",0))
call ForceUICancel()
call BlzFrameSetPoint(BlzGetFrameByName("QuestDisplay",0),FRAMEPOINT_TOPLEFT,BlzGetFrameByName("QuestDetailsTitle",0),FRAMEPOINT_BOTTOMLEFT,0.003,-0.003)
call BlzFrameSetPoint(BlzGetFrameByName("QuestDisplay",0),FRAMEPOINT_BOTTOMRIGHT,BlzGetFrameByName("QuestDisplayBackdrop",0),FRAMEPOINT_BOTTOMRIGHT,-0.003,0.)
call BlzFrameSetPoint(BlzGetFrameByName("QuestDisplayBackdrop",0),FRAMEPOINT_BOTTOM,BlzGetFrameByName("QuestBackdrop",0),FRAMEPOINT_BOTTOM,0.,0.017)
call BlzFrameClearAllPoints(BlzGetFrameByName("QuestAcceptButton",0))
call BlzFrameSetPoint(BlzGetFrameByName("QuestAcceptButton",0),FRAMEPOINT_TOPLEFT,BlzGetFrameByName("QuestBackdrop",0),FRAMEPOINT_TOPLEFT,0.016,-0.016)
call BlzFrameSetText(BlzGetFrameByName("QuestAcceptButton",0),"X")
call BlzFrameSetSize(BlzGetFrameByName("QuestAcceptButton",0),0.03,0.03)
endfunction
function CalculateArmorPenetration takes real damageAmount returns nothing
local real targetArmor=BlzGetUnitArmor(udg_DamageEventTarget)
local real remaingArmor=(targetArmor-udg_ArmorPenetration[GetConvertedPlayerId(GetOwningPlayer(udg_DamageEventSource))])
if(targetArmor!=0.00)then
if(targetArmor>0.00)then
set udg_DamageEventAmount=(udg_DamageEventAmount/(1-((targetArmor*udg_ArmorDRMultiplier)/(1+(udg_ArmorDRMultiplier*targetArmor)))))
else
set udg_DamageEventAmount=(udg_DamageEventAmount/(2.00-Pow((1-udg_ArmorDRMultiplier),(-1.00*targetArmor))))
endif
endif
if(remaingArmor!=0.00)then
if(remaingArmor>0.00)then
set udg_DamageEventAmount=(udg_DamageEventAmount*(1-((remaingArmor*udg_ArmorDRMultiplier)/(1+(udg_ArmorDRMultiplier*remaingArmor)))))
else
set udg_DamageEventAmount=(udg_DamageEventAmount*(2.00-Pow((1-udg_ArmorDRMultiplier),(-1.00*remaingArmor))))
endif
endif
endfunction
function ConsumablesTtp takes integer playerNumber returns nothing
local string consumablesTtp
local integer array consumablesAbility
set consumablesAbility[1]='A0LM'
set consumablesAbility[2]='A0N3'
set consumablesAbility[3]='A0N4'
set consumablesTtp="Provides a summary of all acquired consumable items. Does not account for purchased consumables.|n|n"
if udg_Consumables_Gold[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Gold from Coins: |cffffcc00"+I2S(udg_Consumables_Gold[playerNumber])+"|r|n"
endif
if udg_Consumables_ManualsHealth[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Manuals of Health: |cffffda00"+I2S(udg_Consumables_ManualsHealth[playerNumber])+"|r|n"
endif
if udg_Consumables_ManualsMana[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Manuals of Mana: |cffffda00"+I2S(udg_Consumables_ManualsMana[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesAgility[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Agility from Tomes: |cffffda00"+I2S(udg_Consumables_TomesAgility[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesStrength[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Strength from Tomes: |cffffda00"+I2S(udg_Consumables_TomesStrength[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesIntelligence[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Intelligence from Tomes: |cffffda00"+I2S(udg_Consumables_TomesIntelligence[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesExpertise[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- Expertise Tomes: |cffffda00"+I2S(udg_Consumables_TomesExpertise[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesKnowledge[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- |c0040da00Tomes of Knowledge|r: |cffffda00"+I2S(udg_Consumables_TomesKnowledge[playerNumber])+"|r|n"
endif
if udg_Consumables_TomesDemonic[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- |c001e53c9Tomes of Demonic Knowledge|r: |cffffda00"+I2S(udg_Consumables_TomesDemonic[playerNumber])+"|r"
endif
if udg_Consumables_TreasureBags[playerNumber]>0 then
set consumablesTtp=consumablesTtp+"- |c001e53c9Treasure Bags Used|r: |cffffda00"+I2S(udg_Consumables_TreasureBags[playerNumber])+"|r"
endif
call BlzSetAbilityExtendedTooltip(consumablesAbility[playerNumber],consumablesTtp,0)
endfunction
function ApocalypseBase takes unit target returns nothing
if(GetUnitAbilityLevelSwapped('A05W',target)==0)then
call UnitAddAbilityBJ('A05W',target)
call GroupAddUnitSimple(target,udg_Apocalypse_Group)
else
endif
endfunction
function HasForbiddenSeal takes unit unitWielder returns boolean
local integer sealBase='I056'
local integer sealPotency='I04K'
local integer sealHaste='I04G'
local integer sealArmor='I04B'
local integer sealAttackSpeed='I06U'
local integer sealLuck='I0A5'
local integer mindAmplifier='I0IC'
if(UnitHasItemOfTypeBJ(unitWielder,sealBase))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,sealPotency))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,sealHaste))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,sealArmor))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,sealAttackSpeed))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,sealLuck))then
return true
endif
if(UnitHasItemOfTypeBJ(unitWielder,mindAmplifier))then
return true
endif
return false
endfunction
function ForbiddenSealAcquire takes unit unitWielder returns nothing
local item sealAcquiredItem=GetManipulatedItem()
local boolean hasForbiddenSeal
local integer forbiddenSealLoop
local integer talentsLevel
local integer bonusLevel=1
set forbiddenSealLoop=1
loop
exitwhen forbiddenSealLoop>3
if(unitWielder==udg_Agi_Str_Int[forbiddenSealLoop])then
set talentsLevel=IMaxBJ(IMinBJ((GetUnitLevel(udg_Agi_Str_Int[forbiddenSealLoop])/ 2),3),1)
call SetUnitAbilityLevelSwapped('A0BE',udg_Talents_Unit[forbiddenSealLoop],talentsLevel+bonusLevel)
endif
set forbiddenSealLoop=forbiddenSealLoop+1
endloop
call UnitAddItemSwapped(sealAcquiredItem,unitWielder)
endfunction
function ForbiddenSealLose takes unit unitWielder returns nothing
local integer forbiddenSealLoop
local integer inventoryLevel
local integer talentsLevel
local boolean hasForbiddenSeal
call PolledWait(0.01)
set hasForbiddenSeal=HasForbiddenSeal(unitWielder)
if(hasForbiddenSeal==false)then
set forbiddenSealLoop=1
loop
exitwhen forbiddenSealLoop>3
if(unitWielder==udg_Agi_Str_Int[forbiddenSealLoop])then
set inventoryLevel=GetUnitAbilityLevelSwapped('A0BE',udg_Talents_Unit[forbiddenSealLoop])
call RemoveItem(UnitItemInSlotBJ(udg_Talents_Unit[forbiddenSealLoop],inventoryLevel))
call MultiboardSetItemIconBJ(udg_Main_Board,(inventoryLevel+6),(GetConvertedPlayerId(GetOwningPlayer(unitWielder))+2),"ReplaceableTextures\\WorldEditUI\\DoodadPlaceholder.blp")
set talentsLevel=IMaxBJ(IMinBJ((GetUnitLevel(udg_Agi_Str_Int[forbiddenSealLoop])/ 2),3),1)
call SetUnitAbilityLevelSwapped('A0BE',udg_Talents_Unit[forbiddenSealLoop],talentsLevel)
endif
set forbiddenSealLoop=forbiddenSealLoop+1
endloop
endif
endfunction
