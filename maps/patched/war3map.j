function createChallengePanel takes nothing returns nothing
local framehandle panel=BlzCreateSimpleFrame(udg_UI_ChallengePanel_Name,BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI,0),0)
local framehandle panelBackground=BlzGetFrameByName(udg_UI_ChallengePanel_BGName,0)
local framehandle panelTitleBackground=BlzGetFrameByName(udg_UI_ChallengeTitle_BGName,0)
local framehandle panelValueText=BlzGetFrameByName(udg_UI_ChallengeValue_Name,0)
local framehandle panelTitleContainer=BlzGetFrameByName(udg_UI_ChallengeTitle_FrameName,0)
call BlzFrameSetSize(panel,udg_UI_ChallengePanel_Width,udg_UI_ChallengePanel_Height)
call BlzFrameSetTexture(panelBackground,udg_UI_ChallengePanel_Texture,0,true)
call BlzFrameSetSize(panelTitleContainer,udg_UI_ChallengeTitle_Width,udg_UI_ChallengeTitle_Height)
call BlzFrameSetTexture(panelTitleBackground,udg_UI_ChallengeTitle_Texture,0,true)
call BlzFrameSetPoint(panelValueText,FRAMEPOINT_TOP,panelTitleContainer,FRAMEPOINT_BOTTOM,0,udg_UI_ChallengeValue_Distance)
call BlzFrameSetVisible(panel,false)
endfunction
