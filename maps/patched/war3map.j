function InitTrig_Select_Str_Hero takes nothing returns nothing
set gg_trg_Select_Str_Hero=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Select_Str_Hero,EVENT_PLAYER_UNIT_SELL)
call TriggerAddCondition(gg_trg_Select_Str_Hero,Condition(function Trig_Select_Str_Hero_Conditions))
call TriggerAddAction(gg_trg_Select_Str_Hero,function Trig_Select_Str_Hero_Actions)
endfunction
function Trig_Select_Int_Hero_Conditions takes nothing returns boolean
if(not(GetUnitTypeId(GetSellingUnit())=='n01L'))then
return false
endif
return true
endfunction
function Trig_Select_Int_Hero_Func028C takes nothing returns boolean
if(not(udg_Difficulty_Chosen=="Insane"))then
return false
endif
return true
endfunction
