call BlzSetAbilityIntegerLevelFieldBJ(BlzGetUnitAbility(udg_Hero_Mage,'A0NZ'),ABILITY_ILF_MANA_COST,(udg_ArcaneBlast_Level-1),R2I((I2R(udg_ArcaneBlast_Mana)*1.00)))
