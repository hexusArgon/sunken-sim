function Trig_Windstorm_Actions takes nothing returns nothing
if(Trig_Windstorm_Func001C())then
set udg_Windstorm_Frequency=0.50
set udg_Windstorm_BonusTickRate=1.00
if(Trig_Windstorm_Func001Func003C())then
set udg_Windstorm_BonusTickRate=(udg_Windstorm_BonusTickRate+(0.25*udg_AttackSpeed_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Windmaster))]))
else
endif
if(Trig_Windstorm_Func001Func004C())then
set udg_Windstorm_BonusTickRate=(udg_Windstorm_BonusTickRate+(0.10+((0.03/ 5.00)*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Windmaster))]))))
else
endif
if(Trig_Windstorm_Func001Func005C())then
set udg_Windstorm_BonusTickRate=(udg_Windstorm_BonusTickRate+udg_CDR[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Windmaster))])
else
endif
if(Trig_Windstorm_Func001Func006C())then
set udg_Windstorm_BonusTickRate=(udg_Windstorm_BonusTickRate+0.20)
else
endif
call StartTimerBJ(udg_Windstorm_Timer,true,(udg_Windstorm_Frequency/ udg_Windstorm_BonusTickRate))
call SetPlayerAbilityAvailableBJ(false,'A0KT',GetOwningPlayer(udg_Hero_Windmaster))
call SetPlayerAbilityAvailableBJ(false,'A01T',GetOwningPlayer(udg_Hero_Windmaster))
else
endif
if(Trig_Windstorm_Func002C())then
call PauseTimerBJ(true,udg_Windstorm_Timer)
call SetPlayerAbilityAvailableBJ(true,'A0KT',GetOwningPlayer(udg_Hero_Windmaster))
call SetPlayerAbilityAvailableBJ(true,'A01T',GetOwningPlayer(udg_Hero_Windmaster))
else
endif
endfunction
