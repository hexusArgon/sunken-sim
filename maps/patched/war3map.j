endfunction
function Trig_ItemshopGUI_Shop_Actions takes nothing returns nothing
set udg_TasItemShop_Unit='h015'
set udg_TasItemShop_Gold=1.00
set udg_TasItemShop_Lumber=1.00
call TriggerExecute(udg_TasItemShopCreateShop)
endfunction
function InitTrig_ItemshopGUI_Shop takes nothing returns nothing
set gg_trg_ItemshopGUI_Shop=CreateTrigger()
call TriggerAddAction(gg_trg_ItemshopGUI_Shop,function Trig_ItemshopGUI_Shop_Actions)
endfunction
function Trig_ItemshopGUI_Init_Actions takes nothing returns nothing
call ConditionalTriggerExecute(gg_trg_ItemshopGUI_Init_Categories)
call ConditionalTriggerExecute(gg_trg_ItemshopGUI_Init_Recipes)
call ConditionalTriggerExecute(gg_trg_ItemshopGUI_Shop)
call ConditionalTriggerExecute(gg_trg_ItemshopGUI_Init_Items_1)
call ConditionalTriggerExecute(gg_trg_ItemshopGUI_Init_Items_2)
endfunction
function InitTrig_ItemshopGUI_Init takes nothing returns nothing
set gg_trg_ItemshopGUI_Init=CreateTrigger()
call TriggerAddAction(gg_trg_ItemshopGUI_Init,function Trig_ItemshopGUI_Init_Actions)
endfunction
function Trig_Exploit_1_Fix_Actions takes nothing returns nothing
call TasItemShopUIShow(Player(0),null,null,null)
call TasItemShopUIShow(Player(1),null,null,null)
call TasItemShopUIShow(Player(2),null,null,null)
call ClearSelectionForPlayer(Player(0))
call ClearSelectionForPlayer(Player(1))
call ClearSelectionForPlayer(Player(2))
endfunction
function InitTrig_Exploit_1_Fix takes nothing returns nothing
set gg_trg_Exploit_1_Fix=CreateTrigger()
call TriggerRegisterPlayerAllianceChange(gg_trg_Exploit_1_Fix,Player(0),ALLIANCE_SHARED_CONTROL)
call TriggerRegisterPlayerAllianceChange(gg_trg_Exploit_1_Fix,Player(1),ALLIANCE_SHARED_CONTROL)
call TriggerRegisterPlayerAllianceChange(gg_trg_Exploit_1_Fix,Player(2),ALLIANCE_SHARED_CONTROL)
call TriggerAddAction(gg_trg_Exploit_1_Fix,function Trig_Exploit_1_Fix_Actions)
endfunction
function Trig_Exploit_2_Fix_Func001C takes nothing returns boolean
if((GetUnitTypeId(GetTriggerUnit())=='h015'))then
return true
endif
if((GetUnitTypeId(GetTriggerUnit())=='h028'))then
return true
endif
if((GetUnitTypeId(GetTriggerUnit())=='E00I'))then
return true
endif
return false
endfunction
function Trig_Exploit_2_Fix_Conditions takes nothing returns boolean
if(not Trig_Exploit_2_Fix_Func001C())then
return false
endif
return true
endfunction
function Trig_Exploit_2_Fix_Func003Func001Func001C takes nothing returns boolean
if(not(GetPlayerSlotState(ConvertedPlayer(udg_PlayerIndex))==PLAYER_SLOT_STATE_PLAYING))then
return false
endif
return true
endfunction
function Trig_Exploit_2_Fix_Actions takes nothing returns nothing
call DisableTrigger(gg_trg_Exploit_1_Fix)
set udg_PlayerIndex=1
loop
exitwhen udg_PlayerIndex>3
set udg_SharedUnits_Loop=1
loop
exitwhen udg_SharedUnits_Loop>3
if(Trig_Exploit_2_Fix_Func003Func001Func001C())then
call SetPlayerAllianceBJ(ConvertedPlayer(udg_PlayerIndex),ALLIANCE_SHARED_CONTROL,false,ConvertedPlayer(udg_SharedUnits_Loop))
else
endif
set udg_SharedUnits_Loop=udg_SharedUnits_Loop+1
endloop
set udg_PlayerIndex=udg_PlayerIndex+1
endloop
call EnableTrigger(gg_trg_Exploit_1_Fix)
endfunction
function InitTrig_Exploit_2_Fix takes nothing returns nothing
set gg_trg_Exploit_2_Fix=CreateTrigger()
call TriggerRegisterPlayerSelectionEventBJ(gg_trg_Exploit_2_Fix,Player(0),true)
call TriggerRegisterPlayerSelectionEventBJ(gg_trg_Exploit_2_Fix,Player(1),true)
call TriggerRegisterPlayerSelectionEventBJ(gg_trg_Exploit_2_Fix,Player(2),true)
call TriggerAddCondition(gg_trg_Exploit_2_Fix,Condition(function Trig_Exploit_2_Fix_Conditions))
call TriggerAddAction(gg_trg_Exploit_2_Fix,function Trig_Exploit_2_Fix_Actions)
endfunction
function Trig_Recipes_Other_Func002C takes nothing returns boolean
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I06X')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I0I0')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I081')==true))then
return false
endif
return true
endfunction
function Trig_Recipes_Other_Func004C takes nothing returns boolean
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I04Z')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I0C7')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I0C8')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'azhr')==true))then
return false
endif
if(not(UnitHasItemOfTypeBJ(GetTriggerUnit(),'I0FV')==true))then
return false
endif
return true
endfunction
function Trig_Recipes_Other_Actions takes nothing returns nothing
if(Trig_Recipes_Other_Func002C())then
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I081'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I0I0'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I06X'))
call UnitAddItemByIdSwapped('I080',GetTriggerUnit())
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
endif
if(Trig_Recipes_Other_Func004C())then
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I0C7'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I04Z'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I0C8'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'azhr'))
call RemoveItem(GetItemOfTypeFromUnitBJ(GetTriggerUnit(),'I0FV'))
call UnitAddItemByIdSwapped('I0AD',GetTriggerUnit())
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
endif
endfunction
function InitTrig_Recipes_Other takes nothing returns nothing
set gg_trg_Recipes_Other=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Recipes_Other,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddAction(gg_trg_Recipes_Other,function Trig_Recipes_Other_Actions)
endfunction
function Trig_Shop_Restricted_Items_Func003C takes nothing returns boolean
if((GetItemType(GetManipulatedItem())==ITEM_TYPE_CAMPAIGN))then
return true
endif
if((GetItemLevel(GetManipulatedItem())==10))then
return true
endif
return false
endfunction
function Trig_Shop_Restricted_Items_Conditions takes nothing returns boolean
if(not Trig_Shop_Restricted_Items_Func003C())then
return false
endif
return true
endfunction
function Trig_Shop_Restricted_Items_Actions takes nothing returns nothing
call SetItemPlayerBJ(GetManipulatedItem(),Player(3),false)
endfunction
function InitTrig_Shop_Restricted_Items takes nothing returns nothing
set gg_trg_Shop_Restricted_Items=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Shop_Restricted_Items,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(gg_trg_Shop_Restricted_Items,Condition(function Trig_Shop_Restricted_Items_Conditions))
call TriggerAddAction(gg_trg_Shop_Restricted_Items,function Trig_Shop_Restricted_Items_Actions)
endfunction
function Trig_Class_Restrictions_Func003Func003Func001Func002C takes nothing returns boolean
if((GetTriggerUnit()==udg_Hero_Rogue))then
return true
endif
if((GetUnitTypeId(GetTriggerUnit())=='H00P'))then
return true
endif
