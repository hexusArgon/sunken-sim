function Trig_Windstorm_Damage_Func001Func003A takes nothing returns nothing
set udg_DCS_Unit=udg_Hero_Windmaster
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
if(Trig_Windstorm_Damage_Func001Func003Func008C())then
set udg_Windstorm_Loop=2
else
set udg_Windstorm_Loop=1
endif
set udg_Windstorm_Count=1
loop
exitwhen udg_Windstorm_Count>udg_Windstorm_Loop
set udg_WindstormDamage=((3.00+(7.00*I2R(GetUnitLevel(udg_Hero_Windmaster))))+(0.60*I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_Windmaster,true))))
if(Trig_Windstorm_Damage_Func001Func003Func009Func002C())then
set udg_PiercingGust_Proc=true
set udg_WindstormDamage=(udg_WindstormDamage+(0.20*udg_DCS_Damage))
else
set udg_PiercingGust_Proc=false
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func003C())then
set udg_WindstormDamage=(udg_WindstormDamage+(0.20*udg_DCS_Damage))
set udg_WindstormDamage=(udg_WindstormDamage*(1.05+((0.03/ 5.00)*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Windmaster))]))))
else
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func004C())then
set udg_WindstormDamage=(udg_WindstormDamage*2.00)
else
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func005C())then
set udg_WindstormDamage=(udg_WindstormDamage*1.12)
else
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func006C())then
set udg_WindstormDamage=(udg_WindstormDamage*1.40)
call UnitAddAbilityBJ('A08Q',udg_Caster_Dummy)
call IssueTargetOrderBJ(udg_Caster_Dummy,"faeriefire",udg_DamageEventTarget)
call UnitRemoveAbilityBJ('A08Q',udg_Caster_Dummy)
else
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func007C())then
set udg_NextDamageType=udg_DamageTypePhysical
else
endif
if(Trig_Windstorm_Damage_Func001Func003Func009Func008C())then
set udg_NextDamageIsAttack=true
call UnitDamageTargetBJ(udg_Hero_Windmaster,GetEnumUnit(),(udg_WindstormDamage*udg_Windstorm_Frequency),ATTACK_TYPE_PIERCE,DAMAGE_TYPE_NORMAL)
else
call UnitDamageTargetBJ(udg_Hero_Windmaster,GetEnumUnit(),(udg_WindstormDamage*udg_Windstorm_Frequency),ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endif
set udg_Windstorm_Count=udg_Windstorm_Count+1
endloop
endfunction
