set udg_CriticalStrike_RatingFlat[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=(udg_CriticalStrike_RatingFlat[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]+0.15)
