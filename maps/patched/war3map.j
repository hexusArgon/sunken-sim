if(not(udg_TalentGlyph_Player==GetOwningPlayer(udg_TalentGlyph_SelectedUnit)))then
return false
endif
if(not(udg_Combat_Boo[GetConvertedPlayerId(udg_TalentGlyph_Player)]==false))then
