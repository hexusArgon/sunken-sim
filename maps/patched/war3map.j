function Trig_Leaving_Actions takes nothing returns nothing
call DisplayTextToForce(GetPlayersAll(),("|c00eccf11"+(GetPlayerName(GetTriggerPlayer())+"|r has left the game!")))
set udg_Attribute_Index=1
loop
exitwhen udg_Attribute_Index>3
if(Trig_Leaving_Func002Func001C())then
set udg_Alliance_Loop=1
loop
exitwhen udg_Alliance_Loop>3
if(Trig_Leaving_Func002Func001Func001Func001C())then
call SetPlayerAllianceBJ(GetTriggerPlayer(),ALLIANCE_SHARED_CONTROL,true,GetOwningPlayer(udg_Agi_Str_Int[udg_Alliance_Loop]))
call SetPlayerAllianceBJ(GetTriggerPlayer(),ALLIANCE_SHARED_VISION,true,GetOwningPlayer(udg_Agi_Str_Int[udg_Alliance_Loop]))
else
endif
set udg_Alliance_Loop=udg_Alliance_Loop+1
endloop
call IssueImmediateOrderBJ(udg_BackpackUnit[udg_Attribute_Index],"roar")
else
endif
set udg_Attribute_Index=udg_Attribute_Index+1
endloop
endfunction
