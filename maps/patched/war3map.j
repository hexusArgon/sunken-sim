endfunction
function Trig_Explore_Ritual_Runes_Conditions takes nothing returns boolean
if(not(GetSpellAbilityId()=='A0H2'))then
return false
endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Func002Func001C takes nothing returns boolean
if(not(RectContainsLoc(gg_rct_Demonic_Rune_1,udg_Inspect_Point)==true))then
return false
endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Func002Func002C takes nothing returns boolean
if(not(RectContainsLoc(gg_rct_Demonic_Rune_2,udg_Inspect_Point)==true))then
