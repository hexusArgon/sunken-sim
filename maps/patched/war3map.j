call CreateNUnitsAtLoc(1,'o00D',GetOwningPlayer(udg_Hero_Mage),udg_HydraSpawns_Point,GetUnitFacing(udg_Hero_Mage))
call BlzSetUnitMaxHP(GetLastCreatedUnit(),(BlzGetUnitMaxHP(GetLastCreatedUnit())+R2I(((0.30*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Mage))+(0.15*GetUnitStateSwap(UNIT_STATE_MAX_MANA,udg_Hero_Mage))))))
call SetUnitLifePercentBJ(GetLastCreatedUnit(),100)
call BlzSetUnitBaseDamage(GetLastCreatedUnit(),(4+R2I(((0.40*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Mage,true)))*udg_Archmage_Bonus))),0)
set udg_Hydra_Duration=10.00
