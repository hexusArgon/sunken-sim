function Trig_Select_Agi_Hero_Actions takes nothing returns nothing
local framehandle bar=BlzGetFrameByName("CustomResourceBar",0)
local integer playerNumber=GetPlayerId(GetOwningPlayer(GetSoldUnit()))
local integer hp_s=HP_FindSlot(1)
call HP_ReleaseCrystal(GetSellingUnit())
if hp_s==0 or HP_ClassTaken(GetUnitTypeId(GetSoldUnit())) then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetSoldUnit()),0,0,8.00,"|cffff5555This hero is already taken or all 3 hero slots are full.|r")
call RemoveUnit(GetSoldUnit())
return
endif
set udg_HeroPickSlot=hp_s
set udg_HP_SlotAttr[hp_s]=1
call HP_LoadSlot(hp_s)
call CreateNUnitsAtLoc(1,'h007',GetOwningPlayer(GetSoldUnit()),GetUnitLoc(GetSoldUnit()),bj_UNIT_FACING)
call UnitAddItemByIdSwapped('I0CI',GetLastCreatedUnit())
set udg_Glyphs_Unit[hp_s]=GetLastCreatedUnit()
set udg_GlyphsPlayer[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=GetLastCreatedUnit()
call UnitAddAbilityBJ(udg_Consumables_Ability[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))],udg_Glyphs_Unit[hp_s])
set udg_ESC_Points[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=1
call HP_EnableTalentSelect(hp_s)
set udg_AS_Base_Heroes[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=BlzGetUnitAttackCooldown(GetSoldUnit(),(1-1))
call SetUnitAbilityLevelSwapped('A0QG',GetSoldUnit(),81)
call CreateNUnitsAtLoc(1,'H00P',GetOwningPlayer(GetSoldUnit()),GetUnitLoc(GetTriggerUnit()),bj_UNIT_FACING)
set udg_BackpackUnit[hp_s]=GetLastCreatedUnit()
call SuspendHeroXPBJ(false,GetLastCreatedUnit())
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_BackpackGroup)
set udg_PlayerNumber_AGI=GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))
set udg_Agi_Str_Int[hp_s]=GetSoldUnit()
set udg_PlayerHero[udg_PlayerNumber_AGI]=GetSoldUnit()
call SelectUnitForPlayerSingle(GetSoldUnit(),GetOwningPlayer(GetSoldUnit()))
call GroupAddUnitSimple(GetSoldUnit(),udg_Heroes_Group)
call s__StatisticPlayer_bindGlyph(s__players[playerNumber],udg_Glyphs_Unit[hp_s])
call s__StatisticPlayer_bindHero(s__players[playerNumber],udg_Agi_Str_Int[hp_s])
if(Trig_Select_Agi_Hero_Func028C())then
call UnitAddItemByIdSwapped('I0KE',GetSoldUnit())
else
endif
if(Trig_Select_Agi_Hero_Func029C())then
call UnitAddItemByIdSwapped('I0VE',GetSoldUnit())
else
endif
if(Trig_Select_Agi_Hero_Func030C())then
call UnitAddItemByIdSwapped('I0BU',GetSoldUnit())
else
endif
call UnitAddItemByIdSwapped('pghe',GetSoldUnit())
call UnitAddItemByIdSwapped('pghe',GetSoldUnit())
call UnitAddItemByIdSwapped('pgma',GetSoldUnit())
call TriggerRegisterPlayerEventEndCinematic(gg_trg_Stats_Dialog,ConvertedPlayer(udg_PlayerNumber_AGI))
set udg_HeroPanel_Loop=1
loop
exitwhen udg_HeroPanel_Loop>3
set udg_HeroPanel_PlayerNumber=udg_HeroPanel_Loop
if(Trig_Select_Agi_Hero_Func036Func002C())then
set udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber]=0
set udg_HeroPanel_Heroes[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=GetSoldUnit()
set udg_HeroPanel_Backpacks[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=udg_BackpackUnit[hp_s]
if(GetLocalPlayer()==GetOwningPlayer(GetSoldUnit()))then
call HP_CommitSlot(hp_s)
call TriggerExecute(gg_trg_Setup_Hero_Panel)
call HP_LoadSlot(hp_s)
endif
else
set udg_HeroPanel_OtherHeroesPicked[udg_HeroPanel_PlayerNumber]=(udg_HeroPanel_OtherHeroesPicked[udg_HeroPanel_PlayerNumber]+1)
set udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber]=udg_HeroPanel_OtherHeroesPicked[udg_HeroPanel_PlayerNumber]
set udg_HeroPanel_Heroes[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=GetSoldUnit()
set udg_HeroPanel_Backpacks[((udg_HeroPanel_Amount*udg_HeroPanel_PlayerNumber)+udg_HeroPanel_CurrentAmount[udg_HeroPanel_PlayerNumber])]=udg_BackpackUnit[hp_s]
if(GetLocalPlayer()==ConvertedPlayer(udg_HeroPanel_Loop))then
call HP_CommitSlot(hp_s)
call TriggerExecute(gg_trg_Setup_Hero_Panel)
call HP_LoadSlot(hp_s)
endif
endif
set udg_HeroPanel_Loop=udg_HeroPanel_Loop+1
endloop
call QuestMessageBJ(udg_Player_Group,bj_QUESTMESSAGE_UNITAVAILABLE,("|c00eccf11"+(GetPlayerName(GetOwningPlayer(GetSoldUnit()))+("|r has selected the "+(GetUnitName(GetSoldUnit())+" class.")))))
if(Trig_Select_Agi_Hero_Func038C())then
set udg_Shaman_Rogue_Tauren[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=2
set udg_Hero_Rogue=GetSoldUnit()
call EnableTrigger(gg_trg_Rogue_Kills)
call EnableTrigger(gg_trg_Fan_of_Knives_Passive)
set udg_Generic_Point=GetUnitLoc(udg_Hero_Rogue)
call CreateNUnitsAtLoc(1,'n00Q',GetOwningPlayer(udg_Hero_Rogue),udg_Generic_Point,bj_UNIT_FACING)
set udg_Dummies_FanOfKnives=GetLastCreatedUnit()
call CreateNUnitsAtLoc(1,'n029',GetOwningPlayer(udg_Hero_Rogue),udg_Generic_Point,bj_UNIT_FACING)
set udg_Dummies_Shadowstep=GetLastCreatedUnit()
call RemoveLocation(udg_Generic_Point)
set udg_HP_Talents[1]='I0JX'
set udg_HP_Talents[2]='I0JU'
set udg_HP_Talents[3]='I0QE'
set udg_HP_Talents[4]='I0QF'
