function s__StatisticPlayer_bindTalent takes integer this,unit talentU returns nothing
set s__StatisticPlayer_talentUnit[this]=talentU
if s__StatisticPlayer_updateTalentTrigOnPickup[this]!=null then
call DestroyTrigger(s__StatisticPlayer_updateTalentTrigOnPickup[this])
endif
if s__StatisticPlayer_updateTalentTrigOnDrop[this]!=null then
call DestroyTrigger(s__StatisticPlayer_updateTalentTrigOnDrop[this])
endif
set s__StatisticPlayer_updateTalentTrigOnPickup[this]=CreateTrigger()
set s__StatisticPlayer_updateTalentTrigOnDrop[this]=CreateTrigger()
call TriggerRegisterUnitEvent(s__StatisticPlayer_updateTalentTrigOnPickup[this],s__StatisticPlayer_talentUnit[this],EVENT_UNIT_PICKUP_ITEM)
call TriggerRegisterUnitEvent(s__StatisticPlayer_updateTalentTrigOnDrop[this],s__StatisticPlayer_talentUnit[this],EVENT_UNIT_DROP_ITEM)
call TriggerAddAction(s__StatisticPlayer_updateTalentTrigOnPickup[this],function sc__StatisticPlayer_updateTalentOnPickUp)
call TriggerAddAction(s__StatisticPlayer_updateTalentTrigOnDrop[this],function sc__StatisticPlayer_updateTalentOnDrop)
endfunction
