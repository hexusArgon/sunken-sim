function Trig_Drops_Actions takes nothing returns nothing
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
set udg_Dropped_Item_Unit=GetTriggerUnit()
set udg_RandomItemChance_Tome=4.50
set udg_RandomItemChance_Rune=(21.00-(I2R(GetUnitLevel(GetTriggerUnit()))/ 2.00))
set udg_RandomItemChance_ShadowCrystal=0.43
set udg_RandomItemChance_Seed=0.35
set udg_RandomItemChance_ChestKey=0.38
set udg_RandomItemChance_Heroic=(1.50+(I2R(GetUnitLevel(GetTriggerUnit()))/ 38.00))
set udg_RandomItemChance_Common=(1.70-(I2R(GetUnitLevel(GetTriggerUnit()))/ 40.00))
set udg_RandomItemChance_Uncommon=(0.30+(I2R(GetUnitLevel(GetTriggerUnit()))/ 35.00))
set udg_RandomItemChance_Rare=(0.14+(I2R(GetUnitLevel(GetTriggerUnit()))/ 30.00))
set udg_RandomItemChance_Epic=(0.08+(I2R(GetUnitLevel(GetTriggerUnit()))/ 32.00))
set udg_RandomItemChance_Legendary=(0.01+(I2R(GetUnitLevel(GetTriggerUnit()))/ 400.00))
set udg_RandomItemChance_Artifact=0.01
if(Trig_Drops_Func023C())then
set udg_RandomItemChance_Rune=(udg_RandomItemChance_Rune*1.50)
else
endif
if(Trig_Drops_Func024C())then
set udg_RandomItemChance_Tome=(udg_RandomItemChance_Tome*2.00)
else
endif
set udg_Attribute_Index=1
loop
exitwhen udg_Attribute_Index>3
if(Trig_Drops_Func025Func001C())then
set udg_RandomItemChance_Tome=(udg_RandomItemChance_Tome*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_ShadowCrystal=(udg_RandomItemChance_ShadowCrystal*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Seed=(udg_RandomItemChance_Seed*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_ChestKey=(udg_RandomItemChance_ChestKey*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Heroic=(udg_RandomItemChance_Heroic*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Common=(udg_RandomItemChance_Common*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Uncommon=(udg_RandomItemChance_Uncommon*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Rare=(udg_RandomItemChance_Rare*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Epic=(udg_RandomItemChance_Epic*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Legendary=(udg_RandomItemChance_Legendary*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
set udg_RandomItemChance_Artifact=(udg_RandomItemChance_Artifact*udg_Luck_Multiplier[GetConvertedPlayerId(GetOwningPlayer(udg_Agi_Str_Int[udg_Attribute_Index]))])
else
endif
set udg_Attribute_Index=udg_Attribute_Index+1
endloop
set udg_Drop_Chance=GetRandomReal(0,100.00)
if(Trig_Drops_Func028C())then
call CreateItemLoc(udg_Drops_Tomes[GetRandomInt(1,udg_Drops_TomesCount)],udg_Generic_Point)
if(Trig_Drops_Func028Func002C())then
set udg_Dropped_Item=GetLastCreatedItem()
call TriggerExecute(gg_trg_Bonus_Drop)
else
endif
else
endif
set udg_Drop_Chance=GetRandomReal(0,100.00)
if(Trig_Drops_Func031C())then
call CreateItemLoc(udg_Drops_Consumables[GetRandomInt(1,udg_Drops_ConsumablesCount)],udg_Generic_Point)
