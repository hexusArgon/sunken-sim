function Trig_Switches_Func004C takes nothing returns boolean
if((GetOwningPlayer(GetEnteringUnit())==Player(0)))then
return true
endif
if((GetOwningPlayer(GetEnteringUnit())==Player(1)))then
return true
endif
if((GetOwningPlayer(GetEnteringUnit())==Player(2)))then
return true
endif
return false
endfunction
function Trig_Switches_Conditions takes nothing returns boolean
if(not(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetTriggerUnit())>5.00))then
return false
endif
if(not(GetUnitTypeId(GetTriggerUnit())!='h007'))then
return false
endif
if(not(GetUnitTypeId(GetTriggerUnit())!='H00P'))then
return false
endif
if(not Trig_Switches_Func004C())then
return false
endif
return true
endfunction
function Trig_Switches_Func007C takes nothing returns boolean
if(not(udg_DoorSwitch[2]==true))then
return false
endif
return true
endfunction
function Trig_Switches_Actions takes nothing returns nothing
call KillDestructable(gg_dest_DTfx_0242)
set udg_DoorSwitch[1]=true
if(Trig_Switches_Func007C())then
call DisableTrigger(gg_trg_Leave_Switch)
call DisableTrigger(gg_trg_Leave_Switch_Two)
call ModifyGateBJ(bj_GATEOPERATION_OPEN,gg_dest_ZTg3_0240)
call PlaySoundBJ(gg_snd_Lever)
else
endif
endfunction
