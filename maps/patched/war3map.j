set udg_NextDamageType=5
call UnitDamageTargetBJ(gg_unit_negm_0344,GetEnumUnit(),5000.00,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call ConditionalTriggerExecute(udg_ClearDamageEvent)
else
endif
