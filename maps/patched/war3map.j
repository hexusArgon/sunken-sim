set udg_Nzoth_Message[1]="|cffff7effYour fate leads you to the Void.|r"
set udg_Nzoth_Message[2]="|cffff7effThis place was young when I was old.|r"
set udg_Nzoth_Message[3]="|cffff7effThe endless lands of darkness where shapes exist but cannot be seen await you.|r"
set udg_Nzoth_Message[4]="|cffff7effSo much potential here... wasted. The Destroyer is blind.|r"
set udg_Nzoth_Message[5]="|cffff7effI have seen your dreams. They are mine now.|r"
set udg_Nzoth_Message[6]="|cffff7effYour efforts here only set the stage for my return.|r"
set udg_Nzoth_Message[7]="|cffff7effIn the depths, death is salvation.|r"
set udg_Nzoth_Message[8]="|cffff7effBefore you walked this land, I ruled.|r"
set udg_Nzoth_Message[9]="|cffff7effMy Empire is endless like the Void itself.|r"
set udg_Nzoth_Message[10]="|cffff7effIf your eyes gaze upon the lands beyond, your mind will never be the same again.|r"
set udg_Nzoth_Message[11]="|cffff7effLet go...|r"
set udg_Nzoth_Message[12]="|cffff7effYour awakening draws near...|r"
set udg_Nzoth_Message[13]="|cffff7effThis place pales in comparison to the Ancient City.|r"
set udg_Nzoth_Message[14]="|cffff7effYour mind is fragile... weak...|r"
set udg_Nzoth_Message[15]="|cffff7effIn the place where light is consumed by darkness, you shall see the true face of the world.|r"
set udg_Hint_List[1]="Each hero can obtain a unique Legendary item from the Vault. Find out how from the Mysterious Wanderer."
set udg_Hint_List[2]="Using Attack and Armor Types to your advantage can change the outcome of battles. Mouse-over each for more information."
set udg_Hint_List[3]="Dungeons are optional areas that grant extra rewards when completed."
set udg_Hint_List[4]="The Statistics Dashboard (|cffffcc00I|r) contains detailed breakdown of damage, healing and more. Its button is located at the top center of your screen."
set udg_Hint_List[5]="Learn about Quests, Challenges, Commands and others from the Journal (|cffffcc00F9|r)."
set udg_Hint_List[6]="Did you know that Bosses have yellow names?"
set udg_Hint_List[7]="The solution to most puzzles is usually not very far away from the puzzle itself."
set udg_Hint_List[8]="Venture alone at your own discretion."
set udg_Hint_List[9]="This map is hosted at |cffffcc00Hiveworkshop.com|r. You can always find the latest version there."
set udg_Hint_List[10]="Enemy units have a scripted loot table, giving them a chance to drop extra loot. Magic Find improves that chance."
set udg_Hint_List[11]="Once you reach the Grove of Idrassil, you can use it as storage area for your items. You will be revisiting it over and over."
set udg_Hint_List[12]="You can check your hero's movement speed by typing in |cffffcc00-ms|r."
set udg_Hint_List[13]="You can roll for items that other Players are also interested in. You can do that via the |cffffcc00-roll|r command or the |c00e74d3eRoll|r ability of your Backpack."
set udg_Hint_List[14]="The |c00e74d3eRecall|r ability of Resurrection Stones can get you out of trouble, save you some run distance or teleport you if you are stuck!|r"
set udg_Hint_List[15]="Type in |cffffcc00-items|r to get info on item qualities."
set udg_Hint_List[16]="Your Backpack (|cffffcc00F2|r) can be used for extra inventory slots and also contains some useful abilities."
set udg_Hint_List[17]="Spend your ESC Stats wisely, because resetting them does not come for free."
set udg_Hint_List[18]="Damage dealt by Snake Poison and Nightmares in Heroic Mode is classified as Spell Damage."
set udg_Hint_List[19]="You can find out the total bonuses you've gained from consumables in the Backpack (|cffffcc00F2|r)."
set udg_Hint_List[20]="Avoid pulling enemies too close to the Resurrection Stones. They also benefit from its healing powers."
set udg_Hint_List[21]="Secret Areas are scattered around the map and contain small rewards. Find them all to unlock a greater reward."
set udg_Hint_List[22]="Certain areas in the map can only be accessed by Naga heroes. None of them are required to progress."
set udg_Hint_List[23]="Bounty from killed enemies is shared between Players. No need to last hit!"
set udg_Hint_List[24]="Join our Discord community at |cffffcc00discord.gg/gfkpZF9|r where you can find teammates, news and other useful information."
set udg_Hint_List[25]="The ingame Multiboard contains useful information regarding the team's performance as well as each hero's Glyphs and Talents."
set udg_Hint_List[26]="Floating text when dealing damage has different color which represents its damage type. Find out more in the Journal (|cffffcc00F9|r)."
set udg_Hint_List[27]="Certain areas and items cannot be accessed in every run, because they are dependant on random drops."
set udg_Hint_List[28]="Finding synergies between different heroes can make a huge difference in the team's performance."
set udg_PlayerIndex=1
loop
exitwhen udg_PlayerIndex>3
call TriggerRegisterPlayerUnitEventSimple(gg_trg_Item_Effects,ConvertedPlayer(udg_PlayerIndex),EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_OnSpellcast_Items,ConvertedPlayer(udg_PlayerIndex),EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_Refund_Mana,ConvertedPlayer(udg_PlayerIndex),EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerRegisterPlayerUnitEventSimple(gg_trg_Glyph_on_Spellcast,ConvertedPlayer(udg_PlayerIndex),EVENT_PLAYER_UNIT_SPELL_EFFECT)
set udg_PlayerIndex=udg_PlayerIndex+1
endloop
call TriggerRegisterAnyUnitEventBJ(gg_trg_Hero_Attacked,EVENT_PLAYER_UNIT_ATTACKED)
call TriggerRegisterAnyUnitEventBJ(gg_trg_Eye_of_Discord,EVENT_PLAYER_UNIT_ATTACKED)
endfunction
function InitTrig_Initialization_Variables takes nothing returns nothing
set gg_trg_Initialization_Variables=CreateTrigger()
call TriggerAddAction(gg_trg_Initialization_Variables,function Trig_Initialization_Variables_Actions)
endfunction
function Trig_Initialization_Items_Func002Func001Func001Func001C takes nothing returns boolean
if(not(udg_QuestItem_SpawnChance>=76))then
return false
endif
if(not(udg_QuestItem_SpawnChance<=100))then
return false
endif
return true
endfunction
