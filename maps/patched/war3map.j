return false
endif
return true
endfunction
function Trig_Mastery_Tooltip_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_Mastery_Unit))
set udg_Mastery_Stat[udg_PlayerNumber]=(udg_Mastery_Stat[udg_PlayerNumber]-udg_Mastery_Bonus[udg_PlayerNumber])
set udg_Mastery_Bonus[udg_PlayerNumber]=0
call ConditionalTriggerExecute(gg_trg_Mastery_Buffs_Setup)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_Mastery_BuffsMax
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_Mastery_Tooltip_Func005Func001C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+udg_Mastery_BuffValue[GetForLoopIndexA()])
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if(Trig_Mastery_Tooltip_Func006C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+15)
else
endif
if(Trig_Mastery_Tooltip_Func007C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+(6*CountUnitsInGroup(udg_TotemicCall_Group)))
else
endif
if(Trig_Mastery_Tooltip_Func008C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+udg_HammerMastery_Stacks)
else
endif
if(Trig_Mastery_Tooltip_Func009C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+udg_ColdSplinters_Amount)
else
endif
if(Trig_Mastery_Tooltip_Func010C())then
set udg_Mastery_Bonus[udg_PlayerNumber]=(udg_Mastery_Bonus[udg_PlayerNumber]+udg_SealBlackEmpire_Stacks[udg_PlayerNumber])
else
endif
set udg_Mastery_Stat[udg_PlayerNumber]=(udg_Mastery_Stat[udg_PlayerNumber]+udg_Mastery_Bonus[udg_PlayerNumber])
set udg_PlayerIndex=(100*udg_PlayerNumber)
