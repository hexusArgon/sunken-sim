function Trig_On_Talent_Reset_Actions takes nothing returns nothing
if(Trig_On_Talent_Reset_Func001C())then
set udg_TalentUI_Loop=1
loop
exitwhen udg_TalentUI_Loop>3
if(Trig_On_Talent_Reset_Func001Func004Func001C())then
set udg_TalentGlyph_PlayerAttIndex=udg_TalentUI_Loop
set udg_DeathCheck_Unit=udg_Agi_Str_Int[udg_TalentUI_Loop]
if GetUnitTypeId(udg_DeathCheck_Unit)==0 or IsUnitType(udg_DeathCheck_Unit,UNIT_TYPE_DEAD)then
set udg_DeathCheck_Alive=false
else
set udg_DeathCheck_Alive=true
endif
else
endif
set udg_TalentUI_Loop=udg_TalentUI_Loop+1
endloop
if(Trig_On_Talent_Reset_Func001Func007C())then
set udg_TalentUI_Loop=1
loop
exitwhen udg_TalentUI_Loop>UnitInventorySizeBJ(udg_TalentGlyph_SelectedUnit)
call RemoveItem(UnitItemInSlotBJ(udg_TalentGlyph_SelectedUnit,udg_TalentUI_Loop))
set udg_TalentUI_Loop=udg_TalentUI_Loop+1
endloop
call AddSpecialEffectTargetUnitBJ("origin",udg_Agi_Str_Int[udg_TalentGlyph_PlayerAttIndex],"Abilities\\Spells\\Items\\AIlm\\AIlmTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call MultiboardSetItemIconBJ(udg_Main_Board,7,(GetConvertedPlayerId(udg_TalentGlyph_Player)+2),"ReplaceableTextures\\WorldEditUI\\DoodadPlaceholder.blp")
call MultiboardSetItemIconBJ(udg_Main_Board,8,(GetConvertedPlayerId(udg_TalentGlyph_Player)+2),"ReplaceableTextures\\WorldEditUI\\DoodadPlaceholder.blp")
call MultiboardSetItemIconBJ(udg_Main_Board,9,(GetConvertedPlayerId(udg_TalentGlyph_Player)+2),"ReplaceableTextures\\WorldEditUI\\DoodadPlaceholder.blp")
call MultiboardSetItemIconBJ(udg_Main_Board,10,(GetConvertedPlayerId(udg_TalentGlyph_Player)+2),"ReplaceableTextures\\WorldEditUI\\DoodadPlaceholder.blp")
else
set udg_GenericPlayerGroup=GetForceOfPlayer(udg_TalentGlyph_Player)
call DisplayTextToForce(udg_GenericPlayerGroup,"TRIGSTR_1163")
call DestroyForce(udg_GenericPlayerGroup)
endif
else
set udg_GenericPlayerGroup=GetForceOfPlayer(udg_TalentGlyph_Player)
call DisplayTextToForce(udg_GenericPlayerGroup,"TRIGSTR_1318")
call DestroyForce(udg_GenericPlayerGroup)
endif
endfunction
