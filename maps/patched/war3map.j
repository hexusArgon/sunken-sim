function Trig_Create_Loot_Actions takes nothing returns nothing
set udg_Chest_Point=GetDestructableLoc(udg_Chest)
set udg_Generic_Point=PolarProjectionBJ(udg_Chest_Point,75.00,udg_Chest_Degrees)
set udg_ChestChance=GetRandomReal(0,100.00)
if(Trig_Create_Loot_Func004C())then
call CreateItemLoc(udg_SpecialItems[GetRandomInt(1,udg_SpecialItems_Total)],udg_Generic_Point)
else
if(Trig_Create_Loot_Func004Func001C())then
set udg_Tarecgosa_Dropped=true
call CreateItemLoc('I0AA',udg_Generic_Point)
else
if(Trig_Create_Loot_Func004Func001Func001C())then
call CreateItemLoc(udg_Drops_Epic[GetRandomInt(1,udg_Drops_EpicCount)],udg_Generic_Point)
else
if(Trig_Create_Loot_Func004Func001Func001Func001C())then
call CreateItemLoc(udg_Drops_Rare[GetRandomInt(1,udg_Drops_RareCount)],udg_Generic_Point)
else
if(Trig_Create_Loot_Func004Func001Func001Func001Func001C())then
call CreateItemLoc(udg_Drops_Uncommon[GetRandomInt(1,udg_Drops_UncommonCount)],udg_Generic_Point)
else
endif
endif
endif
endif
endif
call RemoveLocation(udg_Chest_Point)
call RemoveLocation(udg_Generic_Point)
endfunction
