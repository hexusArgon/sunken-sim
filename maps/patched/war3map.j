set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocAll(250.00,l__udg_Pyroblast_Point2),function Trig_Pyroblast_Func014A)
call RemoveLocation(l__udg_Pyroblast_Point1)
call RemoveLocation(l__udg_Pyroblast_Point2)
