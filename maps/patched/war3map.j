function Trig_Arcane_Blast_Actions takes nothing returns nothing
set udg_ArcaneBlast_Level=GetUnitAbilityLevelSwapped('A0NZ',udg_Hero_Mage)
set udg_ArcaneBlast_Mana=BlzGetAbilityManaCost('A0NZ',(udg_ArcaneBlast_Level-1))
set udg_ArcaneBlast_Target=GetSpellTargetUnit()
set udg_ArcaneBlast_Damage=(((60.00*I2R(udg_ArcaneBlast_Level))+20.00)+((2.50*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Mage,true)))*udg_Archmage_Bonus))
set udg_Temp_Loop=1
loop
exitwhen udg_Temp_Loop>udg_ArcaneBlast_Charges
set udg_ArcaneBlast_Damage=(udg_ArcaneBlast_Damage*1.20)
set udg_Temp_Loop=udg_Temp_Loop+1
endloop
if(Trig_Arcane_Blast_Func006C())then
call AddSpecialEffectTargetUnitBJ("origin",udg_ArcaneBlast_Target,"war3mapImported\\Shiva'sWrath.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ('A0HD',udg_Caster_Dummy)
call IssueTargetOrderBJ(udg_Caster_Dummy,"soulburn",udg_ArcaneBlast_Target)
call UnitRemoveAbilityBJ('A0HD',udg_Caster_Dummy)
else
endif
if(Trig_Arcane_Blast_Func007C())then
if(Trig_Arcane_Blast_Func007Func002C())then
if(Trig_Arcane_Blast_Func007Func002Func001C())then
set udg_ArcaneBlast_Charges=(udg_ArcaneBlast_Charges+2)
else
set udg_ArcaneBlast_Charges=(udg_ArcaneBlast_Charges+1)
endif
call TasAbilityChargeBox_SetValue(udg_Hero_Mage,'A0NZ',I2S(udg_ArcaneBlast_Charges))
else
endif
call AddSpecialEffectTargetUnitBJ("origin",udg_ArcaneBlast_Target,"war3mapImported\\Mythic_Singularity I Purple.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call BlzSetAbilityIntegerLevelFieldBJ(BlzGetUnitAbility(udg_Hero_Mage,'A0NZ'),ABILITY_ILF_MANA_COST,(udg_ArcaneBlast_Level-1),R2I((I2R(udg_ArcaneBlast_Mana)*Pow(1.15,I2R(udg_ArcaneBlast_Charges)))))
else
endif
if(Trig_Arcane_Blast_Func008C())then
call AddSpecialEffectTargetUnitBJ("origin",udg_ArcaneBlast_Target,"war3mapImported\\Mythic_Pillar of Flame Orange.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set udg_ArcaneBlast_Damage=(udg_ArcaneBlast_Damage/ 4.00)
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Mage,udg_ArcaneBlast_Target,udg_ArcaneBlast_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Mage,udg_ArcaneBlast_Target,udg_ArcaneBlast_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Mage,udg_ArcaneBlast_Target,udg_ArcaneBlast_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
else
endif
if(Trig_Arcane_Blast_Func009C())then
if(Trig_Arcane_Blast_Func009Func001C())then
set udg_Pyroblast_Cost=50
else
set udg_Pyroblast_Cost=30
endif
if(Trig_Arcane_Blast_Func009Func003C())then
set udg_ArcaneBlast_Point=GetUnitLoc(GetTriggerUnit())
call SetUnitPositionLoc(udg_Dummies_Pyroblast,udg_ArcaneBlast_Point)
call IssueTargetOrderBJ(udg_Dummies_Pyroblast,"acidbomb",udg_ArcaneBlast_Target)
call RemoveLocation(udg_ArcaneBlast_Point)
else
endif
else
endif
if(Trig_Arcane_Blast_Func010C())then
set udg_ArcaneBlast_Point=GetUnitLoc(udg_ArcaneBlast_Target)
set bj_wantDestroyGroup=true
call ForGroupBJ(GetUnitsInRangeOfLocAll(250.00,udg_ArcaneBlast_Point),function Trig_Arcane_Blast_Func010Func003A)
call AddSpecialEffectLocBJ(udg_ArcaneBlast_Point,"war3mapImported\\Mythic_Gravity Storm - Classic.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_ArcaneBlast_Point)
else
endif
if(Trig_Arcane_Blast_Func011C())then
set udg_Generic_Point=GetUnitLoc(udg_Hero_Mage)
call SetUnitPositionLoc(udg_Dummies_FrostfireBolt,udg_Generic_Point)
call IssueTargetOrderBJ(udg_Dummies_FrostfireBolt,"acidbomb",udg_ArcaneBlast_Target)
call RemoveLocation(udg_Generic_Point)
else
endif
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Mage,udg_ArcaneBlast_Target,udg_ArcaneBlast_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
