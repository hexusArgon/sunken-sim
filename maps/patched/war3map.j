function Trig_Blood_Globe_Actions takes nothing returns nothing
set udg_Heal_Amount=(0.15*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetTriggerUnit()))
set udg_Heal_Target=GetTriggerUnit()
set udg_Heal_Healer=GetTriggerUnit()
call ConditionalTriggerExecute(gg_trg_Healing)
if(Trig_Blood_Globe_Func011C())then
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
set udg_Generic_Group=GetUnitsInRangeOfLocMatching(500.00,udg_Generic_Point,Condition(function Trig_Blood_Globe_Func011Func002002003))
call ForGroupBJ(udg_Generic_Group,function Trig_Blood_Globe_Func011Func003A)
call RemoveLocation(udg_Generic_Point)
call DestroyGroup(udg_Generic_Group)
if(Trig_Blood_Globe_Func011Func006C())then
call SetUnitManaBJ(GetTriggerUnit(),(GetUnitStateSwap(UNIT_STATE_MANA,GetTriggerUnit())+(0.05*GetUnitStateSwap(UNIT_STATE_MAX_MANA,GetTriggerUnit()))))
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Items\\AIma\\AImaTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
set udg_CDR_AbilityArray=1
loop
exitwhen udg_CDR_AbilityArray>9
set udg_CD_Dynamic_Hero=udg_Hero_Necromancer
set udg_CD_Dynamic_Ability=udg_Ability_Int[udg_CDR_AbilityArray]
set udg_CD_Dynamic=BlzGetUnitAbilityCooldownRemaining(udg_CD_Dynamic_Hero,udg_CD_Dynamic_Ability)
set udg_CD_Dynamic_Reduction=(0.06*BlzGetUnitAbilityCooldown(udg_CD_Dynamic_Hero,udg_CD_Dynamic_Ability,(GetUnitAbilityLevelSwapped(udg_CD_Dynamic_Ability,udg_CD_Dynamic_Hero)-1)))
call ConditionalTriggerExecute(gg_trg_Dynamic_CDR)
set udg_CDR_AbilityArray=udg_CDR_AbilityArray+1
endloop
else
endif
if(Trig_Blood_Globe_Func011Func007C())then
set udg_RaiseDead_Ticks=(udg_RaiseDead_Ticks+2)
else
endif
else
endif
endfunction
