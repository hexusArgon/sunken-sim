return true
endfunction
function Trig_Periodic_Updates_Actions takes nothing returns nothing
if(Trig_Periodic_Updates_Func001C())then
call StartTimerBJ(udg_StatUpdateTimer,false,0.10)
else
call StartTimerBJ(udg_StatUpdateTimer,false,1.00)
endif
call ConditionalTriggerExecute(gg_trg_SDR_Stat)
set udg_Stats_PeriodicLoop=1
loop
exitwhen udg_Stats_PeriodicLoop>3
if(Trig_Periodic_Updates_Func003Func001C())then
set udg_Potency_Hero=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
call ConditionalTriggerExecute(gg_trg_Potency_Tooltip)
set udg_Mastery_Unit=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
call ConditionalTriggerExecute(gg_trg_Mastery_Tooltip)
set udg_Luck_Hero=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
call ConditionalTriggerExecute(gg_trg_Luck_Tooltip)
set udg_PetDamage_Hero=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
call ConditionalTriggerExecute(gg_trg_Pet_Damage_Tooltip)
set udg_HealingPower_Hero=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
call ConditionalTriggerExecute(gg_trg_Healing_Power_Tooltip)
set udg_AttackSpeed_Unit=udg_Agi_Str_Int[udg_Stats_PeriodicLoop]
if(Trig_Periodic_Updates_Func003Func001Func017C())then
call ConditionalTriggerExecute(gg_trg_Attack_Speed_Tooltip)
else
endif
if(Trig_Periodic_Updates_Func003Func001Func019C())then
set udg_MagicFind_Bonus=1.00
else
if(Trig_Periodic_Updates_Func003Func001Func019Func001C())then
set udg_MagicFind_Bonus=1.25
else
if(Trig_Periodic_Updates_Func003Func001Func019Func001Func001C())then
set udg_MagicFind_Bonus=1.50
else
endif
endif
endif
set udg_MagicFind_Total=(udg_MagicFind*udg_MagicFind_Bonus)
set udg_MagicFind_Multiplier=(1+udg_MagicFind_Total)
call SetPlayerStateBJ(GetOwningPlayer(udg_Agi_Str_Int[udg_Stats_PeriodicLoop]),PLAYER_STATE_RESOURCE_FOOD_USED,R2I(((udg_MagicFind_Total*100.00)+0.50)))
else
endif
set udg_Stats_PeriodicLoop=udg_Stats_PeriodicLoop+1
endloop
endfunction
