function Trig_Select_Str_Hero_Actions takes nothing returns nothing
local framehandle bar=BlzGetFrameByName("CustomResourceBar",0)
local integer playerNumber=GetPlayerId(GetOwningPlayer(GetSoldUnit()))
local integer hp_s=HP_FindSlot(2)
call HP_ReleaseCrystal(GetSellingUnit())
if hp_s==0 or HP_ClassTaken(GetUnitTypeId(GetSoldUnit())) then
call DisplayTimedTextToPlayer(GetOwningPlayer(GetSoldUnit()),0,0,8.00,"|cffff5555This hero is already taken or all 3 hero slots are full.|r")
call RemoveUnit(GetSoldUnit())
return
endif
set udg_HeroPickSlot=hp_s
set udg_HP_SlotAttr[hp_s]=2
call HP_LoadSlot(hp_s)
call CreateNUnitsAtLoc(1,'h007',GetOwningPlayer(GetSoldUnit()),GetUnitLoc(GetSoldUnit()),bj_UNIT_FACING)
call UnitAddItemByIdSwapped('I0CI',GetLastCreatedUnit())
set udg_Glyphs_Unit[hp_s]=GetLastCreatedUnit()
set udg_GlyphsPlayer[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=GetLastCreatedUnit()
call UnitAddAbilityBJ(udg_Consumables_Ability[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))],udg_Glyphs_Unit[hp_s])
set udg_ESC_Points[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=1
call HP_EnableTalentSelect(hp_s)
set udg_AS_Base_Heroes[GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))]=BlzGetUnitAttackCooldown(GetSoldUnit(),(1-1))
call SetUnitAbilityLevelSwapped('A0QG',GetSoldUnit(),81)
call CreateNUnitsAtLoc(1,'H00P',GetOwningPlayer(GetSoldUnit()),GetUnitLoc(GetTriggerUnit()),bj_UNIT_FACING)
set udg_BackpackUnit[hp_s]=GetLastCreatedUnit()
call SuspendHeroXPBJ(false,GetLastCreatedUnit())
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_BackpackGroup)
set udg_PlayerNumber_STR=GetConvertedPlayerId(GetOwningPlayer(GetSoldUnit()))
set udg_Agi_Str_Int[hp_s]=GetSoldUnit()
set udg_PlayerHero[udg_PlayerNumber_STR]=GetSoldUnit()
call SelectUnitForPlayerSingle(GetSoldUnit(),GetOwningPlayer(GetSoldUnit()))
call GroupAddUnitSimple(GetSoldUnit(),udg_Heroes_Group)
call s__StatisticPlayer_bindGlyph(s__players[playerNumber],udg_Glyphs_Unit[hp_s])
call s__StatisticPlayer_bindHero(s__players[playerNumber],udg_Agi_Str_Int[hp_s])
if(Trig_Select_Str_Hero_Func028C())then
call UnitAddItemByIdSwapped('I0KE',GetSoldUnit())
else
endif
if(Trig_Select_Str_Hero_Func029C())then
call UnitAddItemByIdSwapped('I0VE',GetSoldUnit())
else
endif
if(Trig_Select_Str_Hero_Func030C())then
call UnitAddItemByIdSwapped('I0BU',GetSoldUnit())
else
