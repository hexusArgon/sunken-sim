function updateCustomResourceBar takes nothing returns nothing
local player localPlayer=GetLocalPlayer()
local integer playerNumber=GetConvertedPlayerId(localPlayer)
local string finalString
local real ratio
if(localPlayer==GetEnumPlayer()and udg_CustomResource_Name[playerNumber]!="")then
set finalString=udg_CustomResource_Name[playerNumber]+"  "+I2S(udg_CustomResource_CurrentValue[playerNumber])+"/"+I2S(udg_CustomResource_MaxValue[playerNumber])
set ratio=I2R(udg_CustomResource_CurrentValue[playerNumber])/ I2R(udg_CustomResource_MaxValue[playerNumber])*100.00
call BlzFrameSetValue(BlzGetFrameByName("CustomResourceBar",0),ratio)
call BlzFrameSetText(BlzGetFrameByName("CustomResourceBarText",0),finalString)
endif
endfunction
function Trig_Update_Custom_Resource_Bar_Actions takes nothing returns nothing
local force activePlayerGroup=GetPlayersMatching(Condition(function isPlayerActive))
call ForForce(activePlayerGroup,function updateCustomResourceBar)
call DestroyForce(activePlayerGroup)
endfunction
