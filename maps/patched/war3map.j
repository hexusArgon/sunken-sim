function InitTrig_Intro_Cinematic takes nothing returns nothing
set gg_trg_Intro_Cinematic=CreateTrigger()
call DisableTrigger(gg_trg_Intro_Cinematic)
call TriggerRegisterTimerEventPeriodic(gg_trg_Intro_Cinematic,0.10)
call TriggerAddAction(gg_trg_Intro_Cinematic,function Trig_Intro_Cinematic_Actions)
endfunction
function Trig_Intro_Cinematic_Skip_Func022C takes nothing returns boolean
if(not(udg_PeonChance<=50.00))then
return false
endif
return true
endfunction
function Trig_Intro_Cinematic_Skip_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisableTrigger(gg_trg_Intro_Cinematic)
call ClearTextMessagesBJ(GetPlayersAll())
call StopSoundBJ(gg_snd_intro_music,false)
call PlaySoundBJ(gg_snd_Seagull1)
call CinematicModeBJ(false,GetPlayersAll())
call DisplayCineFilterBJ(false)
call CinematicFadeBJ(bj_CINEFADETYPE_FADEIN,5.00,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)
call ResetToGameCameraForPlayer(Player(0),0)
call ResetToGameCameraForPlayer(Player(1),0)
call ResetToGameCameraForPlayer(Player(2),0)
call ClearMapMusicBJ()
call StopMusicBJ(false)
call PlayMusicBJ(gg_snd_SunkenMusic__Low_u)
call PlayMusic(gg_snd_SunkenMusic__Low_u)
call SetUnitInvulnerable(gg_unit_O003_0920,true)
call SuspendHeroXPBJ(false,gg_unit_O003_0920)
call CameraSetSmoothingFactorBJ(10.00)
call RemoveDestructable(gg_dest_B00T_9373)
call RemoveDestructable(gg_dest_B00T_9436)
set udg_PeonChance=GetRandomReal(0,100.00)
if(Trig_Intro_Cinematic_Skip_Func022C())then
set udg_OptQuest_Trek_Outcome=true
call CreateNUnitsAtLoc(1,'opeo',Player(3),GetRectCenter(gg_rct_Dead_Peon),215.00)
set udg_OptQuest_TrekPeon=GetLastCreatedUnit()
call AddSpecialEffectTargetUnitBJ("overhead",GetLastCreatedUnit(),"war3mapImported\\floating questionmark_billnoutshape v2.mdx")
set udg_OptQuest_TrekPeon_SFX=GetLastCreatedEffectBJ()
call IssueImmediateOrderBJ(GetLastCreatedUnit(),"holdposition")
call SetUnitInvulnerable(GetLastCreatedUnit(),true)
else
set udg_OptQuest_Trek_Outcome=false
call CreatePermanentCorpseLocBJ(bj_CORPSETYPE_FLESH,'opeo',Player(3),GetRectCenter(gg_rct_Dead_Peon),GetRandomDirectionDeg())
call CreateItemLoc('I04W',GetRectCenter(gg_rct_Peon_Lumber))
endif
call ShowTextTagForceBJ(true,udg_DungeonName_DWB,GetPlayersAll())
call ConditionalTriggerExecute(gg_trg_Initialization)
call TriggerRegisterTimerEventSingle(gg_trg_Initialization_Items,0.25)
call TriggerRegisterTimerEventSingle(gg_trg_Initialization_Units,0.50)
call TriggerRegisterTimerEventSingle(gg_trg_Initialization_Destruct,1.00)
call ConditionalTriggerExecute(gg_trg_Difficulty_Setup)
call FixQuestDialog()
call MoveChatUp()
endfunction
