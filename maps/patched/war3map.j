function Trig_Tornado_Actions takes nothing returns nothing
set udg_Tornado_Point=GetSpellTargetLoc()
if(Trig_Tornado_Func002C())then
call CreateNUnitsAtLoc(1,'o01L',GetOwningPlayer(GetTriggerUnit()),udg_Tornado_Point,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ((7.00+(0.20*udg_Potency_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Windmaster))])),'BTLF',GetLastCreatedUnit())
call SetUnitVertexColorBJ(GetLastCreatedUnit(),100,100,100,65.00)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_Tornado_Group)
if(Trig_Tornado_Func002Func008C())then
call UnitAddAbilityBJ('A0E1',GetLastCreatedUnit())
else
call UnitAddAbilityBJ('A0B0',GetLastCreatedUnit())
endif
if(Trig_Tornado_Func002Func009C())then
call CreateCommandButtonEffectBJ('A0KT',"berserk")
set udg_Skyfury_ButtonEffect=GetLastCreatedCommandButtonEffectBJ()
set udg_Skyfury_Boo=true
else
endif
else
set udg_InvalidArea_Unit=GetTriggerUnit()
set udg_InvalidArea_Ability='A092'
call InvalidTargetAreaCDFix()
endif
call RemoveLocation(udg_Tornado_Point)
if(Trig_Tornado_Func004C())then
call ConditionalTriggerExecute(gg_trg_Illusions)
else
endif
endfunction
