function getPlayerColorInInteger takes integer playerNumber returns integer
if(playerNumber==1)then
return BlzConvertColor(255,255,3,3)
elseif(playerNumber==2)then
return BlzConvertColor(255,0,66,255)
elseif(playerNumber==3)then
return BlzConvertColor(255,28,230,185)
endif
return 0
endfunction
function isPlayerActive takes nothing returns boolean
return GetPlayerSlotState(GetFilterPlayer())==PLAYER_SLOT_STATE_PLAYING and GetPlayerController(GetFilterPlayer())==MAP_CONTROL_USER
endfunction
function createDpsMeter takes nothing returns nothing
local integer playerIndex=GetConvertedPlayerId(GetEnumPlayer())
local framehandle bar=BlzCreateSimpleFrame("DpsBar",dpsPanel,playerIndex)
local framehandle barBorder=BlzGetFrameByName("DpsBarBorder",playerIndex)
local framehandle titleText=BlzGetFrameByName("DpsBarPlayerNameText",playerIndex)
call BlzFrameSetPoint(bar,FRAMEPOINT_TOPLEFT,dpsPanel,FRAMEPOINT_TOPLEFT,(0.01),-(0.020)-((0.015)+(0.005))*dpsBarCount)
call BlzFrameSetPoint(titleText,FRAMEPOINT_CENTER,dpsPanel,FRAMEPOINT_CENTER,0,-0.1)
call BlzFrameSetSize(bar,(0.12),(0.015))
call BlzFrameSetTexture(bar,"ui_statusbar_fill.blp",0,true)
call BlzFrameSetTexture(barBorder,"ui_statusbar_border.blp",0,true)
call BlzFrameSetVertexColor(bar,getPlayerColorInInteger(playerIndex))
call BlzFrameSetValue(bar,0)
call BlzFrameSetText(titleText,SubStringBJ(RemoveBTag(GetPlayerName(GetEnumPlayer())),1,12))
call BlzFrameSetFont(titleText,"font_Indira_K.ttf",(0.006),0)
set dpsBarCount=dpsBarCount+1
endfunction
function createParentPanel takes integer playerNumber returns nothing
local framehandle panelTitle
local framehandle panelTitleFrame
local framehandle panelTitleBackground
local real panelWidth=(0.01)*2+(0.12)
local real panelHeight=(0.020)+((0.015)+(0.005))*playerNumber-(0.005)+(0.015)
set dpsPanel=BlzCreateSimpleFrame("DpsPanel",BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI,0),0)
set panelTitle=BlzGetFrameByName("DpsPanelTitle",0)
set panelTitleFrame=BlzGetFrameByName("DpsPanelTitleFrame",0)
set panelTitleBackground=BlzGetFrameByName("DpsPanelTitleBackground",0)
call BlzFrameSetSize(dpsPanel,panelWidth,panelHeight)
call BlzFrameSetSize(panelTitleFrame,panelWidth*0.75-(0.01)*2,(0.025))
call BlzFrameSetText(panelTitle,"DPS Meter")
call BlzFrameSetFont(panelTitle,"font_Indira_K.ttf",0.0085,0)
call BlzFrameSetTextColor(panelTitle,BlzConvertColor(255,252,229,83))
call BlzFrameSetTexture(BlzGetFrameByName("DpsPanelBackground",0),"ui_basicframe_horizontal.blp",0,true)
call BlzFrameSetTexture(panelTitleBackground,"ui_title_background_frame.blp",0,true)
call BlzFrameSetVisible(dpsPanel,false)
endfunction
function createDpsPanel takes nothing returns nothing
local force activePlayers=GetPlayersMatching(Condition(function isPlayerActive))
local integer activePlayersNumber=CountPlayersInForceBJ(activePlayers)
call createParentPanel(activePlayersNumber)
call ForForce(activePlayers,function createDpsMeter)
call DestroyForce(activePlayers)
endfunction
function InitTrig_Create_Dps_Panel takes nothing returns nothing
set gg_trg_Create_Dps_Panel=CreateTrigger()
call TriggerRegisterTimerEventSingle(gg_trg_Create_Dps_Panel,0.00)
call TriggerAddAction(gg_trg_Create_Dps_Panel,function createDpsPanel)
endfunction
function calculateMaxDps takes nothing returns nothing
local integer playerNumber=GetConvertedPlayerId(GetEnumPlayer())
if(udg_DpsPanel_MaxDps<=udg_DpsPanel_CurrentDps[playerNumber])then
set udg_DpsPanel_MaxDps=udg_DpsPanel_CurrentDps[playerNumber]
endif
endfunction
function resetDpsBar takes nothing returns nothing
local integer playerNumber=GetConvertedPlayerId(GetEnumPlayer())
local framehandle dpsBar=BlzGetFrameByName("DpsBar",playerNumber)
call BlzFrameSetValue(dpsBar,0)
call BlzFrameSetText(BlzGetFrameByName("DpsBarPlayerDpsText",playerNumber),"0")
endfunction
function updateDpsBar takes nothing returns nothing
local integer playerNumber=GetConvertedPlayerId(GetEnumPlayer())
local framehandle dpsBar=BlzGetFrameByName("DpsBar",playerNumber)
local real dpsRatio=udg_DpsPanel_CurrentDps[playerNumber]/ udg_DpsPanel_MaxDps*100
call BlzFrameSetValue(dpsBar,dpsRatio)
call BlzFrameSetText(BlzGetFrameByName("DpsBarPlayerDpsText",playerNumber),I2S(R2I(udg_DpsPanel_CurrentDps[playerNumber])))
endfunction
function Trig_Update_Dps_Panel_Actions takes nothing returns nothing
local force currentActivePlayers=GetPlayersMatching(Condition(function isPlayerActive))
set udg_DpsPanel_MaxDps=0
call ForForce(currentActivePlayers,function calculateMaxDps)
if(udg_DpsPanel_MaxDps!=0)then
call ForForce(currentActivePlayers,function updateDpsBar)
else
call ForForce(currentActivePlayers,function resetDpsBar)
endif
call DestroyForce(currentActivePlayers)
endfunction
function InitTrig_Update_Dps_Panel takes nothing returns nothing
set gg_trg_Update_Dps_Panel=CreateTrigger()
call TriggerAddAction(gg_trg_Update_Dps_Panel,function Trig_Update_Dps_Panel_Actions)
call TriggerRegisterTimerEventPeriodic(gg_trg_Update_Dps_Panel,0.5)
endfunction
