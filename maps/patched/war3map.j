function Trig_Pet_Damage_Tooltip_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_PetDamage_Hero))
set udg_PetDamage_Bonus[udg_PlayerNumber]=0.00
if(Trig_Pet_Damage_Tooltip_Func003C())then
set udg_PetDamage_Bonus[udg_PlayerNumber]=(udg_PetDamage_Bonus[udg_PlayerNumber]+(GetUnitStateSwap(UNIT_STATE_MANA,udg_Hero_Tinker)/ 50.00))
else
endif
if(Trig_Pet_Damage_Tooltip_Func004C())then
set udg_PetDamage_Bonus[udg_PlayerNumber]=(udg_PetDamage_Bonus[udg_PlayerNumber]+(0.60*I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_WitchDoctor,true))))
else
endif
if(Trig_Pet_Damage_Tooltip_Func005C())then
set udg_PetDamage_Bonus[udg_PlayerNumber]=(udg_PetDamage_Bonus[udg_PlayerNumber]+I2R(udg_DinokeeperAxe_Stacks[udg_PlayerNumber]))
else
endif
if(Trig_Pet_Damage_Tooltip_Func006C())then
set udg_AttackSpeed_Buffs=(udg_AttackSpeed_Buffs+(0.15*(GetUnitManaPercent(udg_AttackSpeed_Unit)/ 100.00)))
set udg_PetDamage_Bonus[udg_PlayerNumber]=(udg_PetDamage_Bonus[udg_PlayerNumber]+(10.00*(GetUnitManaPercent(udg_PetDamage_Hero)/ 100.00)))
else
endif
set udg_PetDamage_Total[udg_PlayerNumber]=(udg_PetDamage_Items[udg_PlayerNumber]+udg_PetDamage_Bonus[udg_PlayerNumber])
set udg_PlayerIndex=(100*udg_PlayerNumber)
if(Trig_Pet_Damage_Tooltip_Func010C())then
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_PetDamage)]="0%"
set udg_PetDamage_Total[udg_PlayerNumber]=0.00
else
if(Trig_Pet_Damage_Tooltip_Func010Func001C())then
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_PetDamage)]=(SubStringBJ(R2S(udg_PetDamage_Total[udg_PlayerNumber]),1,1)+"%")
else
if(Trig_Pet_Damage_Tooltip_Func010Func001Func001C())then
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_PetDamage)]=(SubStringBJ(R2S(udg_PetDamage_Total[udg_PlayerNumber]),1,2)+"%")
else
if(Trig_Pet_Damage_Tooltip_Func010Func001Func001Func003C())then
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_PetDamage)]=(SubStringBJ(R2S(udg_PetDamage_Total[udg_PlayerNumber]),1,3)+"%")
else
endif
endif
endif
endif
endfunction
function InitTrig_Pet_Damage_Tooltip takes nothing returns nothing
set gg_trg_Pet_Damage_Tooltip=CreateTrigger()
call TriggerAddAction(gg_trg_Pet_Damage_Tooltip,function Trig_Pet_Damage_Tooltip_Actions)
endfunction
