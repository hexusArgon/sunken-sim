endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Func002Func004C takes nothing returns boolean
if(not(RectContainsLoc(gg_rct_Demonic_Rune_4,udg_Inspect_Point)==true))then
return false
endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Func002Func013C takes nothing returns boolean
if(not(udg_DemonicRunes_Count==4))then
return false
endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Func002Func014C takes nothing returns boolean
if((RectContainsLoc(gg_rct_Demonic_Rune_1,udg_Inspect_Point)==true))then
return true
endif
if((RectContainsLoc(gg_rct_Demonic_Rune_2,udg_Inspect_Point)==true))then
return true
endif
if((RectContainsLoc(gg_rct_Demonic_Rune_3,udg_Inspect_Point)==true))then
return true
endif
if((RectContainsLoc(gg_rct_Demonic_Rune_4,udg_Inspect_Point)==true))then
return true
endif
return false
endfunction
function Trig_Explore_Ritual_Runes_Func002C takes nothing returns boolean
if(not Trig_Explore_Ritual_Runes_Func002Func014C())then
return false
endif
return true
endfunction
function Trig_Explore_Ritual_Runes_Actions takes nothing returns nothing
set udg_Inspect_Point=GetSpellTargetLoc()
if(Trig_Explore_Ritual_Runes_Func002C())then
if(Trig_Explore_Ritual_Runes_Func002Func001C())then
call MoveRectToLoc(gg_rct_Demonic_Rune_1,GetRectCenter(gg_rct_Dummies_Region))
else
endif
if(Trig_Explore_Ritual_Runes_Func002Func002C())then
call MoveRectToLoc(gg_rct_Demonic_Rune_2,GetRectCenter(gg_rct_Dummies_Region))
else
endif
if(Trig_Explore_Ritual_Runes_Func002Func003C())then
call MoveRectToLoc(gg_rct_Demonic_Rune_3,GetRectCenter(gg_rct_Dummies_Region))
else
endif
if(Trig_Explore_Ritual_Runes_Func002Func004C())then
call MoveRectToLoc(gg_rct_Demonic_Rune_4,GetRectCenter(gg_rct_Dummies_Region))
else
endif
call UnitDamageTargetBJ(gg_unit_negm_0344,GetTriggerUnit(),250.00,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
call AddSpecialEffectTargetUnitBJ("origin",GetTriggerUnit(),"Abilities\\Spells\\Other\\Stampede\\StampedeMissileDeath.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateTextTagLocBJ("TRIGSTR_4501",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),5.00)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),4.00)
set udg_DemonicRunes_Count=(udg_DemonicRunes_Count+1)
if(Trig_Explore_Ritual_Runes_Func002Func013C())then
call DisableTrigger(GetTriggeringTrigger())
call SetItemVisibleBJ(true,gg_item_I09H_0112)
call SetItemVisibleBJ(true,gg_item_iDNR_0109)
call SetItemVisibleBJ(true,gg_item_I0NR_0747)
else
endif
else
endif
call RemoveLocation(udg_Inspect_Point)
endfunction
