call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_TempPoint_DamageEngine)
call SetUnitPositionLoc(udg_SerpentStaff_TempUnit,udg_DummyDumping_Point)
call GroupRemoveUnitSimple(udg_SerpentStaff_TempUnit,udg_SerpentStaff_ActiveGroup[GetConvertedPlayerId(GetOwningPlayer(udg_SerpentStaff_TempUnit))])
call GroupAddUnitSimple(udg_SerpentStaff_TempUnit,udg_SerpentStaff_InactiveGroup[GetConvertedPlayerId(GetOwningPlayer(udg_SerpentStaff_TempUnit))])
call SetUnitLifePercentBJ(udg_SerpentStaff_TempUnit,100)
call UnitRemoveBuffsBJ(bj_REMOVEBUFFS_ALL,udg_SerpentStaff_TempUnit)
if(Trig_Lethal_Damage_Func010Func014C())then
call GroupRemoveUnitSimple(udg_SerpentStaff_TempUnit,udg_Summons_Group[GetConvertedPlayerId(GetOwningPlayer(udg_SerpentStaff_TempUnit))])
else
endif
call SetUnitInvulnerable(udg_DamageEventTarget,false)
else
endif
endfunction
function InitTrig_Lethal_Damage takes nothing returns nothing
set gg_trg_Lethal_Damage=CreateTrigger()
call h__TriggerRegisterVariableEvent(gg_trg_Lethal_Damage,"udg_LethalDamageEvent",EQUAL,1.00)
call TriggerAddAction(gg_trg_Lethal_Damage,function Trig_Lethal_Damage_Actions)
endfunction
