endif
if(Trig_Critical_Gain_Func009C())then
set udg_CriticalStrike_ChanceFlat[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]=(udg_CriticalStrike_ChanceFlat[GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))]+8.00)
