function Trig_Wrath_Yulon_Func006Func001C takes nothing returns boolean
if(not(IsUnitAlly(GetEnumUnit(),GetOwningPlayer(udg_Hero_Monk))==true))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_STRUCTURE)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_FLYING)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false))then
return false
endif
if(not(GetUnitTypeId(GetEnumUnit())!='H00P'))then
return false
endif
if(not(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetEnumUnit())>=5.00))then
return false
endif
if(not(udg_IsUnitAlive[GetUnitUserData(GetEnumUnit())]==true))then
return false
endif
return true
endfunction
