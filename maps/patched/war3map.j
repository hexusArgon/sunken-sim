function Trig_DCS_Core_Actions takes nothing returns nothing
set udg_DCS_UnitInt=GetUnitTypeId(udg_DCS_Unit)
set udg_DCS_AllItemDamage=0.00
set udg_DCS_TotalPrimAttributeCount=0
set udg_DCS_Damage=0.00
set udg_DCS_DamagePlusAtt=0.00
set udg_DCS_BaseDamage=LoadIntegerBJ(StringHashBJ("BaseDamage"),udg_DCS_UnitInt,udg_DCS_Hash)
set udg_DCS_Damage=(I2R(udg_DCS_BaseDamage)+1)
if(Trig_DCS_Core_Func009C())then
