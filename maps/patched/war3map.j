function Trig_Explore_Actions takes nothing returns nothing
set udg_Inspect_Point=GetSpellTargetLoc()
call CreateNUnitsAtLoc(1,'h01Z',GetOwningPlayer(GetTriggerUnit()),udg_Inspect_Point,bj_UNIT_FACING)
call UnitApplyTimedLifeBJ(5.00,'BTLF',GetLastCreatedUnit())
if(Trig_Explore_Func007C())then
if(Trig_Explore_Func007Func001C())then
call CreateTextTagLocBJ("TRIGSTR_6863",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),7.50)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),6.50)
else
endif
if(Trig_Explore_Func007Func002C())then
call CreateTextTagLocBJ("TRIGSTR_7313",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),5.50)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),4.50)
else
endif
if(Trig_Explore_Func007Func003C())then
call CreateTextTagLocBJ("TRIGSTR_7360",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),5.00)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),4.00)
else
endif
if(Trig_Explore_Func007Func004C())then
call CreateTextTagLocBJ("TRIGSTR_7409",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),9.00)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),8.00)
else
endif
if(Trig_Explore_Func007Func005C())then
call CreateTextTagLocBJ("TRIGSTR_7984",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),7.50)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),6.50)
