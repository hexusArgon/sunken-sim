function Trig_OnSpellcast_Heroes_Actions takes nothing returns nothing
set udg_AttackSpeed_Unit=GetTriggerUnit()
if(Trig_OnSpellcast_Heroes_Func004C())then
call ConditionalTriggerExecute(gg_trg_Attack_Speed_Tooltip)
else
endif
if(Trig_OnSpellcast_Heroes_Func006C())then
if(Trig_OnSpellcast_Heroes_Func006Func003C())then
set udg_ArmyOfTheDead_Casts=(udg_ArmyOfTheDead_Casts+1)
if(Trig_OnSpellcast_Heroes_Func006Func003Func002C())then
set udg_ArmyOfTheDead_Casts=0
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
set udg_ArmyDead_Point=PolarProjectionBJ(udg_Generic_Point,100.00,GetRandomReal(0,360.00))
if(Trig_OnSpellcast_Heroes_Func006Func003Func002Func005C())then
call CreateNUnitsAtLoc(1,'u007',GetOwningPlayer(GetTriggerUnit()),udg_ArmyDead_Point,GetUnitFacing(GetTriggerUnit()))
else
call CreateNUnitsAtLoc(1,'u00O',GetOwningPlayer(GetTriggerUnit()),udg_ArmyDead_Point,GetUnitFacing(GetTriggerUnit()))
endif
set udg_DCS_Unit=udg_Hero_DeathKnight
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
set udg_GetBaseDamage_Unit=GetLastCreatedUnit()
set udg_GetBaseDamage_Value=BlzGetUnitBaseDamage(udg_GetBaseDamage_Unit,0)
call BlzSetUnitBaseDamage(udg_GetBaseDamage_Unit,(udg_GetBaseDamage_Value+R2I((0.35*udg_DCS_Damage))),0)
call BlzSetUnitMaxHP(GetLastCreatedUnit(),(BlzGetUnitMaxHP(GetLastCreatedUnit())+R2I(((0.25*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_DeathKnight))*udg_BloodTap_Bonus))))
call SetUnitLifePercentBJ(GetLastCreatedUnit(),100)
