function s__StatisticPage_show takes integer this,player whichPlayer returns nothing
local integer playerNumber=GetPlayerId(whichPlayer)
local integer page=s__StatisticDashboard___pages[s__StatisticDashboard___selectedPage[playerNumber]]
if GetLocalPlayer()==whichPlayer then
call BlzFrameSetVisible(s__StatisticPage_pageParent[page],false)
call BlzFrameSetVisible(s__StatisticPage_pageParent[this],true)
call BlzFrameSetText(statisticPageNoDisplay,"Pages "+I2S(s__StatisticPage_index[this]+1))
call BlzFrameSetText(statisticSnapshotDisplay,s__StatisticDashboard___snapshotTitle[s__StatisticDashboard___selectedSnapshot[playerNumber]])
call sc__StatisticPage_updateUi(page)
endif
set s__StatisticDashboard___selectedPage[playerNumber]=s__StatisticPage_index[this]
endfunction
