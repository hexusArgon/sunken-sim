function Trig_BossCinematic_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisableTrigger(gg_trg_I_see_dead_players)
call DisableTrigger(gg_trg_Summon_Demons)
loop
exitwhen((udg_BossDoorOpening==true))
call TriggerSleepAction(RMaxBJ(bj_WAIT_FOR_COND_MIN_INTERVAL,0.50))
endloop
call ShowTextTagForceBJ(false,udg_DungeonName_DWB,GetPlayersAll())
call ShowTextTagForceBJ(false,udg_DungeonName_ST,GetPlayersAll())
call ShowTextTagForceBJ(false,udg_DungeonName_WW,GetPlayersAll())
call ShowTextTagForceBJ(false,udg_DungeonName_QT,GetPlayersAll())
call ShowTextTagForceBJ(false,udg_DungeonName_ZF,GetPlayersAll())
call ShowTextTagForceBJ(false,udg_DungeonName_GM,GetPlayersAll())
call SetTerrainFogExBJ(0,2000.00,3700.00,0,100,0.00,0.00)
call SetUnitOwner(gg_unit_n000_0055,Player(0),false)
call BlzEnableUIAutoPosition(true)
call CinematicModeBJ(true,GetPlayersAll())
call CinematicFadeBJ(bj_CINEFADETYPE_FADEOUTIN,3.00,"ReplaceableTextures\\CameraMasks\\Black_mask.blp",0,0,0,0)
call PolledWait(1.25)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CameraSetupApplyForPlayer(true,gg_cam_Final_Boss_Camera_1,ConvertedPlayer(GetForLoopIndexA()),0.00)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set udg_Generic_Point=GetRectCenter(gg_rct_AgilityHeroGo)
call SetUnitPositionLocFacingBJ(udg_Agi_Str_Int[1],udg_Generic_Point,90.00)
call RemoveLocation(udg_Generic_Point)
set udg_Generic_Point=GetRectCenter(gg_rct_StrengthHeroGo)
call SetUnitPositionLocFacingLocBJ(udg_Agi_Str_Int[2],GetRectCenter(gg_rct_StrengthHeroGo),udg_Generic_Point)
call RemoveLocation(udg_Generic_Point)
set udg_Generic_Point=GetRectCenter(gg_rct_IntelligenceHeroGo)
call SetUnitPositionLocFacingLocBJ(udg_Agi_Str_Int[3],GetRectCenter(gg_rct_IntelligenceHeroGo),udg_Generic_Point)
call RemoveLocation(udg_Generic_Point)
call EnableTrigger(gg_trg_Boss_Door_Close)
call EnableTrigger(gg_trg_Boss_Door)
call GroupAddUnitSimple(GroupPickRandomUnit(GetUnitsInRectMatching(gg_rct_CountDreadlords,Condition(function Trig_BossCinematic_Func029001001002))),udg_RandomUnitForCinematic)
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),GroupPickRandomUnit(udg_RandomUnitForCinematic),GetUnitName(GroupPickRandomUnit(udg_RandomUnitForCinematic)),null,"TRIGSTR_524",bj_TIMETYPE_SET,1.90,true)
call GroupClear(udg_RandomUnitForCinematic)
set udg_Generic_Point=GetRectCenter(gg_rct_AgilityHeroGo_Copy)
call IssuePointOrderLocBJ(udg_Agi_Str_Int[1],"move",udg_Generic_Point)
call RemoveLocation(udg_Generic_Point)
set udg_Generic_Point=GetRectCenter(gg_rct_StrengthHeroGo_Copy)
call IssuePointOrderLocBJ(udg_Agi_Str_Int[2],"move",udg_Generic_Point)
call RemoveLocation(udg_Generic_Point)
set udg_Generic_Point=GetRectCenter(gg_rct_IntelligenceHeroGo_Copy)
call IssuePointOrderLocBJ(udg_Agi_Str_Int[3],"move",udg_Generic_Point)
call RemoveLocation(udg_Generic_Point)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CameraSetupApplyForPlayer(true,gg_cam_Final_Boss_Camera_2,ConvertedPlayer(GetForLoopIndexA()),4.00)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call PolledWait(3.95)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call SetUnitFacingToFaceUnitTimed(udg_Agi_Str_Int[GetForLoopIndexA()],gg_unit_n000_0055,0.00)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CameraSetupApplyForPlayer(true,gg_cam_Final_Boss_Camera_3,ConvertedPlayer(GetForLoopIndexA()),5.00)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call SetUnitAnimation(gg_unit_n000_0055,"Spell Slam")
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_n000_0922,GetUnitName(gg_unit_n000_0055),null,"TRIGSTR_1322",bj_TIMETYPE_SET,5.00,true)
call ResetUnitAnimation(gg_unit_n000_0055)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
