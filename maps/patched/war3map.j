endif
if((GetOwningPlayer(GetTriggerUnit())==Player(PLAYER_NEUTRAL_AGGRESSIVE)))then
return true
endif
return false
endfunction
function Trig_Void_Sphere_Conditions takes nothing returns boolean
if(not(GetUnitAbilityLevelSwapped('A0KV',GetTriggerUnit())==0))then
return false
endif
if(not(IsUnitType(GetTriggerUnit(),UNIT_TYPE_MECHANICAL)==false))then
return false
endif
if(not(GetUnitStateSwap(UNIT_STATE_MAX_LIFE,GetTriggerUnit())>5.00))then
return false
endif
if(not(IsUnitIllusionBJ(GetTriggerUnit())==false))then
return false
endif
if(not Trig_Void_Sphere_Func005C())then
return false
endif
return true
endfunction
function Trig_Void_Sphere_Func008Func003C takes nothing returns boolean
if(not(udg_Drop_Chance>0.03))then
return false
endif
return true
endfunction
function Trig_Void_Sphere_Func008C takes nothing returns boolean
if(not(udg_Drop_Chance<=(0.03*udg_MagicFind_Multiplier)))then
return false
endif
return true
endfunction
function Trig_Void_Sphere_Actions takes nothing returns nothing
set udg_Generic_Point=GetUnitLoc(GetTriggerUnit())
set udg_Drop_Chance=GetRandomReal(0,100.00)
if(Trig_Void_Sphere_Func008C())then
call DisableTrigger(GetTriggeringTrigger())
call CreateItemLoc(udg_Item_Drops[12],udg_Generic_Point)
if(Trig_Void_Sphere_Func008Func003C())then
set udg_Dropped_Item=GetLastCreatedItem()
call TriggerExecute(gg_trg_Bonus_Drop)
else
endif
else
endif
call RemoveLocation(udg_Dying_unit)
endfunction
