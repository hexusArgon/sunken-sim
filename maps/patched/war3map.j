function Trig_DCS_Other_Damage_Sources_Actions takes nothing returns nothing
set udg_DCS_Damage=(udg_DCS_DamagePlusAtt+udg_DCS_AllItemDamage)
if(Trig_DCS_Other_Damage_Sources_Func006C())then
set udg_DCS_Damage=(udg_DCS_Damage+(2.00*I2R(GetPlayerTechCountSimple('R00D',GetOwningPlayer(udg_DCS_Unit)))))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func008C())then
set udg_DCS_Damage=(udg_DCS_Damage+I2R(udg_PoG_AD_Sum[GetConvertedPlayerId(GetOwningPlayer(udg_DCS_Unit))]))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func010C())then
set udg_DCS_Damage=(udg_DCS_Damage+(2.00*I2R(GetPlayerTechCountSimple('R002',GetOwningPlayer(udg_DCS_Unit)))))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func012C())then
set udg_DCS_Damage=(udg_DCS_Damage+(5.00+(3.00*I2R(GetPlayerTechCountSimple('R00K',GetOwningPlayer(udg_DCS_Unit))))))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func014C())then
set udg_DCS_Damage=(udg_DCS_Damage+I2R(udg_Trophies_Total))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func016C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.15))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func018C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.15))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func020C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_DamagePlusAtt*0.20))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func022C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.50))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func024C())then
if(Trig_DCS_Other_Damage_Sources_Func024Func001C())then
set udg_Berserk_Damage=(0.15+(0.05*I2R(GetUnitAbilityLevelSwapped('A0CN',udg_Hero_FeralDruid))))
if(Trig_DCS_Other_Damage_Sources_Func024Func001Func003C())then
set udg_Berserk_Damage=(udg_Berserk_Damage+0.15)
else
endif
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*udg_Berserk_Damage))
else
endif
else
endif
if(Trig_DCS_Other_Damage_Sources_Func026C())then
set udg_DCS_Damage=(udg_DCS_Damage+I2R((udg_Tornado_Stacks*(1+(1*GetUnitAbilityLevelSwapped('A092',udg_Hero_Windmaster))))))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func028C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.30))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func030C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.20))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func032C())then
if(Trig_DCS_Other_Damage_Sources_Func032Func001C())then
set udg_DCS_Damage=(udg_DCS_Damage+((0.35+(0.05*I2R(GetUnitAbilityLevelSwapped('A03X',udg_DCS_Unit))))*udg_DCS_Damage))
else
set udg_DCS_Damage=(udg_DCS_Damage+((0.20+(0.05*I2R(GetUnitAbilityLevelSwapped('A03X',udg_DCS_Unit))))*udg_DCS_Damage))
endif
else
endif
if(Trig_DCS_Other_Damage_Sources_Func034C())then
set udg_DCS_Damage=(udg_DCS_Damage+15.00)
else
endif
if(Trig_DCS_Other_Damage_Sources_Func036C())then
if(Trig_DCS_Other_Damage_Sources_Func036Func001C())then
set udg_DCS_Damage=(udg_DCS_Damage+(15.00+(20.00*I2R(GetUnitAbilityLevelSwapped('A0E9',udg_Hero_Warrior)))))
else
set udg_DCS_Damage=(udg_DCS_Damage+(10.00+(15.00*I2R(GetUnitAbilityLevelSwapped('A0E9',udg_Hero_Warrior)))))
endif
else
endif
if(Trig_DCS_Other_Damage_Sources_Func038C())then
set udg_DCS_Damage=(udg_DCS_Damage+(0.20*udg_DCS_Damage))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func040C())then
set udg_DCS_Damage=(udg_DCS_Damage+((0.30+(0.05*I2R(GetUnitAbilityLevelSwapped('A0E2',udg_DCS_Unit))))*udg_DCS_Damage))
else
endif
if(Trig_DCS_Other_Damage_Sources_Func042C())then
set udg_DCS_Damage=(udg_DCS_Damage+15.00)
else
if(Trig_DCS_Other_Damage_Sources_Func042Func001C())then
set udg_DCS_Damage=(udg_DCS_Damage+30.00)
else
if(Trig_DCS_Other_Damage_Sources_Func042Func001Func001C())then
set udg_DCS_Damage=(udg_DCS_Damage+45.00)
else
endif
endif
endif
if(Trig_DCS_Other_Damage_Sources_Func044C())then
if(Trig_DCS_Other_Damage_Sources_Func044Func001C())then
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.20))
else
set udg_DCS_Damage=(udg_DCS_Damage+(udg_DCS_Damage*0.30))
endif
