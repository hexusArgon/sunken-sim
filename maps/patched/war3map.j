function Trig_Global_CDs_Func003Func001C takes nothing returns boolean
if(not(udg_Ability_Str[udg_CDR_AbilityArray]!=udg_CDR_AbilityCast))then
return false
endif
if(not(GetUnitAbilityLevelSwapped(udg_Ability_Str[udg_CDR_AbilityArray],udg_CDR_Unit)>=1))then
return false
endif
if(not(BlzGetUnitAbilityCooldownRemaining(udg_CDR_Unit,udg_Ability_Str[udg_CDR_AbilityArray])<udg_Monk_GCD))then
return false
endif
return true
endfunction
function Trig_Global_CDs_Actions takes nothing returns nothing
if(Trig_Global_CDs_Func001C())then
set udg_Monk_GCD=1.00
else
set udg_Monk_GCD=1.50
endif
set udg_Monk_GCD=(udg_Monk_GCD/(1+udg_CDR[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Monk))]))
set udg_CDR_AbilityArray=1
loop
exitwhen udg_CDR_AbilityArray>6
if(Trig_Global_CDs_Func003Func001C())then
call BlzStartUnitAbilityCooldown(udg_CDR_Unit,udg_Ability_Str[udg_CDR_AbilityArray],udg_Monk_GCD)
else
endif
set udg_CDR_AbilityArray=udg_CDR_AbilityArray+1
endloop
endfunction
