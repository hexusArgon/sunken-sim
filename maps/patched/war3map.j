function Trig_Serpent_Sting_Periodic_Func010A takes nothing returns nothing
if(Trig_Serpent_Sting_Periodic_Func010Func001C())then
call UnitDamageTargetBJ(udg_Dummies_SerpentSting,GetEnumUnit(),udg_SerpentSting_PeriodicDmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
else
set udg_NextDamageType=udg_DamageTypePhysical
call UnitDamageTargetBJ(udg_Hero_Hunter,GetEnumUnit(),udg_SerpentSting_PeriodicDmg,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
endif
if(Trig_Serpent_Sting_Periodic_Func010Func002C())then
set udg_CDR_AbilityArray=1
loop
exitwhen udg_CDR_AbilityArray>9
set udg_CD_Dynamic_Hero=udg_Hero_Hunter
set udg_CD_Dynamic_Ability=udg_Ability_Agi[udg_CDR_AbilityArray]
set udg_CD_Dynamic=BlzGetUnitAbilityCooldownRemaining(udg_CD_Dynamic_Hero,udg_CD_Dynamic_Ability)
set udg_CD_Dynamic_Reduction=1.00
call ConditionalTriggerExecute(gg_trg_Dynamic_CDR)
set udg_CDR_AbilityArray=udg_CDR_AbilityArray+1
endloop
else
endif
endfunction
