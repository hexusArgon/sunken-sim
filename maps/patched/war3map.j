function InitTrig_Specialization_Change takes nothing returns nothing
set gg_trg_Specialization_Change=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Specialization_Change,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Specialization_Change,Condition(function Trig_Specialization_Change_Conditions))
call TriggerAddAction(gg_trg_Specialization_Change,function Trig_Specialization_Change_Actions)
endfunction
function Trig_Attribute_Bonus_Func001C takes nothing returns boolean
if((GetLearnedSkillBJ()=='A0F6'))then
return true
endif
if((GetLearnedSkillBJ()=='A0PV'))then
return true
endif
if((GetLearnedSkillBJ()=='A0PU'))then
return true
endif
if((GetLearnedSkillBJ()=='A0PW'))then
return true
endif
return false
endfunction
function Trig_Attribute_Bonus_Conditions takes nothing returns boolean
if(not Trig_Attribute_Bonus_Func001C())then
return false
endif
return true
endfunction
function Trig_Attribute_Bonus_Actions takes nothing returns nothing
set udg_ESC_Points[GetConvertedPlayerId(GetTriggerPlayer())]=(udg_ESC_Points[GetConvertedPlayerId(GetTriggerPlayer())]+2)
call DisplayTextToForce(GetForceOfPlayer(GetTriggerPlayer()),"TRIGSTR_11291")
endfunction
