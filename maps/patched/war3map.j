function Trig_Armor_Button_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetTriggerPlayer())
if(Trig_Armor_Button_Func003C())then
if(Trig_Armor_Button_Func003Func001C())then
else
set udg_GenericPlayerGroup=GetForceOfPlayer(GetTriggerPlayer())
call QuestMessageBJ(udg_GenericPlayerGroup,bj_QUESTMESSAGE_WARNING,"TRIGSTR_7181")
call DestroyForce(udg_GenericPlayerGroup)
return
endif
if(Trig_Armor_Button_Func003Func002C())then
call BlzSetUnitArmor(udg_Agi_Str_Int[1],(BlzGetUnitArmor(udg_Agi_Str_Int[1])+0.50))
else
if(Trig_Armor_Button_Func003Func002Func001C())then
call BlzSetUnitArmor(udg_Agi_Str_Int[2],(BlzGetUnitArmor(udg_Agi_Str_Int[2])+0.50))
else
if(Trig_Armor_Button_Func003Func002Func001Func001C())then
call BlzSetUnitArmor(udg_Agi_Str_Int[3],(BlzGetUnitArmor(udg_Agi_Str_Int[3])+0.50))
else
endif
endif
endif
set udg_ESC_Points[udg_PlayerNumber]=(udg_ESC_Points[udg_PlayerNumber]-1)
set udg_ESC_Points_Armor[udg_PlayerNumber]=(udg_ESC_Points_Armor[udg_PlayerNumber]+1)
else
set udg_GenericPlayerGroup=GetForceOfPlayer(GetTriggerPlayer())
call TriggerExecute(gg_trg_Warning_No_Stat_Points)
call DestroyForce(udg_GenericPlayerGroup)
return
endif
endfunction
