call TriggerRegisterUnitEvent(s__StatisticPlayer_updateGlyphTrigOnDrop[this],s__StatisticPlayer_glyphUnit[this],EVENT_UNIT_DROP_ITEM)
call TriggerAddAction(s__StatisticPlayer_updateGlyphTrigOnPickup[this],function sc__StatisticPlayer_updateGlyphOnPickUp)
call TriggerAddAction(s__StatisticPlayer_updateGlyphTrigOnDrop[this],function sc__StatisticPlayer_updateGlyphOnDrop)
endfunction
function s__StatisticPlayer_bindHero takes integer this,unit heroU returns nothing
set s__StatisticPlayer_hero[this]=heroU
