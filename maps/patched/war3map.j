call PauseUnitBJ(false,gg_unit_h00E_0741)
call SetUnitInvulnerable(gg_unit_h00E_0741,false)
call ShowUnitShow(gg_unit_h00E_0741)
call IssueImmediateOrderBJ(gg_unit_h00E_0741,"stop")
call AddSpecialEffectTargetUnitBJ("origin",gg_unit_h00E_0741,"Abilities\\Spells\\Other\\TalkToMe\\TalkToMe.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call TransmissionFromUnitWithNameBJ(GetPlayersAll(),gg_unit_h00E_0741,"TRIGSTR_9446",gg_snd_NagaMyrmadonPissed1,"TRIGSTR_9457",bj_TIMETYPE_SET,5.00,false)
