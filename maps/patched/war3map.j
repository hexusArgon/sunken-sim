function TasItemCost___ClearItem takes nothing returns nothing
call RemoveItem(GetEnumItem())
endfunction
function TasItemCost___ClearItemStart takes nothing returns nothing
call EnumItemsInRect(TasItemCost___shopRect,null,function TasItemCost___ClearItem)
endfunction
function TasItemCost___TasItemCalcDestroy takes nothing returns nothing
call EnumItemsInRect(TasItemCost___shopRect,null,function TasItemCost___ClearItem)
call ShowUnit(TasItemCost___shop,true)
call RemoveUnit(TasItemCost___shop)
call RemoveRect(TasItemCost___shopRect)
endfunction
function TasItemCost___Start takes nothing returns nothing
local integer itemCode=TasItemCost___Test[1]
local integer gold
local integer lumber
local item i
call AddItemToStock(TasItemCost___shop,itemCode,1,1)
call SetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_GOLD,99999999)
call SetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_LUMBER,99999999)
set gold=GetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_GOLD)
set lumber=GetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_LUMBER)
call IssueNeutralImmediateOrderById(TasItemCost___shopOwner,TasItemCost___shop,itemCode)
call SaveInteger(TasItemHash,itemCode,TasItemCost___HASH_GOLD,gold-GetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_GOLD))
call SaveInteger(TasItemHash,itemCode,TasItemCost___HASH_LUMBER,lumber-GetPlayerState(TasItemCost___shopOwner,PLAYER_STATE_RESOURCE_LUMBER))
set i=CreateItem(itemCode,0,0)
call SaveInteger(TasItemHash,itemCode,TasItemCost___HASH_CHARGE,GetItemCharges(i))
call RemoveItem(i)
set i=null
call RemoveItemFromStock(TasItemCost___shop,itemCode)
set TasItemCost___Test[1]=TasItemCost___Test[TasItemCost___TestCount]
set TasItemCost___TestCount=TasItemCost___TestCount-1
call EnumItemsInRect(TasItemCost___shopRect,null,function TasItemCost___ClearItem)
if TasItemCost___TestCount>0 then
call TasItemCost___Start()
else
endif
endfunction
function TasItemCaclCost takes integer itemCode returns nothing
local item i
if not HaveSavedInteger(TasItemHash,itemCode,TasItemCost___HASH_GOLD)then
set i=CreateItem(itemCode,0,0)
if GetHandleId(i)>0 then
call RemoveItem(i)
set TasItemCost___TestCount=TasItemCost___TestCount+1
set TasItemCost___Test[TasItemCost___TestCount]=itemCode
endif
if TasItemCost___TestCount>0 then
call TasItemCost___Start()
endif
set i=null
endif
endfunction
function TasItemGetCostGold takes integer itemCode returns integer
call TasItemCaclCost(itemCode)
return LoadInteger(TasItemHash,itemCode,TasItemCost___HASH_GOLD)
endfunction
function TasItemGetCostLumber takes integer itemCode returns integer
call TasItemCaclCost(itemCode)
return LoadInteger(TasItemHash,itemCode,TasItemCost___HASH_LUMBER)
endfunction
function TasItemGetCharges takes integer itemCode returns integer
call TasItemCaclCost(itemCode)
return LoadInteger(TasItemHash,itemCode,TasItemCost___HASH_CHARGE)
endfunction
function s__TasItemCost___S_TasItemCost___Init___onInit takes nothing returns nothing
set TasItemCost___shopRect=Rect(0,0,TasItemCost___shopRectSize,TasItemCost___shopRectSize)
set TasItemCost___shop=CreateUnit(TasItemCost___shopOwner,'nmrk',TasItemCost___shopRectX,TasItemCost___shopRectY,0)
call SetUnitX(TasItemCost___shop,TasItemCost___shopRectX)
call SetUnitY(TasItemCost___shop,TasItemCost___shopRectY)
call MoveRectTo(TasItemCost___shopRect,TasItemCost___shopRectX,TasItemCost___shopRectY)
call UnitAddAbility(TasItemCost___shop,'AInv')
call IssueNeutralTargetOrder(TasItemCost___shopOwner,TasItemCost___shop,"smart",TasItemCost___shop)
call ShowUnit(TasItemCost___shop,false)
endfunction
function hideUIWhenShopDisplayChange takes boolean flag returns nothing
call BlzFrameSetVisible(dpsPanel,not flag)
call MultiboardDisplay(udg_Main_Board,not flag)
endfunction
function playEffect takes unit u,string effectPath returns nothing
local effect specialEffect=AddSpecialEffectTarget(effectPath,u,"origin")
call DestroyEffect(specialEffect)
endfunction
function playSoundAndEffectOnBuy takes unit u returns nothing
call playEffect(u,TasItemShopExtension_buyEffectDisplay)
endfunction
function playSoundAndEffectOnSell takes unit u returns nothing
local sound playSound=CreateSound(TasItemShopExtension_sellSound,false,true,true,12700,12700,"")
call playEffect(u,TasItemShopExtension_sellEffectDisplay)
call AttachSoundToUnit(playSound,u)
call StartSound(playSound)
call KillSoundWhenDone(playSound)
set playSound=null
endfunction
function RemoveBTag takes string name returns string
local integer i=StringLength(name)
loop
set i=i-1
exitwhen i<0
if SubString(name,i,i+1)=="#" then
return SubString(name,0,i)
endif
endloop
return name
endfunction
function pad3 takes integer value returns string
local string s=I2S(value)
if StringLength(s)==1 then
return"00"+s
elseif StringLength(s)==2 then
return"0"+s
endif
return s
endfunction
function GetSpacedNumber takes real number returns string
local integer n=R2I(number)
local integer millions
local integer thousands
local integer remainder
if n>=1000000 then
set millions=n/ 1000000
set thousands=ModuloInteger(n/ 1000,1000)
set remainder=ModuloInteger(n,1000)
return I2S(millions)+" "+pad3(thousands)+" "+pad3(remainder)
endif
if n>=1000 then
set thousands=n/ 1000
set remainder=ModuloInteger(n,1000)
return I2S(thousands)+" "+pad3(remainder)
endif
return I2S(n)
endfunction
function maxBetweenThreeValues takes real a,real b,real c returns integer
local integer ia=R2I(a)
local integer ib=R2I(b)
local integer ic=R2I(c)
if ia>=ib and ia>=ic then
return 0
elseif ib>=ic then
return 1
endif
return 2
endfunction
function createPushedButton takes string icon,string frameName,framehandle parent,integer index returns framehandle
local framehandle buttonParent=BlzCreateFrameByType("GLUETEXTBUTTON",frameName,parent,"ScriptDialogButton",index)
local framehandle iconFrame=BlzFrameGetChild(buttonParent,0)
local framehandle pushedFrame=BlzFrameGetChild(buttonParent,1)
local framehandle disabledFrame=BlzFrameGetChild(buttonParent,2)
call BlzFrameSetTexture(iconFrame,icon,0,true)
call BlzFrameSetTexture(pushedFrame,icon,0,true)
call BlzFrameSetTexture(disabledFrame,icon,0,true)
call BlzFrameClearAllPoints(pushedFrame)
call BlzFrameSetPoint(pushedFrame,FRAMEPOINT_BOTTOMLEFT,buttonParent,FRAMEPOINT_BOTTOMLEFT,0.005,0.005)
call BlzFrameSetPoint(pushedFrame,FRAMEPOINT_TOPRIGHT,buttonParent,FRAMEPOINT_TOPRIGHT,-0.005,-0.005)
