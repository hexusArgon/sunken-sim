function Trig_Windstorm_Damage_Actions takes nothing returns nothing
if(Trig_Windstorm_Damage_Func001C())then
set udg_Generic_Point=GetUnitLoc(udg_Hero_Windmaster)
set udg_Generic_Group=GetUnitsInRangeOfLocMatching(275.00,udg_Generic_Point,Condition(function Trig_Windstorm_Damage_Func001Func002002003))
call ForGroupBJ(udg_Generic_Group,function Trig_Windstorm_Damage_Func001Func003A)
call RemoveLocation(udg_Generic_Point)
call DestroyGroup(udg_Generic_Group)
else
call PauseTimerBJ(true,udg_Windstorm_Timer)
call SetPlayerAbilityAvailableBJ(true,'A092',GetOwningPlayer(udg_Hero_Windmaster))
call SetPlayerAbilityAvailableBJ(true,'A0KT',GetOwningPlayer(udg_Hero_Windmaster))
call SetPlayerAbilityAvailableBJ(true,'A01T',GetOwningPlayer(udg_Hero_Windmaster))
endif
endfunction
