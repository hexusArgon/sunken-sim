function InitTrig_Initialization_Items takes nothing returns nothing
set gg_trg_Initialization_Items=CreateTrigger()
call TriggerAddAction(gg_trg_Initialization_Items,function Trig_Initialization_Items_Actions)
endfunction
function Trig_Initialization_Units_Func009Func001A takes nothing returns nothing
call SetPlayerAllianceBJ(GetEnumPlayer(),ALLIANCE_SHARED_ADVANCED_CONTROL,true,ConvertedPlayer(udg_Alliance_Loop))
call SetPlayerAllianceBJ(GetEnumPlayer(),ALLIANCE_SHARED_CONTROL,false,ConvertedPlayer(udg_Alliance_Loop))
endfunction
function Trig_Initialization_Units_Func147Func001C takes nothing returns boolean
if(not(GetUnitTypeId(GetEnumUnit())=='n02R'))then
return false
endif
return true
endfunction
function Trig_Initialization_Units_Func147A takes nothing returns nothing
if(Trig_Initialization_Units_Func147Func001C())then
call SetResourceAmount(GetEnumUnit(),0)
else
endif
endfunction
function Trig_Initialization_Units_Func179Func001C takes nothing returns boolean
if(not(GetUnitTypeId(GetEnumUnit())=='h02E'))then
return false
endif
return true
endfunction
function Trig_Initialization_Units_Func179Func002C takes nothing returns boolean
