call QueuedTriggerAddBJ(gg_trg_Tutorial_Resurrection_Stone,true)
set udg_ResStone_Boo[GetForLoopIndexA()]=true
set udg_ResStone_Point=GetUnitLoc(udg_ResStone[GetForLoopIndexA()])
call AddUnitAnimationPropertiesBJ(true,"alternate",udg_ResStone[GetForLoopIndexA()])
call AddSpecialEffectLocBJ(udg_ResStone_Point,"Abilities\\Spells\\Items\\TomeOfRetraining\\TomeOfRetrainingCaster.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ('Ane2',udg_ResStone[GetForLoopIndexA()])
call UnitAddAbilityBJ('ACnr',udg_ResStone[GetForLoopIndexA()])
call UnitAddAbilityBJ('ANre',udg_ResStone[GetForLoopIndexA()])
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=udg_ResStones_Total
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
if(Trig_Ress_Stones_Func003Func001Func001Func002Func010Func001C())then
set udg_ResStone_Boo[GetForLoopIndexB()]=false
call AddUnitAnimationPropertiesBJ(false,"alternate",udg_ResStone[GetForLoopIndexB()])
call UnitRemoveAbilityBJ('Ane2',udg_ResStone[GetForLoopIndexB()])
call UnitRemoveAbilityBJ('ACnr',udg_ResStone[GetForLoopIndexB()])
call UnitRemoveAbilityBJ('ANre',udg_ResStone[GetForLoopIndexB()])
else
endif
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call ForGroupBJ(udg_ResStone_GroupVis,function Trig_Ress_Stones_Func003Func001Func001Func002Func011A)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
call CreateNUnitsAtLoc(1,'h01N',ConvertedPlayer(GetForLoopIndexA()),udg_ResStone_Point,bj_UNIT_FACING)
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_ResStone_GroupVis)
call SetUnitPositionLoc(GetLastCreatedUnit(),udg_ResStone_Point)
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
call RemoveLocation(udg_ResStone_Point)
else
endif
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endfunction
