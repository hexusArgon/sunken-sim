function Trig_DK_Fix_1_Func003Func008C takes nothing returns boolean
if(not(IsUnitAlly(GetEnumUnit(),Player(0))==true))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_STRUCTURE)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_FLYING)==false))then
return false
endif
if(not(IsUnitType(GetEnumUnit(),UNIT_TYPE_MAGIC_IMMUNE)==false))then
return false
endif
if(not(udg_DeathCheck_Alive==true))then
return false
endif
return true
endfunction
function Trig_DK_Fix_1_Func003A takes nothing returns nothing
set udg_DeathCheck_Unit=GetEnumUnit()
if GetUnitTypeId(udg_DeathCheck_Unit)==0 or IsUnitType(udg_DeathCheck_Unit,UNIT_TYPE_DEAD)then
set udg_DeathCheck_Alive=false
else
set udg_DeathCheck_Alive=true
endif
if(Trig_DK_Fix_1_Func003Func008C())then
call UnitDamageTargetBJ(gg_unit_negm_0344,GetEnumUnit(),10000.00,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_MAGIC)
set udg_Generic_Point=GetRectCenter(gg_rct_DK_Explosion_1)
call AddSpecialEffectLocBJ(udg_Generic_Point,"Objects\\Spawnmodels\\Human\\HCancelDeath\\HCancelDeath.mdl")
call BlzSetSpecialEffectScale(GetLastCreatedEffectBJ(),2.50)
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_Generic_Point)
else
endif
endfunction
