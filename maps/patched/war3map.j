set udg_Dummies_ChainLightning=GetLastCreatedUnit()
call CreateNUnitsAtLoc(1,'n064',GetOwningPlayer(udg_Hero_Shaman),udg_Generic_Point,bj_UNIT_FACING)
set udg_Dummies_ChainHeal=GetLastCreatedUnit()
call CreateNUnitsAtLoc(1,'n02O',GetOwningPlayer(udg_Hero_Shaman),udg_Generic_Point,bj_UNIT_FACING)
set udg_Dummies_LavaBurst=GetLastCreatedUnit()
