function InitTrig_Mastery_Gain takes nothing returns nothing
set gg_trg_Mastery_Gain=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Mastery_Gain,EVENT_PLAYER_UNIT_PICKUP_ITEM)
call TriggerAddCondition(gg_trg_Mastery_Gain,Condition(function Trig_Mastery_Gain_Conditions))
call TriggerAddAction(gg_trg_Mastery_Gain,function Trig_Mastery_Gain_Actions)
endfunction
