function Trig_Burnout_B_Actions takes nothing returns nothing
set udg_I=1
loop
exitwhen udg_I>udg_I_CastNumber
if(Trig_Burnout_B_Func001Func001C())then
set udg_I_Point[0]=GetUnitLoc(udg_Hero_DragonSentinel)
set udg_I_Distance[udg_I]=(udg_I_Distance[udg_I]+udg_I_Speed[udg_I])
set udg_I_Arc[udg_I]=(((4.00*udg_I_Offset[udg_I])/ udg_I_ConstDistance[udg_I])*((udg_I_ConstDistance[udg_I]-udg_I_Distance[udg_I])*(udg_I_Distance[udg_I]/ udg_I_ConstDistance[udg_I])))
set udg_I_Point[2]=GetUnitLoc(udg_Dummies_BurnoutPoint)
set udg_I_Point[3]=PolarProjectionBJ(udg_I_Point[2],udg_I_Distance[udg_I],udg_I_Angle[udg_I])
set udg_I_Point[4]=PolarProjectionBJ(udg_I_Point[3],udg_I_Arc[udg_I],(udg_I_Angle[udg_I]+45.00))
set udg_I_Point[5]=PolarProjectionBJ(udg_I_Point[3],udg_I_Arc[udg_I],(udg_I_Angle[udg_I]-45.00))
call SetUnitPositionLocFacingBJ(udg_I_Missile1[udg_I],udg_I_Point[4],udg_I_Angle[udg_I])
call SetUnitPositionLocFacingBJ(udg_I_Missile2[udg_I],udg_I_Point[5],udg_I_Angle[udg_I])
call AddSpecialEffectLocBJ(udg_I_Point[4],"Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call AddSpecialEffectLocBJ(udg_I_Point[5],"Abilities\\Weapons\\FireBallMissile\\FireBallMissile.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
if(Trig_Burnout_B_Func001Func001Func021C())then
set udg_I_Off[udg_I]=false
set udg_I_Point[6]=GetUnitLoc(udg_I_Missile1[udg_I])
set udg_I_Group=GetUnitsInRangeOfLocMatching(200.00,udg_I_Point[6],Condition(function Trig_Burnout_B_Func001Func001Func021Func007002003))
if(Trig_Burnout_B_Func001Func001Func021Func008C())then
call AddSpecialEffectLocBJ(udg_I_Point[6],"Abilities\\Weapons\\SteamTank\\SteamTankImpact.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call SetUnitPositionLocFacingBJ(udg_I_Caster[udg_I],udg_I_Point[6],udg_I_Angle[udg_I])
else
endif
call ForGroupBJ(udg_I_Group,function Trig_Burnout_B_Func001Func001Func021Func009A)
call RemoveLocation(udg_I_Point[6])
call DestroyGroup(udg_I_Group)
call SetUnitPositionLoc(udg_I_Missile1[udg_I_CastNumber],udg_DummyDumping_Point)
call SetUnitPositionLoc(udg_I_Missile2[udg_I_CastNumber],udg_DummyDumping_Point)
set udg_I_Switch=(udg_I_Switch-1)
if(Trig_Burnout_B_Func001Func001Func021Func019C())then
set udg_I_CastNumber=0
call DisableTrigger(gg_trg_Burnout_B)
else
endif
else
endif
call RemoveLocation(udg_I_Point[0])
call RemoveLocation(udg_I_Point[2])
call RemoveLocation(udg_I_Point[3])
call RemoveLocation(udg_I_Point[4])
call RemoveLocation(udg_I_Point[5])
else
endif
set udg_I=udg_I+1
endloop
