endif
endif
set udg_Attribute_Index=udg_Attribute_Index+1
endloop
if(Trig_Healing_Power_Tooltip_Func010Func002C())then
set udg_HealingPower_Bonus[udg_PlayerNumber]=(udg_HealingPower_Bonus[udg_PlayerNumber]+20)
else
endif
else
endif
if(Trig_Healing_Power_Tooltip_Func011C())then
set udg_Attribute_Index=1
loop
exitwhen udg_Attribute_Index>3
if(Trig_Healing_Power_Tooltip_Func011Func001Func001C())then
