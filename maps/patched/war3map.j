function Trig_Acquisition_Actions takes nothing returns nothing
if(Trig_Acquisition_Func001C())then
call DisableTrigger(GetTriggeringTrigger())
set udg_PoG_Restriction_Item=GetItemTypeId(GetManipulatedItem())
call RemoveItem(GetManipulatedItem())
if(Trig_Acquisition_Func001Func004C())then
call AdjustPlayerStateBJ(1100,GetOwningPlayer(GetTriggerUnit()),PLAYER_STATE_RESOURCE_GOLD)
set udg_GenericPlayerGroup=GetForceOfPlayer(GetOwningPlayer(GetTriggerUnit()))
call QuestMessageBJ(udg_GenericPlayerGroup,bj_QUESTMESSAGE_WARNING,"TRIGSTR_6453")
call DestroyForce(udg_GenericPlayerGroup)
call EnableTrigger(GetTriggeringTrigger())
return
else
call UnitAddItemByIdSwapped(udg_PoG_Restriction_Item,GetTriggerUnit())
call EnableTrigger(GetTriggeringTrigger())
endif
set udg_PoG_Loop=1
loop
exitwhen udg_PoG_Loop>6
if(Trig_Acquisition_Func001Func006Func001C())then
call UnitRemoveItemSwapped(UnitItemInSlotBJ(GetTriggerUnit(),udg_PoG_Loop),GetTriggerUnit())
else
endif
set udg_PoG_Loop=udg_PoG_Loop+1
endloop
