function Trig_Taunting_Actions takes nothing returns nothing
if(Trig_Taunting_Func001C())then
if(Trig_Taunting_Func001Func001C())then
else
if(Trig_Taunting_Func001Func001Func001C())then
set udg_Taunt_Taunter[GetUnitUserData(udg_Taunt_Target)]=udg_Taunt_Attempter
else
return
endif
endif
set udg_Taunt_Length[GetUnitUserData(udg_Taunt_Target)]=(udg_Taunt_Length[GetUnitUserData(udg_Taunt_Target)]+udg_Taunt_Duration)
