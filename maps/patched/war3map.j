function Trig_Healing_Power_Tooltip_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_HealingPower_Hero))
set udg_HealingPower_Bonus[udg_PlayerNumber]=0
if(Trig_Healing_Power_Tooltip_Func004C())then
set udg_HealingPower_Bonus[udg_PlayerNumber]=(udg_HealingPower_Bonus[udg_PlayerNumber]+(5+R2I((0.02*GetUnitStateSwap(UNIT_STATE_MANA,udg_Hero_Siren)))))
else
endif
if(Trig_Healing_Power_Tooltip_Func005C())then
set udg_HealingPower_Bonus[udg_PlayerNumber]=(udg_HealingPower_Bonus[udg_PlayerNumber]+(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Paladin,true)/ 3))
else
endif
if(Trig_Healing_Power_Tooltip_Func006C())then
set udg_InnerHarmony_Attribute=IMinBJ(GetHeroStatBJ(bj_HEROSTAT_STR,udg_Hero_Monk,true),IMinBJ(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_Monk,true),GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Monk,true)))
set udg_HealingPower_Bonus[udg_PlayerNumber]=(udg_HealingPower_Bonus[udg_PlayerNumber]+(udg_InnerHarmony_Attribute/ 5))
else
