set udg_ArcaneMaster_Chance=(udg_ArcaneMaster_Chance*0.75)
else
endif
if(Trig_Arcane_Spell_Mastery_Func013C())then
else
return
endif
call PolledWait(0.08)
call BlzEndUnitAbilityCooldown(l__udg_Hero_Mage,l__udg_ArcaneMaster_Ability)
