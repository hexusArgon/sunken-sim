call SetTextTagLifespanBJ(GetLastCreatedTextTag(),2.50)
if(Trig_Show_Dialog_Func023Func005Func008C())then
call AddSpecialEffectTargetUnitBJ("origin",udg_PoG_GoldHero,"Abilities\\Spells\\Other\\Transmute\\PileofGold.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
else
endif
endfunction
function Trig_Show_Dialog_Func023C takes nothing returns boolean
if(not(udg_PoG_Item_Tag!=udg_ItemTag_Materialized_100))then
return false
endif
if(not(udg_PoG_Item_Tag!=udg_ItemTag_Reforged))then
return false
endif
return true
endfunction
function Trig_Show_Dialog_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(GetTriggerUnit()))
set udg_PoG_Hero[udg_PlayerNumber]=GetTriggerUnit()
set udg_PoG_ItemToDisenchant=UnitItemInSlotBJ(GetTriggerUnit(),1)
set udg_PoG_Item_Tag=GetItemUserData(udg_PoG_ItemToDisenchant)
set udg_PoG_DisenchantedTier=udg_PoG_TierNone
set udg_PoG_Loop=1
loop
exitwhen udg_PoG_Loop>udg_Drops_UncommonUnique
if(Trig_Show_Dialog_Func006Func001C())then
set udg_PoG_MaxRoll=udg_PoG_UncommonMax
set udg_PoG_MaxSlots[udg_PlayerNumber]=3
set udg_PoG_DisenchantedTier=udg_PoG_TierUncommon
call RemoveItem(udg_PoG_ItemToDisenchant)
set udg_PoG_DisenchantedUncommons[udg_PlayerNumber]=(udg_PoG_DisenchantedUncommons[udg_PlayerNumber]+1)
else
endif
set udg_PoG_Loop=udg_PoG_Loop+1
endloop
set udg_PoG_Loop=1
loop
exitwhen udg_PoG_Loop>udg_Drops_RareUnique
if(Trig_Show_Dialog_Func007Func001C())then
set udg_PoG_MaxRoll=udg_PoG_RareMax
set udg_PoG_MaxSlots[udg_PlayerNumber]=4
set udg_PoG_DisenchantedTier=udg_PoG_TierRare
call RemoveItem(udg_PoG_ItemToDisenchant)
