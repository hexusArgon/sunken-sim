set udg_HP_Talents[19]='I0IT'
set udg_HP_Talents[20]='I0MC'
set udg_Ability_Q[hp_s]='A04G'
set udg_Ability_Q_Type[hp_s]="Physical"
set udg_HP_Ability[1]='A0FB'
set udg_HP_Ability[2]='A0FH'
set udg_HP_Ability[3]='A04G'
set udg_HP_Ability[4]='A0GA'
