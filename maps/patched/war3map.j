function s__StatisticPlayer_updateGlyphOnDrop takes nothing returns nothing
local integer i=0
local integer max=(3)
local unit triggerUnit=GetTriggerUnit()
local integer playerNumber=GetPlayerId(GetOwningPlayer(triggerUnit))
local item manipulatedItem=GetManipulatedItem()
loop
if(manipulatedItem==UnitItemInSlot(triggerUnit,i+1))then
set s___StatisticPlayer_glyphValues[s__StatisticPlayer_glyphValues[s__players[playerNumber]]+i]=""
return
endif
set i=i+1
exitwhen i>=max
endloop
endfunction
function s__StatisticPlayer_updateTalentOnDrop takes nothing returns nothing
local integer i=0
local integer max=(4)
local unit triggerUnit=GetTriggerUnit()
local integer playerNumber=GetPlayerId(GetOwningPlayer(triggerUnit))
local item manipulatedItem=GetManipulatedItem()
loop
if(manipulatedItem==UnitItemInSlot(triggerUnit,i))then
set s___StatisticPlayer_talentValues[s__StatisticPlayer_talentValues[s__players[playerNumber]]+i]=""
return
endif
set i=i+1
exitwhen i>=max
endloop
endfunction
function s__StatisticPlayer_updateItemOnDrop takes nothing returns nothing
local integer i=0
local integer max=(6)
local unit triggerUnit=GetTriggerUnit()
local integer playerNumber=GetPlayerId(GetOwningPlayer(triggerUnit))
local item manipulatedItem=GetManipulatedItem()
loop
if(manipulatedItem==UnitItemInSlot(triggerUnit,i))then
set s___StatisticPlayer_itemValues[s__StatisticPlayer_itemValues[s__players[playerNumber]]+i]=""
return
endif
set i=i+1
exitwhen i>=max
endloop
endfunction
function s__StatisticPlayer_updateUi takes integer this returns nothing
local integer playerNumber=GetPlayerId(GetLocalPlayer())
local integer offsetIndex=s__StatisticDashboard___selectedSnapshot[playerNumber]
local integer loopB=0
local integer maxItem=(6)
local integer maxTalent=(4)
local integer maxGlyph=(3)
local string tempString
loop
if offsetIndex!=0 then
set tempString=s___StatisticPlayer_glyphValues[s__StatisticPlayer_glyphValues[this]+offsetIndex*maxGlyph+loopB]
else
set tempString=GetUnitInventoryItemIcon(s__StatisticPlayer_glyphUnit[this],loopB+1)
endif
if(tempString!="" and tempString!=null)then
call BlzFrameSetTexture(s___StatisticPlayer_glyphFrames[s__StatisticPlayer_glyphFrames[this]+loopB],tempString,0,true)
else
call BlzFrameSetTexture(s___StatisticPlayer_glyphFrames[s__StatisticPlayer_glyphFrames[this]+loopB],("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNScrollOfRegeneration.blp"),0,true)
endif
set loopB=loopB+1
exitwhen loopB>=maxGlyph
endloop
set loopB=0
loop
if offsetIndex!=0 then
set tempString=s___StatisticPlayer_talentValues[s__StatisticPlayer_talentValues[this]+offsetIndex*maxTalent+loopB]
else
set tempString=GetUnitInventoryItemIcon(s__StatisticPlayer_talentUnit[this],loopB)
endif
if(tempString!="" and tempString!=null)then
call BlzFrameSetTexture(s___StatisticPlayer_talentFrames[s__StatisticPlayer_talentFrames[this]+loopB],tempString,0,true)
else
call BlzFrameSetTexture(s___StatisticPlayer_talentFrames[s__StatisticPlayer_talentFrames[this]+loopB],("ReplaceableTextures\\CommandButtonsDisabled\\DISBTNSorceressAdept.blp"),0,true)
endif
set loopB=loopB+1
exitwhen loopB>=maxTalent
endloop
set loopB=0
loop
if offsetIndex!=0 then
set tempString=s___StatisticPlayer_itemValues[s__StatisticPlayer_itemValues[this]+offsetIndex*maxItem+loopB]
else
set tempString=GetUnitInventoryItemIcon(s__StatisticPlayer_hero[this],loopB)
endif
if(tempString!="" and tempString!=null)then
call BlzFrameSetTexture(s___StatisticPlayer_itemFrames[s__StatisticPlayer_itemFrames[this]+loopB],tempString,0,true)
else
call BlzFrameSetTexture(s___StatisticPlayer_itemFrames[s__StatisticPlayer_itemFrames[this]+loopB],("UI\\Widgets\\Console\\Human\\Human-inventory-slotfiller.blp"),0,true)
endif
set loopB=loopB+1
exitwhen loopB>=maxItem
endloop
endfunction
function s__StatisticPlayer_takeSnapshot takes integer this returns nothing
local integer itemOffset=snapshotCount*(6)
local integer talentOffset=snapshotCount*(4)
local integer glyphOffset=snapshotCount*(3)
local integer index=0
loop
set s___StatisticPlayer_glyphValues[s__StatisticPlayer_glyphValues[this]+glyphOffset+index]=GetUnitInventoryItemIcon(s__StatisticPlayer_glyphUnit[this],index+1)
set index=index+1
exitwhen index>=(3)
endloop
set index=0
loop
set s___StatisticPlayer_talentValues[s__StatisticPlayer_talentValues[this]+talentOffset+index]=GetUnitInventoryItemIcon(s__StatisticPlayer_talentUnit[this],index)
set index=index+1
exitwhen index>=(4)
endloop
set index=0
loop
set s___StatisticPlayer_itemValues[s__StatisticPlayer_itemValues[this]+itemOffset+index]=GetUnitInventoryItemIcon(s__StatisticPlayer_hero[this],index)
set index=index+1
exitwhen index>=(6)
endloop
endfunction
