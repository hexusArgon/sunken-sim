function s__StatisticPlayer_updateGlyphOnPickUp takes nothing returns nothing
local integer i=0
local integer max=(3)
local unit triggerUnit=GetTriggerUnit()
local integer playerNumber=GetPlayerId(GetOwningPlayer(triggerUnit))
loop
set s___StatisticPlayer_glyphValues[s__StatisticPlayer_glyphValues[s__players[playerNumber]]+i]=GetUnitInventoryItemIcon(triggerUnit,i+1)
set i=i+1
exitwhen i>=max
endloop
endfunction
function s__StatisticPlayer_updateTalentOnPickUp takes nothing returns nothing
local integer i=0
local integer max=(4)
local unit triggerUnit=GetTriggerUnit()
local integer playerNumber=GetPlayerId(GetOwningPlayer(triggerUnit))
loop
set s___StatisticPlayer_talentValues[s__StatisticPlayer_talentValues[s__players[playerNumber]]+i]=GetUnitInventoryItemIcon(triggerUnit,i)
