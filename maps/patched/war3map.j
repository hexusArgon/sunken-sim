function Trig_Tidal_Shot_Damage_Actions takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call UnitRemoveBuffBJ('B04P',udg_DamageEventTarget)
set udg_DummyDD_Damage=((80.00*I2R(GetUnitAbilityLevelSwapped('A0ER',udg_Hero_Siren)))+(2.00*I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_Siren,true))))
if(Trig_Tidal_Shot_Damage_Func006C())then
set udg_DummyDD_Damage=(udg_DummyDD_Damage+(0.40*GetUnitStateSwap(UNIT_STATE_MANA,udg_Hero_Siren)))
else
endif
if(Trig_Tidal_Shot_Damage_Func007C())then
set udg_DummyDD_Damage=(udg_DummyDD_Damage*(1+(0.10+(0.01*I2R(udg_Mastery_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Siren))])))))
else
endif
if(Trig_Tidal_Shot_Damage_Func008C())then
set udg_DummyDD_Damage=(udg_DummyDD_Damage*(0.30*udg_Reflection_Bonus))
else
endif
if(Trig_Tidal_Shot_Damage_Func009C())then
set udg_SeaElemental_Source=udg_SeaElemental_Source_Conjure
call ConditionalTriggerExecute(gg_trg_Sea_Elemental_Summon)
else
endif
if(Trig_Tidal_Shot_Damage_Func010C())then
call KillUnit(GroupPickRandomUnit(udg_SeaElemental_Group))
set udg_DummyDD_Damage=(udg_DummyDD_Damage*1.35)
else
endif
set udg_NextDamageType=udg_DamageTypeMagical
call UnitDamageTargetBJ(udg_Hero_Siren,udg_DamageEventTarget,udg_DummyDD_Damage,ATTACK_TYPE_NORMAL,DAMAGE_TYPE_NORMAL)
call AddSpecialEffectTargetUnitBJ("origin",udg_DamageEventTarget,"war3mapImported\\WaterEnchant_Fix.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call UnitAddAbilityBJ('A0JI',udg_Caster_Dummy)
if(Trig_Tidal_Shot_Damage_Func017C())then
call SetUnitAbilityLevelSwapped('A0JI',udg_Caster_Dummy,2)
else
endif
call IssueTargetOrderBJ(udg_Caster_Dummy,"innerfire",udg_Hero_Siren)
call UnitRemoveAbilityBJ('A0JI',udg_Caster_Dummy)
if(Trig_Tidal_Shot_Damage_Func021C())then
set udg_CrushingWave_Damage=(0.40*udg_DummyDD_Damage)
set udg_Generic_Point=GetUnitLoc(udg_DamageEventSource)
set udg_Temp_Point=GetUnitLoc(udg_DamageEventTarget)
call SetUnitPositionLoc(udg_Dummies_CrushingWave,udg_Generic_Point)
call IssuePointOrderLocBJ(udg_Dummies_CrushingWave,"carrionswarm",udg_Temp_Point)
call RemoveLocation(udg_Generic_Point)
call RemoveLocation(udg_Temp_Point)
else
endif
call EnableTrigger(GetTriggeringTrigger())
endfunction
