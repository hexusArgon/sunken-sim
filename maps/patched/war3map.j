function Trig_Explore_Entry_Switch_Conditions takes nothing returns boolean
if(not(GetSpellAbilityId()=='A0H2'))then
return false
endif
return true
endfunction
function Trig_Explore_Entry_Switch_Func002C takes nothing returns boolean
if(not(RectContainsLoc(gg_rct_Explore_Entry_Switch,udg_Inspect_Point)==true))then
return false
endif
return true
endfunction
function Trig_Explore_Entry_Switch_Actions takes nothing returns nothing
set udg_Inspect_Point=GetSpellTargetLoc()
if(Trig_Explore_Entry_Switch_Func002C())then
call DisableTrigger(GetTriggeringTrigger())
call CreateTextTagLocBJ("TRIGSTR_8746",udg_Inspect_Point,0,10,100,100,100,0)
call SetTextTagPermanentBJ(GetLastCreatedTextTag(),false)
call SetTextTagLifespanBJ(GetLastCreatedTextTag(),7.00)
call SetTextTagFadepointBJ(GetLastCreatedTextTag(),6.00)
call RemoveLocation(udg_Inspect_Point)
call PlaySoundBJ(gg_snd_Elevator)
call DestructableRestoreLife(gg_dest_B013_4211,GetDestructableMaxLife(GetLastCreatedDestructable()),true)
set udg_Ping_Point=GetRectCenter(gg_rct_Entry_Gate)
call PingMinimapLocForForceEx(GetPlayersAll(),udg_Ping_Point,4.50,bj_MINIMAPPINGSTYLE_FLASHY,100,100,100)
call RemoveLocation(udg_Ping_Point)
call PolledWait(1.25)
call DisableTrigger(gg_trg_Main_Sunken_City_Door)
call ModifyGateBJ(bj_GATEOPERATION_OPEN,gg_dest_B006_0067)
call PolledWait(0.45)
call PlaySoundBJ(gg_snd_FrostmourneChant1)
else
call RemoveLocation(udg_Inspect_Point)
endif
endfunction
function InitTrig_Explore_Entry_Switch takes nothing returns nothing
set gg_trg_Explore_Entry_Switch=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(gg_trg_Explore_Entry_Switch,EVENT_PLAYER_UNIT_SPELL_EFFECT)
call TriggerAddCondition(gg_trg_Explore_Entry_Switch,Condition(function Trig_Explore_Entry_Switch_Conditions))
call TriggerAddAction(gg_trg_Explore_Entry_Switch,function Trig_Explore_Entry_Switch_Actions)
endfunction
