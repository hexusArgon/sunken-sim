function Trig_Intro_Cinematic_Actions takes nothing returns nothing
set udg_IntroCine_Wait=(udg_IntroCine_Wait-0.10)
if(Trig_Intro_Cinematic_Func004C())then
call StopMusicBJ(false)
call PlaySoundBJ(gg_snd_intro_music)
call CinematicFilterGenericBJ(2,BLEND_MODE_BLEND,"Story2.blp",0.00,0.00,0.00,0.00,100.00,100.00,100.00,0)
call CinematicFilterGenericBJ(2,BLEND_MODE_BLEND,"StoryOne.dds",0.00,0.00,0.00,0.00,100.00,100.00,100.00,0)
set udg_IntroCine_Wait=(udg_IntroCine_Wait+3.00)
set udg_IntroCine_Stage=(udg_IntroCine_Stage+1)
else
if(Trig_Intro_Cinematic_Func004Func002C())then
call DisplayTimedTextToForce(GetPlayersAll(),7.50,"TRIGSTR_5340")
set udg_IntroCine_Wait=(udg_IntroCine_Wait+9.50)
set udg_IntroCine_Stage=(udg_IntroCine_Stage+1)
else
if(Trig_Intro_Cinematic_Func004Func002Func001C())then
