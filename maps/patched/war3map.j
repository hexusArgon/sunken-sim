function Trig_Call_Pet_Actions takes nothing returns nothing
set udg_CallPet_Point=PolarProjectionBJ(GetUnitLoc(udg_Hero_Hunter),50.00,GetUnitFacing(udg_Hero_Hunter))
set udg_DCS_Unit=udg_Hero_Hunter
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
call KillUnit(udg_Hunter_Current_Pet)
if(Trig_Call_Pet_Func010C())then
call CreateNUnitsAtLoc(1,'n00C',GetOwningPlayer(udg_Hero_Hunter),udg_CallPet_Point,GetUnitFacing(udg_Hero_Hunter))
set udg_CallPet_Spike=GetLastCreatedUnit()
call BlzSetUnitBaseDamage(udg_CallPet_Spike,(udg_Pet_DamageBase[udg_Pet_Spike]+R2I((udg_Pet_DamageScaling[udg_Pet_Spike]*udg_DCS_Damage))),0)
call BlzSetUnitMaxHP(udg_CallPet_Spike,(BlzGetUnitMaxHP(udg_CallPet_Spike)+((25*GetHeroLevel(udg_Hero_Hunter))+R2I((0.85*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Hunter))))))
call BlzSetUnitArmor(udg_CallPet_Spike,(BlzGetUnitArmor(udg_CallPet_Spike)+(0.25*BlzGetUnitArmor(udg_Hero_Hunter))))
call SetUnitLifePercentBJ(udg_CallPet_Spike,100)
if(Trig_Call_Pet_Func010Func010C())then
call UnitAddAbilityBJ('A0ID',udg_CallPet_Spike)
else
endif
if(Trig_Call_Pet_Func010Func011C())then
call UnitApplyTimedLifeBJ((6.00+(0.10*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),true)))),'BTLF',udg_CallPet_Spike)
call AddSpecialEffectLocBJ(udg_CallPet_Point,"Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call GroupAddUnitSimple(udg_CallPet_Spike,udg_UnleashBeasts_Group)
else
set udg_Hunter_Current_Pet=GetLastCreatedUnit()
endif
else
endif
if(Trig_Call_Pet_Func011C())then
call CreateNUnitsAtLoc(1,'n00Y',GetOwningPlayer(udg_Hero_Hunter),udg_CallPet_Point,GetUnitFacing(udg_Hero_Hunter))
set udg_CallPet_Huffer=GetLastCreatedUnit()
call BlzSetUnitBaseDamage(udg_CallPet_Huffer,(udg_Pet_DamageBase[udg_Pet_Huffer]+R2I((udg_Pet_DamageScaling[udg_Pet_Huffer]*udg_DCS_Damage))),0)
call BlzSetUnitMaxHP(udg_CallPet_Huffer,(BlzGetUnitMaxHP(udg_CallPet_Huffer)+((15*GetHeroLevel(udg_Hero_Hunter))+R2I((0.65*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Hunter))))))
call SetUnitLifePercentBJ(udg_CallPet_Huffer,100)
if(Trig_Call_Pet_Func011Func009C())then
call UnitAddAbilityBJ('Afzy',udg_CallPet_Huffer)
call IssueImmediateOrder(udg_CallPet_Huffer,"frenzyon")
else
endif
if(Trig_Call_Pet_Func011Func010C())then
call UnitApplyTimedLifeBJ((6.00+(0.10*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),true)))),'BTLF',udg_CallPet_Huffer)
call AddSpecialEffectLocBJ(udg_CallPet_Point,"Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call GroupAddUnitSimple(udg_CallPet_Huffer,udg_UnleashBeasts_Group)
else
set udg_Hunter_Current_Pet=GetLastCreatedUnit()
endif
else
endif
if(Trig_Call_Pet_Func012C())then
call CreateNUnitsAtLoc(1,'n03L',GetOwningPlayer(udg_Hero_Hunter),udg_CallPet_Point,GetUnitFacing(udg_Hero_Hunter))
set udg_CallPet_Grylls=GetLastCreatedUnit()
call BlzSetUnitBaseDamage(udg_CallPet_Grylls,(udg_Pet_DamageBase[udg_Pet_Grylls]+R2I((udg_Pet_DamageScaling[udg_Pet_Grylls]*udg_DCS_Damage))),0)
call BlzSetUnitMaxHP(udg_CallPet_Grylls,(BlzGetUnitMaxHP(udg_CallPet_Grylls)+((40*GetHeroLevel(udg_Hero_Hunter))+R2I((1.25*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_Hunter))))))
call BlzSetUnitArmor(udg_CallPet_Grylls,(BlzGetUnitArmor(udg_CallPet_Grylls)+BlzGetUnitArmor(udg_Hero_Hunter)))
call SetUnitLifePercentBJ(udg_CallPet_Grylls,100)
if(Trig_Call_Pet_Func012Func010C())then
call UnitAddAbilityBJ('A03Y',udg_CallPet_Grylls)
else
endif
if(Trig_Call_Pet_Func012Func011C())then
call UnitApplyTimedLifeBJ((6.00+(0.10*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),true)))),'BTLF',udg_CallPet_Grylls)
call AddSpecialEffectLocBJ(udg_CallPet_Point,"Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call GroupAddUnitSimple(udg_CallPet_Grylls,udg_UnleashBeasts_Group)
else
set udg_Hunter_Current_Pet=GetLastCreatedUnit()
endif
else
endif
call AddSpecialEffectTargetUnitBJ("origin",GetLastCreatedUnit(),"Abilities\\Spells\\Orc\\FeralSpirit\\feralspirittarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call RemoveLocation(udg_CallPet_Point)
endfunction
