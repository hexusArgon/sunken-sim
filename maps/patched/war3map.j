call TriggerAddAction(gg_trg_Click_Button,function Trig_Click_Button_Actions)
endfunction
function Trig_OneLeverDies_Func001Func003C takes nothing returns boolean
if(not(GetDyingDestructable()==udg_True_Lever))then
return false
endif
return true
endfunction
function Trig_OneLeverDies_Func001C takes nothing returns boolean
if(not(GetDyingDestructable()==udg_FakeLever))then
return false
endif
return true
endfunction
function Trig_OneLeverDies_Actions takes nothing returns nothing
if(Trig_OneLeverDies_Func001C())then
call DisableTrigger(GetTriggeringTrigger())
call DisplayTimedTextToForce(GetPlayersAll(),7.00,"TRIGSTR_2158")
call KillDestructable(udg_True_Lever)
call KillDestructable(gg_dest_DTg1_6033)
call SetUnitInvulnerable(gg_unit_n01Y_0206,false)
call SetUnitOwner(gg_unit_n01Y_0206,Player(PLAYER_NEUTRAL_AGGRESSIVE),true)
call IssuePointOrderLocBJ(gg_unit_n01Y_0206,"attack",GetRectCenter(gg_rct_ItemSpawn))
else
if(Trig_OneLeverDies_Func001Func003C())then
call DisableTrigger(GetTriggeringTrigger())
call DisplayTimedTextToForce(GetPlayersAll(),7.00,"TRIGSTR_2270")
call KillDestructable(udg_FakeLever)
call AddSpecialEffectLocBJ(GetRectCenter(gg_rct_ItemSpawn),"Abilities\\Spells\\Other\\Monsoon\\MonsoonBoltTarget.mdl")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call CreateItemLoc(udg_Drops_Rare[GetRandomInt(1,udg_Drops_RareCount)],GetRectCenter(gg_rct_ItemSpawn))
else
endif
endif
endfunction
