return false
endif
return true
endfunction
function Trig_Potency_Tooltip_Actions takes nothing returns nothing
set udg_PlayerNumber=GetConvertedPlayerId(GetOwningPlayer(udg_Potency_Hero))
set udg_Potency_Stat[udg_PlayerNumber]=(udg_Potency_Stat[udg_PlayerNumber]-udg_Potency_Bonus[udg_PlayerNumber])
set udg_Potency_Bonus[udg_PlayerNumber]=0.00
call ConditionalTriggerExecute(gg_trg_Potency_Buffs_Setup)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=udg_Potency_BuffsMax
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_Potency_Tooltip_Func005Func001C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+udg_Potency_BuffValue[GetForLoopIndexA()])
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
if(Trig_Potency_Tooltip_Func007C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(7.00*(GetUnitManaPercent(udg_Potency_Hero)/ 100.00)))
else
endif
if(Trig_Potency_Tooltip_Func009C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(2.00+(GetUnitStateSwap(UNIT_STATE_MAX_MANA,udg_Hero_Druid)/ 200.00)))
else
endif
if(Trig_Potency_Tooltip_Func011C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(3.00+((0.05*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Mage,true)))*udg_Archmage_Bonus)))
else
endif
if(Trig_Potency_Tooltip_Func013C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(4.00+(0.15*I2R(GetHeroStatBJ(bj_HEROSTAT_AGI,udg_Hero_DemonHunter,true)))))
else
endif
if(Trig_Potency_Tooltip_Func015C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+2.00)
else
endif
if(Trig_Potency_Tooltip_Func017C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+((GetUnitManaPercent(udg_Hero_DeathKnight)/ 100.00)*(3.00+(0.40*I2R(GetHeroLevel(udg_Hero_DeathKnight))))))
else
endif
if(Trig_Potency_Tooltip_Func019C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(0.50*BlzGetUnitArmor(udg_Hero_DragonSentinel)))
else
endif
if(Trig_Potency_Tooltip_Func021C())then
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(3.00+(0.10*I2R(GetHeroStatBJ(bj_HEROSTAT_INT,udg_Hero_Tinker,true)))))
else
endif
if(Trig_Potency_Tooltip_Func023C())then
set udg_DCS_Unit=udg_Hero_Hunter
set udg_DCS_IncludeAttributeBonus=true
set udg_DCS_IncludeItemBonus=true
call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
set udg_Potency_Bonus[udg_PlayerNumber]=(udg_Potency_Bonus[udg_PlayerNumber]+(3.00+(0.04*udg_DCS_Damage)))
else
endif
set udg_Potency_Stat[udg_PlayerNumber]=(udg_Potency_Stat[udg_PlayerNumber]+udg_Potency_Bonus[udg_PlayerNumber])
set udg_PotencyToInt=R2I((udg_Potency_Stat[udg_PlayerNumber]+0.50))
set udg_PlayerIndex=(100*udg_PlayerNumber)
if(Trig_Potency_Tooltip_Func030C())then
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_Potency)]="0"
set udg_Potency_Stat[udg_PlayerNumber]=0.00
else
set udg_MyResourceFieldValue[(udg_PlayerIndex+udg_StatIndex_Potency)]=I2S(udg_PotencyToInt)
endif
endfunction
function InitTrig_Potency_Tooltip takes nothing returns nothing
set gg_trg_Potency_Tooltip=CreateTrigger()
call TriggerAddAction(gg_trg_Potency_Tooltip,function Trig_Potency_Tooltip_Actions)
endfunction
