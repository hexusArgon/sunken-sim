function Trig_Tombstone_Actions takes nothing returns nothing
set udg_Generic_Point=GetSpellTargetLoc()
if(Trig_Tombstone_Func002C())then
call CreateNUnitsAtLoc(1,'o00T',GetOwningPlayer(GetTriggerUnit()),udg_Generic_Point,120.00)
call SetUnitAbilityLevelSwapped('A041',GetLastCreatedUnit(),GetUnitAbilityLevelSwapped('A050',GetTriggerUnit()))
call GroupAddUnitSimple(GetLastCreatedUnit(),udg_Tombstone_Group)
call AddSpecialEffectLocBJ(udg_Generic_Point,"war3mapImported\\AnimateCold.mdx")
call DestroyEffectBJ(GetLastCreatedEffectBJ())
call PlaySoundOnUnitBJ(gg_snd_TempleOfTheDamnedWhat,100.00,GetLastCreatedUnit())
set udg_Tombstone_TickTime=(1.80-(0.20*I2R(GetUnitAbilityLevelSwapped('A050',udg_Hero_Necromancer))))
set udg_Tombstone_TickRates=1.00
if(Trig_Tombstone_Func002Func012C())then
set udg_Tombstone_TickRates=(udg_Tombstone_TickRates+0.35)
else
endif
set udg_Tombstone_TickTime=(udg_Tombstone_TickTime/ udg_Tombstone_TickRates)
call StartTimerBJ(udg_Tombstone_Timer,false,udg_Tombstone_TickTime)
if(Trig_Tombstone_Func002Func015C())then
call UnitApplyTimedLifeBJ(13.00,'BTLF',GetLastCreatedUnit())
set udg_Gravedigger_Count=3
else
call UnitApplyTimedLifeBJ(10.00,'BTLF',GetLastCreatedUnit())
set udg_Gravedigger_Count=2
endif
if(Trig_Tombstone_Func002Func016C())then
set udg_Gravedigger_Count=(udg_Gravedigger_Count+1)
else
endif
set udg_RaiseDead_Point=GetSpellTargetLoc()
set udg_Gravedigger_Loop=1
loop
exitwhen udg_Gravedigger_Loop>udg_Gravedigger_Count
call ConditionalTriggerExecute(gg_trg_Spawn_Skeletal_Minion)
set udg_Gravedigger_Loop=udg_Gravedigger_Loop+1
endloop
if(Trig_Tombstone_Func002Func019C())then
set udg_LordOfTheDead_Flag=true
call ConditionalTriggerExecute(gg_trg_Spawn_Skeletal_Minion)
else
endif
call RemoveLocation(udg_RaiseDead_Point)
else
set udg_InvalidArea_Unit=GetTriggerUnit()
set udg_InvalidArea_Ability='A050'
call InvalidTargetAreaCDFix()
endif
call RemoveLocation(udg_Generic_Point)
endfunction
