call TriggerExecute(gg_trg_DCS_Core)
call TriggerExecute(gg_trg_DCS_Other_Damage_Sources)
set udg_SerpentSting_PeriodicDmg=((5.00*I2R(GetUnitAbilityLevelSwapped('A0E3',udg_Hero_Hunter)))+(0.10*udg_DCS_Damage))
set udg_HoTSys_SerpentSting=GetUnitsInRectMatching(GetPlayableMapRect(),Condition(function Trig_Serpent_Sting_Periodic_Func009002002))
call ForGroupBJ(udg_HoTSys_SerpentSting,function Trig_Serpent_Sting_Periodic_Func010A)
set udg_SerpentSting_Interval=1.00
if(Trig_Serpent_Sting_Periodic_Func012C())then
set udg_SerpentSting_Interval=(udg_SerpentSting_Interval/(1+(0.05*udg_Potency_Stat[GetConvertedPlayerId(GetOwningPlayer(udg_Hero_Hunter))])))
else
endif
call StartTimerBJ(udg_SerpentSting_Timer,false,udg_SerpentSting_Interval)
call DestroyGroup(udg_HoTSys_SerpentSting)
endfunction
