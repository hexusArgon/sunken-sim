set udg_MyResourceFieldIcons[udg_StatIndex_Potency]="ReplaceableTextures\\CommandButtons\\PASStatPotency.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_ManaRegen]="ReplaceableTextures\\CommandButtons\\PASStatManaRegen.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_HealthRegen]="ReplaceableTextures\\PassiveButtons\\PASBTNMagicImmunity.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_AS]="ReplaceableTextures\\CommandButtons\\PASStatAttackSpeed.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_Luck]="ReplaceableTextures\\CommandButtons\\PASStatLuck.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_HealingPower]="ReplaceableTextures\\CommandButtons\\PASStatHealingPower.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_Evasion]="ReplaceableTextures\\PassiveButtons\\PASBTNEvasion.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_SDR]="ReplaceableTextures\\CommandButtons\\PASStatSDR.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_Magical]="ReplaceableTextures\\CommandButtons\\PASStatMagical.blp"
set udg_MyResourceFieldIcons[udg_StatIndex_Physical]="ReplaceableTextures\\CommandButtons\\PASStatPhysical.blp"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Haste]="Haste"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Mastery]="Mastery"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_PetDamage]="Pet Damage"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Crit]="Critical Strike"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Potency]="Potency"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_ManaRegen]="Mana Regeneration"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_HealthRegen]="Health Regeneration"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_AS]="Attack Speed"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Luck]="Luck"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_HealingPower]="Healing Power"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Evasion]="Evasion"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_SDR]="Spell Damage Reduction"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Magical]="Magical Damage"
set udg_MyResourceFieldTooltipTitle[udg_StatIndex_Physical]="Physical Damage"
set udg_MyResourceFieldTooltipText[udg_StatIndex_Haste]="Increases your spellcast frequency by reducing the cooldowns of your hero abilities. Updates every time your hero casts a spell. Stacks additively."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Mastery]="Provides a different effect based on your current hero Specialization. Check your customization menu (F8) for more information."
set udg_MyResourceFieldTooltipText[udg_StatIndex_PetDamage]="Increases the damage dealt by your Summons. Stacks additively."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Crit]="Gives your attacks chance to deal 100% more damage. Stacks additively."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Potency]="Any damage dealt is increased by amount equal to this stat before any damage modifiers are applied."
set udg_MyResourceFieldTooltipText[udg_StatIndex_ManaRegen]="The amount of periodic Mana your hero regenerates per second. Updates while below 100% Mana."
set udg_MyResourceFieldTooltipText[udg_StatIndex_HealthRegen]="The amount of Health your hero regenerates per second. Cannot be increased by any flat Healing modifiers. Updates while below 100% Health."
set udg_MyResourceFieldTooltipText[udg_StatIndex_AS]=("Increases your attack frequency by reducing the Attack Cooldown of your hero. Cannot exceed 400%. Stacks additively.|n|nCurrent Attack Cooldown: "+SubStringBJ(R2S(udg_AttackCooldown[udg_PlayerNumber]),1,4))
set udg_MyResourceFieldTooltipText[udg_StatIndex_Luck]="Multiplicatively increases the proc chance of percent based chance effects and their scalings. Effects that can benefit from Luck will have their value colored in |cff33937fgreen|r."
set udg_MyResourceFieldTooltipText[udg_StatIndex_HealingPower]="Increases the effectiveness of your |cff00cc33Healing|r Type effects. Stacks additively."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Evasion]="Gives you chance to evade incoming attacks, taking no damage from them. Evading an attack counts towards damage mitigation. Updates when taking damage."
set udg_MyResourceFieldTooltipText[udg_StatIndex_SDR]="Reduces all |cff83d5fcSpell|r damage. Stacks multiplicatively. Updates when taking damage."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Magical]="Increases all |cff0099ffMagical|r damage by this amount. Stacks additively. Updates when dealing |cff0099ffMagical|r damage."
set udg_MyResourceFieldTooltipText[udg_StatIndex_Physical]="Increases all |cffff8000Physical|r damage by this amount. Stacks additively. Updates when dealing |cffff8000Physical|r damage."
call ForForce(GetPlayersAll(),function Trig_MyResourceFieldInit_Func068A)
endfunction
