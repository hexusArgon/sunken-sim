function Trig_SaveLoad_UI_Fix_Timer_Actions takes nothing returns nothing
call BlzLoadTOCFile("war3mapImported\\MyResourceField.toc")
call BlzLoadTOCFile("war3mapImported\\tableOfContent.toc")
call MoveChatUp()
call ConditionalTriggerExecute(gg_trg_Create_Hero_Panel)
call onLoadHeroPanel()
call MultiboardDisplayBJ(true,udg_Main_Board)
set dpsBarCount=0
call createDpsPanel()
call BlzFrameSetVisible(dpsPanel,true)
call BlzFrameClearAllPoints(dpsPanel)
call BlzFrameSetPoint(dpsPanel,FRAMEPOINT_TOPRIGHT,BlzGetFrameByName("MultiboardListContainer",0),FRAMEPOINT_BOTTOMRIGHT,-0.002,-(0.025)/ 2)
call BlzFrameSetVisible(BlzGetFrameByName("DpsPanelBorder",0),true)
call BlzFrameSetVisible(BlzGetFrameByName("DpsPanel",0),true)
call createChallengePanel()
call ConditionalTriggerExecute(gg_trg_Positionate_Challenge_Panel_REAL)
call toggleChallengePanelVisibility(udg_UI_ChallengePanel_IsVisible)
call updateChallengeTitleText()
call updateChallengeValueText()
call ConditionalTriggerExecute(gg_trg_Create_Custom_Resource_Bar)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=3
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
if(Trig_SaveLoad_UI_Fix_Timer_Func026Func001C())then
if(GetLocalPlayer()==ConvertedPlayer(GetForLoopIndexA()))then
call BlzFrameSetVisible(BlzGetFrameByName("CustomResourceBar",0),true)
call BlzFrameSetVertexColor(BlzGetFrameByName("CustomResourceBar",0),udg_CustomResource_Color[GetForLoopIndexA()])
endif
else
endif
set bj_forLoopAIndex=bj_forLoopAIndex+1
endloop
endfunction
