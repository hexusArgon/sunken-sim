set udg_DK_SpellcastDamage=((20.00+(10.00*I2R(GetHeroLevel(GetTriggerUnit()))))+((0.10*GetUnitStateSwap(UNIT_STATE_MAX_LIFE,udg_Hero_DeathKnight))*udg_BloodTap_Bonus))
